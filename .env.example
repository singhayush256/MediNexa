# =============================================================================
# MEDINEXA v3.0 HEALTHCARE ENTERPRISE PLATFORM — PRODUCTION CONFIGURATION
# =============================================================================
# IMPORTANT: Never commit actual secret keys or production passwords to Git.
# Set these environment variables in your secure deployment environment (e.g. AWS Secrets Manager,
# Kubernetes Secrets, HashiCorp Vault, Vercel / Railway / Render Environment Console).

# -----------------------------------------------------------------------------
# 1. SERVER CONFIGURATION (Server-Side Only)
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=production
API_PREFIX=/api/v1
# In production, set to your exact domain(s), e.g. https://app.medinexa.in,https://admin.medinexa.in
CORS_ORIGIN=https://app.medinexa.in

# -----------------------------------------------------------------------------
# 2. PUBLIC CLIENT CONFIGURATION (Exposed to Browser Bundle)
# -----------------------------------------------------------------------------
# Must use HTTPS in production!
NEXT_PUBLIC_API_URL=https://api.medinexa.in/api/v1
NEXT_PUBLIC_WS_URL=wss://api.medinexa.in

# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL 15+ & Connection Pool)
# -----------------------------------------------------------------------------
# Pooled connection string (e.g. Neon connection pooler or PgBouncer)
DATABASE_URL="postgresql://postgres:YOUR_STRONG_DB_PASSWORD@localhost:5433/medinexa?schema=public&connection_limit=25&pool_timeout=10"
# Direct connection string for schema migrations (bypassing poolers on Neon / Supabase)
DIRECT_URL="postgresql://postgres:YOUR_STRONG_DB_PASSWORD@localhost:5433/medinexa?schema=public"

# -----------------------------------------------------------------------------
# 4. AUTHENTICATION & JWT SECURITY (Server-Side Secret)
# -----------------------------------------------------------------------------
# Generate a cryptographically secure 256-bit or 512-bit key (e.g., openssl rand -base64 64)
# MediNexa will strictly refuse to start in NODE_ENV=production if this is left default.
JWT_SECRET=YOUR_SECURE_RANDOMLY_GENERATED_64_CHAR_SECRET_KEY_HERE
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# -----------------------------------------------------------------------------
# 5. RATE LIMITING & SECURITY GUARDS
# -----------------------------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX=10

# -----------------------------------------------------------------------------
# 6. SMTP & EMAIL NOTIFICATIONS
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_OR_AWS_SES_API_KEY
SMTP_FROM="MediNexa Health <notifications@medinexa.in>"

# -----------------------------------------------------------------------------
# 7. PAYMENT GATEWAYS (B2B SaaS & Patient Invoicing)
# -----------------------------------------------------------------------------
# Stripe Integration
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET

# Razorpay Integration (India & APAC Healthcare Compliance)
RAZORPAY_KEY_ID=rzp_live_YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# -----------------------------------------------------------------------------
# 8. AI ASSISTANT & PREDICTIVE HEALTH ENGINE (Server-Side Secret)
# -----------------------------------------------------------------------------
AI_PROVIDER=GEMINI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
OPENAI_API_KEY=YOUR_OPTIONAL_OPENAI_API_KEY_HERE
MEDINEXA_AI_API_KEY=YOUR_ENTERPRISE_AI_API_KEY_HERE

# -----------------------------------------------------------------------------
# 9. OBSERVABILITY, LOGGING & ERROR MONITORING
# -----------------------------------------------------------------------------
LOG_LEVEL=info
ENABLE_AUDIT_LOGGING=true
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# -----------------------------------------------------------------------------
# 10. CACHING & REAL-TIME WEBSOCKETS (Optional Redis)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://:YOUR_REDIS_PASSWORD@localhost:6379/0
