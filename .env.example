# MediNexa Environment Configuration Template

# Server Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/medinexa?schema=public"

# JWT & Auth
JWT_SECRET=medinexa-dev-jwt-secret-key-change-in-production-day2

# AI Assistant Provider Configuration (Day 10)
AI_PROVIDER=MOCK
AI_API_KEY=mock-key-placeholder

