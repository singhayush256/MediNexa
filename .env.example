# =============================================================================
# MEDINEXA DUPLICATE — MONOREPO ROOT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# This file provides a centralized master template of all environment variables
# required across both frontend (Vercel) and backend (Render / Neon / Upstash).
# NEVER commit production secret values or credentials to Git.

# =============================================================================
# SECTION A: VERCEL — FRONTEND ENVIRONMENT VARIABLES (Public)
# =============================================================================
# Public URL of the Render-hosted backend gateway (HTTPS, ending in /api/v1):
NEXT_PUBLIC_API_URL=https://your-render-backend-url.onrender.com/api/v1
# Public WebSocket Gateway URL (optional, derived from NEXT_PUBLIC_API_URL if omitted):
NEXT_PUBLIC_WS_URL=wss://your-render-backend-url.onrender.com

# =============================================================================
# SECTION B: RENDER — BACKEND ENVIRONMENT VARIABLES (Server-Side Secrets)
# =============================================================================

# 1. RUNTIME & CORS
NODE_ENV=production
PORT=10000
API_PREFIX=/api/v1
CORS_ORIGIN=https://medinexa-duplicate.vercel.app,https://medi-nexa-web-nu.vercel.app,https://medinexa.com,https://app.medinexa.in

# 2. NEON POSTGRESQL DATABASE
# Pooled database connection (PgBouncer) for application queries:
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/medinexa?sslmode=require&connection_limit=20"
# Direct unpooled database connection for Prisma migrations:
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/medinexa?sslmode=require"

# 3. AUTHENTICATION & SECURITY
# 256-bit+ cryptographically secure secret (openssl rand -base64 64):
JWT_SECRET=your_production_64_character_jwt_secret_key_here
JWT_EXPIRES_IN=24h
# Dedicated 32-byte key for TOTP seed encryption:
TOTP_ENCRYPTION_KEY=your_production_32_byte_totp_key_here

# 4. REDIS CACHING & RATE LIMITING
# Upstash Redis connection string:
REDIS_URL=rediss://default:your_upstash_token@your-endpoint.upstash.io:6379
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# 5. CLOUDFLARE R2 PRIVATE OBJECT STORAGE
# Keep unconfigured for fail-closed HTTP 503 behavior until R2 bucket is provisioned:
STORAGE_PROVIDER=r2
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=medinexa-vault

# 6. AI PROVIDERS (SERVER-SIDE ONLY)
GEMINI_API_KEY=your_google_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MEDINEXA_AI_API_KEY=your_enterprise_ai_key_here
AI_MODEL=medinexa-clinical-deep-v2

# 7. COMMUNICATIONS (EMAIL & SMS)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password
SMTP_FROM="MediNexa Health <notifications@medinexa.health>"
SMS_PROVIDER=MSG91
SMS_SENDER_ID=MDNEXA
MSG91_API_KEY=your_msg91_api_key
DLT_ENTITY_ID=1101552390000041289

# 8. PAYMENT GATEWAY (RAZORPAY)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
