# =============================================================================
# MEDINEXA HEALTHCARE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# IMPORTANT: Never commit actual secret keys or production passwords to Git.
# Copy this file to '.env' for local development or set variables in your host environment.

# -----------------------------------------------------------------------------
# 1. SERVER CONFIGURATION (Server-Only)
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. PUBLIC CLIENT CONFIGURATION (Exposed to Browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL + Prisma ORM)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/medinexa?schema=public"

# -----------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY SECRETS (Server-Only Secret)
# -----------------------------------------------------------------------------
JWT_SECRET=medinexa-dev-jwt-secret-key-change-in-production-day2
JWT_EXPIRES_IN=8h

# -----------------------------------------------------------------------------
# 5. AI ASSISTANT PROVIDER CONFIGURATION (Server-Only Secret)
# -----------------------------------------------------------------------------
AI_PROVIDER=MOCK
AI_API_KEY=mock-key-placeholder
