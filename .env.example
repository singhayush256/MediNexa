# =============================================================================
# MEDINEXA HEALTHCARE ENTERPRISE PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# IMPORTANT: Never commit actual secret keys or production passwords to Git.
# Set these environment variables in your secure deployment environment (e.g. AWS Secrets Manager,
# Kubernetes Secrets, HashiCorp Vault, Vercel / Railway / Render Environment Console).

# -----------------------------------------------------------------------------
# 1. SERVER CONFIGURATION (Server-Side Only)
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=production
API_PREFIX=/api/v1
# In production, set to your exact domain(s), e.g. https://app.medinexa.in,https://admin.medinexa.in
CORS_ORIGIN=https://app.medinexa.in

# -----------------------------------------------------------------------------
# 2. PUBLIC CLIENT CONFIGURATION (Exposed to Browser Bundle)
# -----------------------------------------------------------------------------
# Must use HTTPS in production!
NEXT_PUBLIC_API_URL=https://api.medinexa.in/api/v1
NEXT_PUBLIC_WS_URL=wss://api.medinexa.in

# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL 15+ & Connection Pool)
# -----------------------------------------------------------------------------
# Recommended for production: include connection_limit and pool_timeout
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public&connection_limit=25&pool_timeout=10
DATABASE_URL="postgresql://postgres:YOUR_STRONG_DB_PASSWORD@localhost:5433/medinexa?schema=public&connection_limit=25&pool_timeout=10"

# -----------------------------------------------------------------------------
# 4. AUTHENTICATION & JWT SECURITY (Server-Side Secret)
# -----------------------------------------------------------------------------
# Generate a cryptographically secure 256-bit or 512-bit key (e.g., openssl rand -base64 64)
# MediNexa will strictly refuse to start in NODE_ENV=production if this is left default.
JWT_SECRET=YOUR_SECURE_RANDOMLY_GENERATED_64_CHAR_SECRET_KEY_HERE
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# -----------------------------------------------------------------------------
# 5. AI ASSISTANT & CLINICAL COPILOT (Server-Side Secret)
# -----------------------------------------------------------------------------
AI_PROVIDER=MEDINEXA_AI
MEDINEXA_AI_API_KEY=YOUR_ENTERPRISE_AI_API_KEY_HERE
GEMINI_API_KEY=YOUR_OPTIONAL_GEMINI_API_KEY_HERE

# -----------------------------------------------------------------------------
# 6. OBSERVABILITY, LOGGING & ERROR MONITORING
# -----------------------------------------------------------------------------
LOG_LEVEL=info
ENABLE_AUDIT_LOGGING=true
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# -----------------------------------------------------------------------------
# 7. CACHING & REAL-TIME WEBSOCKETS (Optional Redis)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://:YOUR_REDIS_PASSWORD@localhost:6379/0
