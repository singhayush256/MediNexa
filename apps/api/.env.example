# =============================================================================
# MEDINEXA DUPLICATE — BACKEND API ENVIRONMENT VARIABLES (.env.example)
# =============================================================================
# Configure these variables in your Render Web Service Environment Console.
# NEVER commit raw production credentials, passwords, or secret keys to Git.

# -----------------------------------------------------------------------------
# 1. RUNTIME & SERVER
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=10000
API_PREFIX=/api/v1
# Comma-separated allowed frontend origins for CORS (Official frontend: https://medinexa-medicalweb.vercel.app):
CORS_ORIGIN=https://medinexa-medicalweb.vercel.app,https://medinexa-duplicate.vercel.app,https://medi-nexa-web-nu.vercel.app,https://medinexa.com,https://app.medinexa.in
# Authoritative public frontend URL used for generated email, SMS, and WhatsApp communication links:
FRONTEND_URL=https://medinexa-medicalweb.vercel.app

# -----------------------------------------------------------------------------
# 2. NEON POSTGRESQL DATABASE
# -----------------------------------------------------------------------------
# Connection-pooled database URL (PgBouncer) for runtime queries:
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/medinexa?sslmode=require&connection_limit=20"
# Direct unpooled connection URL for Prisma schema migrations:
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/medinexa?sslmode=require"

# -----------------------------------------------------------------------------
# 3. AUTHENTICATION & ENCRYPTION
# -----------------------------------------------------------------------------
# Cryptographically secure 256-bit+ random secret (e.g. openssl rand -base64 64)
JWT_SECRET=generate_strong_64_character_random_secret_here
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=generate_strong_64_character_refresh_secret_here
# Dedicated key for encrypting TOTP two-factor seeds (defaults to JWT_SECRET if omitted)
TOTP_ENCRYPTION_KEY=generate_strong_32_byte_encryption_key_here

# -----------------------------------------------------------------------------
# 4. REDIS CACHE & DISTRIBUTED RATE LIMITING
# -----------------------------------------------------------------------------
# Upstash Redis connection string (system falls back to in-memory if omitted)
REDIS_URL=rediss://default:your_upstash_token@your-endpoint.upstash.io:6379
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# -----------------------------------------------------------------------------
# 5. OBJECT STORAGE (SUPABASE STORAGE / CLOUDFLARE R2)
# -----------------------------------------------------------------------------
# Supported values: 'supabase' (Recommended), 'r2', or omit for fail-closed Disabled provider.
# Local filesystem storage is strictly prohibited in production mode.
STORAGE_PROVIDER=supabase

# Supabase Storage Configuration (Private bucket: medinexa-vault)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=medinexa-vault

# Cloudflare R2 Configuration (Alternative private object storage)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=medinexa-vault

# -----------------------------------------------------------------------------
# 6. AI PROVIDERS (SERVER-SIDE ONLY)
# -----------------------------------------------------------------------------
# Hierarchy: Anthropic Claude (Primary) -> Google Gemini (Secondary) -> OpenAI -> Deterministic Rules
# Explicit provider override: 'ANTHROPIC', 'GEMINI', 'OPENAI', or 'MOCK'
AI_PROVIDER=ANTHROPIC
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MEDINEXA_AI_API_KEY=your_enterprise_unified_ai_key_here
# Optional model override (e.g. claude-3-5-sonnet-20241022 or gemini-1.5-flash):
AI_MODEL=claude-3-5-sonnet-20241022

# -----------------------------------------------------------------------------
# 7. COMMUNICATIONS (EMAIL & SMS)
# -----------------------------------------------------------------------------
# SMTP configuration (uses simulated logging if credentials omitted):
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password
SMTP_FROM="MediNexa Health <notifications@medinexa.health>"

# SMS Gateway (MSG91 / Fast2SMS / Twilio)
SMS_PROVIDER=MSG91
SMS_SENDER_ID=MDNEXA
MSG91_API_KEY=your_msg91_api_key
DLT_ENTITY_ID=1101552390000041289

# -----------------------------------------------------------------------------
# 8. PAYMENT GATEWAY (HACKATHON DEMO SANDBOX & RAZORPAY)
# -----------------------------------------------------------------------------
# Enable safe demo mode for zero-risk presentations (generates DEMO_ORD_ & DEMO_TXN_)
DEMO_MODE=true
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
