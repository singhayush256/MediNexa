# =============================================================================
# MEDINEXA DUPLICATE — BACKEND API ENVIRONMENT VARIABLES (.env.example)
# =============================================================================
# Configure these variables in your Render Web Service Environment Console.
# NEVER commit raw production credentials, passwords, or secret keys to Git.

# -----------------------------------------------------------------------------
# 1. RUNTIME & SERVER
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=10000
API_PREFIX=/api/v1
# Comma-separated allowed frontend origins for CORS:
CORS_ORIGIN=https://medinexa-duplicate.vercel.app,https://medi-nexa-web-nu.vercel.app,https://medinexa.com,https://app.medinexa.in

# -----------------------------------------------------------------------------
# 2. NEON POSTGRESQL DATABASE
# -----------------------------------------------------------------------------
# Connection-pooled database URL (PgBouncer) for runtime queries:
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/medinexa?sslmode=require&connection_limit=20"
# Direct unpooled connection URL for Prisma schema migrations:
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/medinexa?sslmode=require"

# -----------------------------------------------------------------------------
# 3. AUTHENTICATION & ENCRYPTION
# -----------------------------------------------------------------------------
# Cryptographically secure 256-bit+ random secret (e.g. openssl rand -base64 64)
JWT_SECRET=generate_strong_64_character_random_secret_here
JWT_EXPIRES_IN=24h
# Dedicated key for encrypting TOTP two-factor seeds (defaults to JWT_SECRET if omitted)
TOTP_ENCRYPTION_KEY=generate_strong_32_byte_encryption_key_here

# -----------------------------------------------------------------------------
# 4. REDIS CACHE & DISTRIBUTED RATE LIMITING
# -----------------------------------------------------------------------------
# Upstash Redis connection string (system falls back to in-memory if omitted)
REDIS_URL=rediss://default:your_upstash_token@your-endpoint.upstash.io:6379
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# -----------------------------------------------------------------------------
# 5. OBJECT STORAGE (CLOUDFLARE R2)
# -----------------------------------------------------------------------------
# If unconfigured, the system activates DisabledStorageProvider (fail-closed HTTP 503)
# Local filesystem storage is strictly prohibited in production.
STORAGE_PROVIDER=r2
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=medinexa-vault

# -----------------------------------------------------------------------------
# 6. AI PROVIDERS (SERVER-SIDE ONLY)
# -----------------------------------------------------------------------------
# Standard Google Gemini API key:
GEMINI_API_KEY=your_gemini_api_key_here
# Optional Anthropic Claude API key:
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional OpenAI API key:
OPENAI_API_KEY=your_openai_api_key_here
# Optional model override:
AI_MODEL=medinexa-clinical-deep-v2

# -----------------------------------------------------------------------------
# 7. COMMUNICATIONS (EMAIL & SMS)
# -----------------------------------------------------------------------------
# SMTP configuration (uses simulated logging if credentials omitted):
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password
SMTP_FROM="MediNexa Health <notifications@medinexa.health>"

# SMS Gateway (MSG91 / Fast2SMS / Twilio)
SMS_PROVIDER=MSG91
SMS_SENDER_ID=MDNEXA
MSG91_API_KEY=your_msg91_api_key
DLT_ENTITY_ID=1101552390000041289

# -----------------------------------------------------------------------------
# 8. PAYMENT GATEWAY (RAZORPAY)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

