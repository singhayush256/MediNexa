# =============================================================================
# MEDINEXA DUPLICATE — WEB FRONTEND ENVIRONMENT VARIABLES (.env.example)
# =============================================================================
# Configure these variables in your Vercel Project Settings (Environment Variables).
# IMPORTANT: NEXT_PUBLIC_* variables are inlined into the client-side JavaScript bundle!
# NEVER put private API keys, database credentials, or secret keys here.

# -----------------------------------------------------------------------------
# 1. OFFICIAL FRONTEND & API GATEWAY BACKEND URLS (Production)
# -----------------------------------------------------------------------------
# Official public frontend domain:
NEXT_PUBLIC_APP_URL=https://medinexa-medicalweb.vercel.app

# Must point to your Render-hosted MediNexa API backend with HTTPS and /api/v1 prefix:
# Example: https://medinexa-duplicate-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://your-render-backend-url.onrender.com/api/v1

# -----------------------------------------------------------------------------
# 2. WEBSOCKET GATEWAY URL (Optional)
# -----------------------------------------------------------------------------
# If omitted, MediNexa automatically derives it by stripping /api/v1 from NEXT_PUBLIC_API_URL.
# Configure explicitly only if your WebSocket gateway is on a separate domain/proxy.
# Example: wss://medinexa-duplicate-api.onrender.com
NEXT_PUBLIC_WS_URL=wss://your-render-backend-url.onrender.com

# -----------------------------------------------------------------------------
# 3. RAZORPAY PUBLIC KEY (Optional - Client-side checkout modal)
# -----------------------------------------------------------------------------
# Test or Live Razorpay Key ID (Never put the secret key in frontend!)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

