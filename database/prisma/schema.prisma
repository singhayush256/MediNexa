  nurse         User        @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  ward          Ward?       @relation(fields: [wardId], references: [id])

  @@index([facilityId, status])
  @@index([nurseId, startTime])
  @@map("nursing_shifts")
}

/// MedicationAdministration (MAR) tracks inpatient drug administration, doses, and controlled drug witness verification.
model MedicationAdministration {
