generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Organization represents an enterprise healthcare network.
model Organization {
  id            String                     @id @default(uuid())
  name          String
  code          String                     @unique
  type          String                     @default("HOSPITAL")
  address       String?
  phone         String?
  email         String?
  isActive      Boolean                    @default(true) @map("is_active")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  facilities    Facility[]
  subscriptions OrganizationSubscription[]
  saasInvoices  SaaSInvoice[]
  saasPayments  SaaSPaymentTransaction[]
  trialAccount  TrialAccount?
  usageMetrics  UsageMetric[]
  users         User[]

  @@map("organizations")
}

/// SubscriptionPlan defines SaaS pricing tiers (Starter, Professional, Enterprise).
model SubscriptionPlan {
  id                  String                     @id @default(uuid())
  planCode            String                     @unique @map("plan_code")
  planName            String                     @map("plan_name")
  description         String?
  monthlyPrice        Float                      @default(0.0) @map("monthly_price")
  yearlyPrice         Float                      @default(0.0) @map("yearly_price")
  maxUsers            Int                        @default(10) @map("max_users")
  maxBeds             Int                        @default(25) @map("max_beds")
  maxDoctors          Int                        @default(5) @map("max_doctors")
  maxPatientsPerMonth Int                        @default(500) @map("max_patients_per_month")
  maxStorageGb        Int                        @default(50) @map("max_storage_gb")
  features            String?
  isActive            Boolean                    @default(true) @map("is_active")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  featureFlags        FeatureFlag[]
  subscriptions       OrganizationSubscription[]

  @@map("subscription_plans")
}

/// OrganizationSubscription tracks active B2B recurring subscription contracts.
model OrganizationSubscription {
  id                     String             @id @default(uuid())
  organizationId         String             @map("organization_id")
  planId                 String             @map("plan_id")
  startDate              DateTime           @default(now()) @map("start_date")
  endDate                DateTime?          @map("end_date")
  status                 SubscriptionStatus @default(TRIAL)
  billingCycle           BillingCycle       @default(MONTHLY) @map("billing_cycle")
  autoRenew              Boolean            @default(true) @map("auto_renew")
  currentPeriodStart     DateTime           @default(now()) @map("current_period_start")
  currentPeriodEnd       DateTime           @map("current_period_end")
  stripeSubscriptionId   String?            @map("stripe_subscription_id")
  razorpaySubscriptionId String?            @map("razorpay_subscription_id")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan   @relation(fields: [planId], references: [id])
  invoices               SaaSInvoice[]

  @@map("organization_subscriptions")
}

/// UsageMetric records consumption telemetry across users, beds, doctors, and storage.
model UsageMetric {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  metricType     MetricType   @map("metric_type")
  metricValue    Float        @default(0.0) @map("metric_value")
  recordedAt     DateTime     @default(now()) @map("recorded_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("usage_metrics")
}

/// SaaSInvoice records B2B recurring subscription invoices and charges.
model SaaSInvoice {
  id               String                    @id @default(uuid())
  invoiceNumber    String                    @unique @map("invoice_number")
  organizationId   String                    @map("organization_id")
  subscriptionId   String?                   @map("subscription_id")
  invoiceDate      DateTime                  @default(now()) @map("invoice_date")
  dueDate          DateTime                  @map("due_date")
  subtotal         Float                     @default(0.0)
  taxAmount        Float                     @default(0.0) @map("tax_amount")
  totalAmount      Float                     @default(0.0) @map("total_amount")
  paymentStatus    SaaSInvoicePaymentStatus  @default(PENDING) @map("payment_status")
  hostedInvoiceUrl String?                   @map("hosted_invoice_url")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription     OrganizationSubscription? @relation(fields: [subscriptionId], references: [id])
  transactions     SaaSPaymentTransaction[]

  @@map("saas_invoices")
}

/// SaaSPaymentTransaction logs Stripe and Razorpay settlement transactions.
model SaaSPaymentTransaction {
  id                   String       @id @default(uuid())
  invoiceId            String       @map("invoice_id")
  organizationId       String       @map("organization_id")
  amount               Float
  paymentProvider      String       @default("STRIPE") @map("payment_provider")
  transactionReference String       @unique @map("transaction_reference")
  status               String       @default("SUCCESS")
  paidAt               DateTime     @default(now()) @map("paid_at")
  invoice              SaaSInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("saas_payment_transactions")
}

/// FeatureFlag controls granular capability access by SubscriptionPlan.
model FeatureFlag {
  id          String           @id @default(uuid())
  planId      String           @map("plan_id")
  featureCode String           @map("feature_code")
  featureName String           @map("feature_name")
  enabled     Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at")
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("feature_flags")
}

/// TrialAccount tracks 14-day free evaluations and self-serve conversion pipelines.
model TrialAccount {
  id               String       @id @default(uuid())
  organizationId   String       @unique @map("organization_id")
  trialStartDate   DateTime     @default(now()) @map("trial_start_date")
  trialEndDate     DateTime     @map("trial_end_date")
  conversionStatus String       @default("TRIAL_ACTIVE") @map("conversion_status")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("trial_accounts")
}

/// Facility represents a physical hospital, medical center, or clinic under an Organization.
model Facility {
  id                      String                               @id @default(uuid())
  organizationId          String                               @map("organization_id")
  name                    String
  code                    String                               @unique
  address                 String?
  city                    String?
  state                   String?
  postalCode              String?                              @map("postal_code")
  latitude                Float?
  longitude               Float?
  facilityType            String?                              @map("facility_type")
  rating                  Float?                               @default(4.5)
  servicesOffered         String[]                             @default([]) @map("services_offered")
  phone                   String?
  email                   String?
  status                  String                               @default("ACTIVE")
  createdAt               DateTime                             @default(now()) @map("created_at")
  updatedAt               DateTime                             @updatedAt @map("updated_at")
  bedStatus               HospitalBedStatus?
  bedBookings             BedBooking[]
  abdmAuditLogs           AbdmAuditLog[]
  abdmConsents            AbdmConsent[]
  accountsReceivables     AccountsReceivable[]
  admissions              Admission[]
  aiSummaries             AiGeneratedSummary[]
  ambulanceCrews          AmbulanceCrew[]
  destinationDispatches   AmbulanceDispatch[]                  @relation("DispatchDestinationFacility")
  drivers                 AmbulanceDriverProfile[]
  ambulances              Ambulance[]
  appointments            Appointment[]
  attendanceRecords       AttendanceRecord[]
  beds                    Bed[]
  billingInvoices         BillingInvoice[]
  bloodDiscards           BloodDiscardRecord[]
  bloodDonations          BloodDonation[]
  bloodDonors             BloodDonor[]
  bloodInventoryUnits     BloodInventoryUnit[]
  bloodRequests           BloodRequest[]
  capaRecords             CAPARecord[]
  clinicalAlerts          ClinicalAlert[]
  encounters              ClinicalEncounter[]
  clinicalRecommendations ClinicalRecommendation[]
  clinicalRules           ClinicalRule[]
  codeBlueEvents          CodeBlueEvent[]
  controlledAudits        ControlledSubstanceAudit[]
  corporateContracts      CorporateContract[]
  costCenters             CostCenter[]
  destXftTransfers        CrossFacilityTransfer[]              @relation("DestFacilityXft")
  sourceXftTransfers      CrossFacilityTransfer[]              @relation("SourceFacilityXft")
  dashboardWidgets        DashboardWidget[]
  departmentClearances    DepartmentClearance[]
  departments             Department[]
  dischargeSummaries      DischargeSummary[]
  doctors                 DoctorProfile[]
  doctorSchedules         DoctorSchedule[]
  drugMasters             DrugMaster[]
  emergencyCalls          EmergencyCall[]
  destEmergencies         EmergencyRequest[]                   @relation("DestFacilityEmergencies")
  sourceEmergencies       EmergencyRequest[]                   @relation("SourceFacilityEmergencies")
  emergencyVisits         EmergencyVisit[]
  employeeProfiles        EmployeeProfile[]
  employees               Employee[]
  executiveAlerts         ExecutiveAlert[]
  organization            Organization                         @relation(fields: [organizationId], references: [id])
  attachments             FileAttachment[]
  financialAuditLogs      FinancialAuditLog[]
  fleetMaintenances       FleetMaintenance[]
  glAccounts              GeneralLedgerAccount[]
  grns                    GoodsReceiptNote[]
  guestBookings           GuestBooking[]
  handHygieneAudits       HandHygieneAudit[]
  sourceRecordShares      HealthRecordShare[]                  @relation("SourceFacilityShares")
  targetRecordShares      HealthRecordShare[]                  @relation("TargetFacilityShares")
  hospitalAssets          HospitalAsset[]
  hospitalPredictions     HospitalPrediction[]
  incomingReferrals       HospitalReferral[]                   @relation("DestFacilityReferrals")
  outgoingReferrals       HospitalReferral[]                   @relation("SourceFacilityReferrals")
  icuAdmissions           IcuAdmission[]
  imagingOrders           ImagingOrder[]
  incidentReports         IncidentReport[]
  infectionCases          InfectionCase[]
  insuranceClaims         InsuranceClaim[]
  inventoryItems          InventoryItem[]
  invoices                Invoice[]
  kpiSnapshots            KpiSnapshot[]
  labOrders               LabOrder[]
  medicalDevices          MedicalDevice[]
  destRecordAuths         MedicalRecordTransferAuthorization[] @relation("DestFacilityRecordAuth")
  sourceRecordAuths       MedicalRecordTransferAuthorization[] @relation("SourceFacilityRecordAuth")
  medicationOrders        MedicationOrder[]
  medicationSafetyAudits  MedicationSafetyAudit[]
  nursingShifts           NursingShift[]
  opdTokens               OpdToken[]
  operationTheatres       OperationTheatre[]
  patientAlerts           PatientAlert[]
  patientRiskScores       PatientRiskScore[]
  patientVitalStreams     PatientVitalStream[]
  payrollRuns             PayrollRun[]
  pharmacyDispenseRecords PharmacyDispenseRecord[]
  pharmacyInventories     PharmacyInventory[]
  prescriptions           Prescription[]
  procurementOrders       ProcurementPurchaseOrder[]
  procurementPOs          HospitalProcurementPO[]
  purchaseOrders          PurchaseOrder[]
  purchaseRequisitions    PurchaseRequisition[]
  qualityAudits           QualityAudit[]
  radiologyOrders         RadiologyOrder[]
  revenueCycles           RevenueCycle[]
  revenueForecasts        RevenueForecast[]
  revenueLedgers          RevenueLedger[]
  safetyChecklists        SafetyChecklist[]
  surgeries               SurgerySchedule[]
  telemedicineSessions    TelemedicineSession[]
  transfusionRecords      TransfusionRecord[]
  users                   User[]
  ventilators             Ventilator[]
  wards                   Ward[]

  @@map("facilities")
}

/// Department represents clinical/operational units within a Facility.
model Department {
  id                   String                @id @default(uuid())
  facilityId           String                @map("facility_id")
  name                 String
  code                 String
  status               String                @default("ACTIVE")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  admissions           Admission[]
  appointments         Appointment[]
  encounters           ClinicalEncounter[]
  facility             Facility              @relation(fields: [facilityId], references: [id])
  doctors              DoctorProfile[]
  doctorSchedules      DoctorSchedule[]
  employees            Employee[]
  handHygieneAudits    HandHygieneAudit[]
  hospitalAssets       HospitalAsset[]
  opdTokens            OpdToken[]
  purchaseRequisitions PurchaseRequisition[]
  qualityAudits        QualityAudit[]
  shifts               ShiftAssignment[]
  wards                Ward[]

  @@unique([facilityId, code])
  @@map("departments")
}

/// Specialty represents medical specializations for doctors.
model Specialty {
  id           String          @id @default(uuid())
  name         String          @unique
  code         String          @unique
  description  String?
  status       String          @default("ACTIVE")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  appointments Appointment[]
  doctors      DoctorProfile[]

  @@map("specialties")
}

/// Ward represents a clinical ward within a Facility & Department.
model Ward {
  id            String         @id @default(uuid())
  facilityId    String         @map("facility_id")
  departmentId  String         @map("department_id")
  name          String
  code          String
  wardType      WardType       @default(GENERAL) @map("ward_type")
  genderPolicy  String?        @map("gender_policy")
  floor         String?
  status        WardStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  beds          Bed[]
  nursingShifts NursingShift[]
  rooms         Room[]
  department    Department     @relation(fields: [departmentId], references: [id])
  facility      Facility       @relation(fields: [facilityId], references: [id])

  @@unique([facilityId, code])
  @@map("wards")
}

/// Room represents a room within a Ward.
model Room {
  id         String     @id @default(uuid())
  wardId     String     @map("ward_id")
  roomNumber String     @map("room_number")
  roomType   RoomType   @default(GENERAL) @map("room_type")
  floor      String?
  capacity   Int        @default(1)
  status     RoomStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  beds       Bed[]
  ward       Ward       @relation(fields: [wardId], references: [id])

  @@unique([wardId, roomNumber])
  @@map("rooms")
}

/// Bed represents a physical hospital bed unit.
model Bed {
  id             String                  @id @default(uuid())
  roomId         String                  @map("room_id")
  wardId         String                  @map("ward_id")
  facilityId     String                  @map("facility_id")
  bedNumber      String                  @map("bed_number")
  bedType        BedType                 @default(GENERAL) @map("bed_type")
  status         BedStatus               @default(AVAILABLE)
  genderPolicy   String?                 @map("gender_policy")
  isActive       Boolean                 @default(true) @map("is_active")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  transfersFrom  AdmissionTransfer[]     @relation("TransferFromBed")
  transfersTo    AdmissionTransfer[]     @relation("TransferToBed")
  assignments    BedAssignment[]
  reservations   BedReservation[]
  history        BedStatusHistory[]
  facility       Facility                @relation(fields: [facilityId], references: [id])
  room           Room                    @relation(fields: [roomId], references: [id])
  ward           Ward                    @relation(fields: [wardId], references: [id])
  destXfts       CrossFacilityTransfer[] @relation("DestBedXft")
  sourceXfts     CrossFacilityTransfer[] @relation("SourceBedXft")
  icuAdmissions  IcuAdmission[]
  medicalDevices MedicalDevice[]
  bedBookings    BedBooking[]            @relation("BedAllocatedBookings")

  @@unique([roomId, bedNumber])
  @@map("beds")
}

/// BedReservation records patient bed reservation holds.
model BedReservation {
  id            String            @id @default(uuid())
  bedId         String            @map("bed_id")
  patientId     String            @map("patient_id")
  reservedBy    String            @map("reserved_by")
  referralId    String?           @map("referral_id")
  reservedAt    DateTime          @default(now()) @map("reserved_at")
  expiresAt     DateTime          @map("expires_at")
  convertedAt   DateTime?         @map("converted_at")
  cancelledAt   DateTime?         @map("cancelled_at")
  status        ReservationStatus @default(ACTIVE)
  reason        String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  assignments   BedAssignment[]
  bed           Bed               @relation(fields: [bedId], references: [id])
  patient       PatientProfile    @relation(fields: [patientId], references: [id])
  referral      HospitalReferral? @relation(fields: [referralId], references: [id])
  reservingUser User              @relation(fields: [reservedBy], references: [id])

  @@map("bed_reservations")
}

/// BedAssignment records patient bed assignments.
model BedAssignment {
  id            String           @id @default(uuid())
  bedId         String           @map("bed_id")
  patientId     String           @map("patient_id")
  assignedBy    String           @map("assigned_by")
  reservationId String?          @map("reservation_id")
  admissionId   String?          @map("admission_id")
  assignedAt    DateTime         @default(now()) @map("assigned_at")
  releasedAt    DateTime?        @map("released_at")
  status        AssignmentStatus @default(ACTIVE)
  reason        String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  admission     Admission?       @relation(fields: [admissionId], references: [id])
  assigningUser User             @relation(fields: [assignedBy], references: [id])
  bed           Bed              @relation(fields: [bedId], references: [id])
  patient       PatientProfile   @relation(fields: [patientId], references: [id])
  reservation   BedReservation?  @relation(fields: [reservationId], references: [id])

  @@map("bed_assignments")
}

/// BedStatusHistory audits all operational state transitions.
model BedStatusHistory {
  id             String          @id @default(uuid())
  bedId          String          @map("bed_id")
  previousStatus BedStatus       @map("previous_status")
  newStatus      BedStatus       @map("new_status")
  changedBy      String          @map("changed_by")
  patientId      String?         @map("patient_id")
  reason         String?
  createdAt      DateTime        @default(now()) @map("created_at")
  bed            Bed             @relation(fields: [bedId], references: [id])
  changingUser   User            @relation(fields: [changedBy], references: [id])
  patient        PatientProfile? @relation(fields: [patientId], references: [id])

  @@map("bed_status_histories")
}

/// Admission represents a clinical inpatient stay at a Facility.
model Admission {
  id                        String                     @id @default(uuid())
  patientId                 String                     @map("patient_id")
  facilityId                String                     @map("facility_id")
  departmentId              String                     @map("department_id")
  admissionNumber           String                     @unique @map("admission_number")
  admissionType             AdmissionType              @default(EMERGENCY) @map("admission_type")
  status                    AdmissionStatus            @default(PLANNED)
  admittedAt                DateTime                   @default(now()) @map("admitted_at")
  admittedBy                String                     @map("admitted_by")
  expectedDischargeAt       DateTime?                  @map("expected_discharge_at")
  dischargedAt              DateTime?                  @map("discharged_at")
  dischargeReason           String?                    @map("discharge_reason")
  reason                    String?
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  statusHistory             AdmissionStatusHistory[]
  transfers                 AdmissionTransfer[]
  admitter                  User                       @relation(fields: [admittedBy], references: [id])
  department                Department                 @relation(fields: [departmentId], references: [id])
  facility                  Facility                   @relation(fields: [facilityId], references: [id])
  patient                   PatientProfile             @relation(fields: [patientId], references: [id])
  bedAssignments            BedAssignment[]
  billingInvoices           BillingInvoice[]
  bloodRequests             BloodRequest[]
  clinicalAlerts            ClinicalAlert[]
  encounters                ClinicalEncounter[]
  clinicalRecommendations   ClinicalRecommendation[]
  destXftTransfers          CrossFacilityTransfer[]    @relation("DestAdmissionXft")
  sourceXftTransfers        CrossFacilityTransfer[]    @relation("SourceAdmissionXft")
  departmentClearances      DepartmentClearance[]
  dischargeSummary          DischargeSummary?
  referrals                 HospitalReferral[]
  icuAdmissions             IcuAdmission[]
  imagingOrders             ImagingOrder[]
  infectionCases            InfectionCase[]
  insuranceClaims           InsuranceClaim[]
  invoices                  Invoice[]
  labOrders                 LabOrder[]
  medicationAdministrations MedicationAdministration[]
  riskScores                PatientRiskScore[]
  radiologyOrders           RadiologyOrder[]
  revenueCycles             RevenueCycle[]
  safetyChecklists          SafetyChecklist[]
  vitalsFlowsheets          VitalsFlowsheet[]
  bedBookings               BedBooking[]               @relation("AdmissionBedBooking")

  @@map("admissions")
}

/// AdmissionTransfer records patient transfers within the same facility.
model AdmissionTransfer {
  id               String         @id @default(uuid())
  admissionId      String         @map("admission_id")
  patientId        String         @map("patient_id")
  fromBedId        String         @map("from_bed_id")
  toBedId          String         @map("to_bed_id")
  fromRoomId       String?        @map("from_room_id")
  toRoomId         String?        @map("to_room_id")
  fromWardId       String?        @map("from_ward_id")
  toWardId         String?        @map("to_ward_id")
  fromDepartmentId String?        @map("from_department_id")
  toDepartmentId   String?        @map("to_department_id")
  reason           String?
  transferredBy    String         @map("transferred_by")
  transferredAt    DateTime       @default(now()) @map("transferred_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  admission        Admission      @relation(fields: [admissionId], references: [id])
  fromBed          Bed            @relation("TransferFromBed", fields: [fromBedId], references: [id])
  patient          PatientProfile @relation(fields: [patientId], references: [id])
  toBed            Bed            @relation("TransferToBed", fields: [toBedId], references: [id])
  transferrer      User           @relation(fields: [transferredBy], references: [id])

  @@map("admission_transfers")
}

/// AdmissionStatusHistory records audit logs of admission status transitions.
model AdmissionStatusHistory {
  id             String          @id @default(uuid())
  admissionId    String          @map("admission_id")
  previousStatus AdmissionStatus @map("previous_status")
  newStatus      AdmissionStatus @map("new_status")
  changedBy      String          @map("changed_by")
  reason         String?
  createdAt      DateTime        @default(now()) @map("created_at")
  admission      Admission       @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  changer        User            @relation(fields: [changedBy], references: [id])

  @@map("admission_status_histories")
}

/// ClinicalEncounter represents a formal clinical event/interaction between a patient and provider.
model ClinicalEncounter {
  id              String             @id @default(uuid())
  patientId       String             @map("patient_id")
  doctorId        String             @map("doctor_id")
  facilityId      String             @map("facility_id")
  departmentId    String             @map("department_id")
  admissionId     String?            @map("admission_id")
  encounterNumber String             @unique @map("encounter_number")
  encounterType   EncounterType      @default(OUTPATIENT) @map("encounter_type")
  status          EncounterStatus    @default(SCHEDULED)
  reasonForVisit  String?            @map("reason_for_visit")
  startedAt       DateTime           @default(now()) @map("started_at")
  endedAt         DateTime?          @map("ended_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  appointments    Appointment[]
  billingInvoices BillingInvoice[]
  bloodRequests   BloodRequest[]
  admission       Admission?         @relation(fields: [admissionId], references: [id])
  department      Department         @relation(fields: [departmentId], references: [id])
  doctor          DoctorProfile      @relation(fields: [doctorId], references: [id])
  facility        Facility           @relation(fields: [facilityId], references: [id])
  patient         PatientProfile     @relation(fields: [patientId], references: [id])
  clinicalNotes   ClinicalNote[]
  diagnoses       Diagnosis[]
  referrals       HospitalReferral[]
  invoices        Invoice[]
  labOrders       LabOrder[]
  prescriptions   Prescription[]
  vitalSigns      VitalSign[]

  @@map("clinical_encounters")
}

/// ClinicalNote represents medical clinical notes.
model ClinicalNote {
  id          String                @id @default(uuid())
  encounterId String                @map("encounter_id")
  authorId    String                @map("author_id")
  noteType    NoteType              @default(PROGRESS_NOTE) @map("note_type")
  content     String
  status      NoteStatus            @default(DRAFT)
  signedAt    DateTime?             @map("signed_at")
  signedBy    String?               @map("signed_by")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  versions    ClinicalNoteVersion[]
  author      User                  @relation("NoteAuthor", fields: [authorId], references: [id])
  encounter   ClinicalEncounter     @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  signer      User?                 @relation("NoteSigner", fields: [signedBy], references: [id])

  @@map("clinical_notes")
}

/// ClinicalNoteVersion preserves historical versions of signed/amended clinical notes.
model ClinicalNoteVersion {
  id            String       @id @default(uuid())
  noteId        String       @map("note_id")
  versionNumber Int          @map("version_number")
  content       String
  reason        String?
  createdBy     String       @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  creator       User         @relation(fields: [createdBy], references: [id])
  note          ClinicalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("clinical_note_versions")
}

/// VitalSign records physiological measurements taken during a clinical encounter.
model VitalSign {
  id               String            @id @default(uuid())
  encounterId      String            @map("encounter_id")
  patientId        String            @map("patient_id")
  recordedBy       String            @map("recorded_by")
  recordedAt       DateTime          @default(now()) @map("recorded_at")
  temperature      Float?
  heartRate        Int?              @map("heart_rate")
  respiratoryRate  Int?              @map("respiratory_rate")
  systolicBP       Int?              @map("systolic_bp")
  diastolicBP      Int?              @map("diastolic_bp")
  oxygenSaturation Float?            @map("oxygen_saturation")
  weight           Float?
  height           Float?
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  encounter        ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patient          PatientProfile    @relation(fields: [patientId], references: [id])
  recorder         User              @relation(fields: [recordedBy], references: [id])

  @@map("vital_signs")
}

/// Diagnosis represents medical conditions and clinical diagnoses recorded for a patient.
model Diagnosis {
  id            String            @id @default(uuid())
  encounterId   String            @map("encounter_id")
  patientId     String            @map("patient_id")
  recordedBy    String            @map("recorded_by")
  diagnosisCode String?           @map("diagnosis_code")
  diagnosisName String            @map("diagnosis_name")
  description   String?
  diagnosisType DiagnosisType     @default(PRIMARY) @map("diagnosis_type")
  status        DiagnosisStatus   @default(ACTIVE)
  diagnosedAt   DateTime          @default(now()) @map("diagnosed_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  encounter     ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patient       PatientProfile    @relation(fields: [patientId], references: [id])
  diagnoser     User              @relation(fields: [recordedBy], references: [id])

  @@map("diagnoses")
}

/// LabTest represents a master lab test catalog item.
model LabTest {
  id                    String          @id @default(uuid())
  code                  String          @unique
  name                  String
  category              LabTestCategory @default(BIOCHEMISTRY)
  description           String?
  specimenType          String          @map("specimen_type")
  turnaroundTimeMinutes Int             @default(60) @map("turnaround_time_minutes")
  price                 Float           @default(0.0)
  status                String          @default("ACTIVE")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  orderItems            LabOrderItem[]

  @@map("lab_tests")
}

/// LabOrder represents a clinical lab test order linked to an Encounter.
model LabOrder {
  id                String             @id @default(uuid())
  orderNumber       String             @unique @map("order_number")
  encounterId       String?            @map("encounter_id")
  patientId         String             @map("patient_id")
  doctorId          String             @map("doctor_id")
  facilityId        String             @map("facility_id")
  priority          LabOrderPriority   @default(ROUTINE)
  status            LabOrderStatus     @default(ORDERED)
  clinicalNotes     String?            @map("clinical_notes")
  orderedAt         DateTime           @default(now()) @map("ordered_at")
  collectedAt       DateTime?          @map("collected_at")
  completedAt       DateTime?          @map("completed_at")
  verifiedAt        DateTime?          @map("verified_at")
  verifiedBy        String?            @map("verified_by")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  admissionId       String?            @map("admission_id")
  items             LabOrderItem[]
  admission         Admission?         @relation(fields: [admissionId], references: [id])
  doctor            DoctorProfile      @relation(fields: [doctorId], references: [id])
  encounter         ClinicalEncounter? @relation(fields: [encounterId], references: [id])
  facility          Facility           @relation(fields: [facilityId], references: [id])
  patient           PatientProfile     @relation(fields: [patientId], references: [id])
  verifier          User?              @relation("LabOrderVerifier", fields: [verifiedBy], references: [id])
  testItems         LabTestItem[]
  sampleCollections SampleCollection[]
  specimens         Specimen[]

  @@map("lab_orders")
}

/// LabTestItem represents an individual diagnostic test item within LIMS.
model LabTestItem {
  id             String         @id @default(uuid())
  labOrderId     String         @map("lab_order_id")
  testName       String         @map("test_name")
  category       String         @default("BIOCHEMISTRY")
  status         LabOrderStatus @default(ORDERED)
  resultValue    String?        @map("result_value")
  referenceRange String?        @map("reference_range")
  unit           String?
  flag           ResultFlag     @default(NORMAL)
  verifiedById   String?        @map("verified_by_id")
  verifiedAt     DateTime?      @map("verified_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  labOrder       LabOrder       @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  verifiedBy     User?          @relation("LabTestItemVerifier", fields: [verifiedById], references: [id])

  @@map("lab_test_items")
}

/// SampleCollection represents a specimen sample collected with barcode tracking.
model SampleCollection {
  id            String     @id @default(uuid())
  labOrderId    String     @map("lab_order_id")
  collectedById String     @map("collected_by_id")
  sampleType    SampleType @default(BLOOD)
  barcode       String     @unique
  collectedAt   DateTime   @default(now()) @map("collected_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  collectedBy   User       @relation("SampleCollector", fields: [collectedById], references: [id])
  labOrder      LabOrder   @relation(fields: [labOrderId], references: [id], onDelete: Cascade)

  @@map("sample_collections")
}

/// LabOrderItem represents an individual test included within a LabOrder.
model LabOrderItem {
  id         String      @id @default(uuid())
  labOrderId String      @map("lab_order_id")
  labTestId  String      @map("lab_test_id")
  status     String      @default("PENDING")
  notes      String?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  labOrder   LabOrder    @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTest    LabTest     @relation(fields: [labTestId], references: [id])
  results    LabResult[]

  @@map("lab_order_items")
}

/// Specimen represents a physical biological sample collected for a LabOrder.
model Specimen {
  id              String         @id @default(uuid())
  specimenNumber  String         @unique @map("specimen_number")
  labOrderId      String         @map("lab_order_id")
  patientId       String         @map("patient_id")
  specimenType    String         @map("specimen_type")
  status          SpecimenStatus @default(PENDING)
  collectedBy     String?        @map("collected_by")
  collectedAt     DateTime?      @map("collected_at")
  receivedAt      DateTime?      @map("received_at")
  rejectedAt      DateTime?      @map("rejected_at")
  rejectionReason String?        @map("rejection_reason")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  collector       User?          @relation(fields: [collectedBy], references: [id])
  labOrder        LabOrder       @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  patient         PatientProfile @relation(fields: [patientId], references: [id])

  @@map("specimens")
}

/// LabResult represents the quantitative/qualitative result entered for a LabOrderItem.
model LabResult {
  id             String             @id @default(uuid())
  labOrderItemId String             @map("lab_order_item_id")
  patientId      String             @map("patient_id")
  resultValue    String             @map("result_value")
  numericValue   Float?             @map("numeric_value")
  unit           String?
  referenceRange String?            @map("reference_range")
  abnormalFlag   AbnormalFlag       @default(NORMAL) @map("abnormal_flag")
  resultStatus   LabResultStatus    @default(PRELIMINARY) @map("result_status")
  interpretation String?
  enteredBy      String             @map("entered_by")
  verifiedBy     String?            @map("verified_by")
  enteredAt      DateTime           @default(now()) @map("entered_at")
  verifiedAt     DateTime?          @map("verified_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  versions       LabResultVersion[]
  enterer        User               @relation("ResultEnterer", fields: [enteredBy], references: [id])
  labOrderItem   LabOrderItem       @relation(fields: [labOrderItemId], references: [id], onDelete: Cascade)
  patient        PatientProfile     @relation(fields: [patientId], references: [id])
  verifier       User?              @relation("ResultVerifier", fields: [verifiedBy], references: [id])

  @@map("lab_results")
}

/// LabResultVersion preserves historical versions of lab results when amended.
model LabResultVersion {
  id            String       @id @default(uuid())
  resultId      String       @map("result_id")
  versionNumber Int          @map("version_number")
  resultValue   String       @map("result_value")
  numericValue  Float?       @map("numeric_value")
  abnormalFlag  AbnormalFlag @default(NORMAL) @map("abnormal_flag")
  reason        String?
  createdBy     String       @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  creator       User         @relation(fields: [createdBy], references: [id])
  result        LabResult    @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@map("lab_result_versions")
}

/// Medication represents a master pharmaceutical drug catalog item as well as patient medications.
model Medication {
  id                   String             @id @default(uuid())
  code                 String             @unique @default(uuid())
  genericName          String             @default("") @map("generic_name")
  brandName            String             @default("") @map("brand_name")
  strength             String             @default("")
  dosageForm           String             @default("") @map("dosage_form")
  route                String             @default("ORAL")
  category             String             @default("GENERAL")
  manufacturer         String?
  prescriptionRequired Boolean            @default(true) @map("prescription_required")
  status               String             @default("ACTIVE")
  patientId            String?            @map("patient_id")
  medicineName         String?            @map("medicine_name")
  dosage               String?
  frequency            String?
  timing               String[]           @default([])
  beforeMeal           Boolean            @default(false) @map("before_meal")
  startDate            DateTime?          @map("start_date")
  endDate              DateTime?          @map("end_date")
  prescribedBy         String?            @map("prescribed_by")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  prescriptionItems    PrescriptionItem[]
  logs                 MedicationLog[]
  patient              PatientProfile?    @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, status])
  @@map("medications")
}

/// Prescription represents a digital medical prescription created during a ClinicalEncounter.
model Prescription {
  id                 String                  @id @default(uuid())
  prescriptionNumber String                  @unique @map("prescription_number")
  encounterId        String                  @map("encounter_id")
  patientId          String                  @map("patient_id")
  doctorId           String                  @map("doctor_id")
  facilityId         String                  @map("facility_id")
  status             PrescriptionStatus      @default(DRAFT)
  prescribedAt       DateTime                @default(now()) @map("prescribed_at")
  validUntil         DateTime?               @map("valid_until")
  notes              String?
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  amendments         PrescriptionAmendment[]
  dispenses          PrescriptionDispense[]
  items              PrescriptionItem[]
  doctor             DoctorProfile           @relation(fields: [doctorId], references: [id])
  encounter          ClinicalEncounter       @relation(fields: [encounterId], references: [id])
  facility           Facility                @relation(fields: [facilityId], references: [id])
  patient            PatientProfile          @relation(fields: [patientId], references: [id])

  @@map("prescriptions")
}

/// PrescriptionItem represents an individual drug item prescribed within a Prescription.
model PrescriptionItem {
  id             String                 @id @default(uuid())
  prescriptionId String                 @map("prescription_id")
  medicationId   String                 @map("medication_id")
  dosage         String
  frequency      String
  route          String
  duration       String
  quantity       Int                    @default(1)
  instructions   String?
  refillsAllowed Int                    @default(0) @map("refills_allowed")
  refillsUsed    Int                    @default(0) @map("refills_used")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  reminders      MedicationReminder[]
  dispenses      PrescriptionDispense[]
  medication     Medication             @relation(fields: [medicationId], references: [id])
  prescription   Prescription           @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

/// PrescriptionAmendment preserves amendment logs when an issued prescription is updated.
model PrescriptionAmendment {
  id              String       @id @default(uuid())
  prescriptionId  String       @map("prescription_id")
  amendmentNumber Int          @map("amendment_number")
  reason          String
  createdBy       String       @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  creator         User         @relation(fields: [createdBy], references: [id])
  prescription    Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_amendments")
}

/// PrescriptionDispense records pharmacy dispensing transactions against prescription items.
model PrescriptionDispense {
  id                 String           @id @default(uuid())
  dispenseNumber     String           @unique @map("dispense_number")
  prescriptionId     String           @map("prescription_id")
  prescriptionItemId String           @map("prescription_item_id")
  dispensedBy        String           @map("dispensed_by")
  quantityDispensed  Int              @map("quantity_dispensed")
  dispensedAt        DateTime         @default(now()) @map("dispensed_at")
  status             DispenseStatus   @default(DISPENSED)
  notes              String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  batchNumber        String?          @map("batch_number")
  expirationDate     DateTime?        @map("expiration_date")
  dispenser          User             @relation(fields: [dispensedBy], references: [id])
  prescription       Prescription     @relation(fields: [prescriptionId], references: [id])
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])

  @@map("prescription_dispenses")
}

/// EmergencyRequest records emergency calls and triage incidents.
model EmergencyRequest {
  id                    String              @id @default(uuid())
  emergencyNumber       String              @unique @map("emergency_number")
  patientId             String?             @map("patient_id")
  callerName            String              @map("caller_name")
  callerPhone           String              @map("caller_phone")
  pickupAddress         String              @map("pickup_address")
  pickupLatitude        Float?              @map("pickup_latitude")
  pickupLongitude       Float?              @map("pickup_longitude")
  emergencyType         EmergencyType       @default(MEDICAL) @map("emergency_type")
  severity              EmergencySeverity   @default(MODERATE)
  status                EmergencyStatus     @default(REPORTED)
  sourceFacilityId      String?             @map("source_facility_id")
  destinationFacilityId String?             @map("destination_facility_id")
  requestedAt           DateTime            @default(now()) @map("requested_at")
  dispatchedAt          DateTime?           @map("dispatched_at")
  resolvedAt            DateTime?           @map("resolved_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  dispatches            AmbulanceDispatch[]
  destinationFacility   Facility?           @relation("DestFacilityEmergencies", fields: [destinationFacilityId], references: [id])
  patient               PatientProfile?     @relation(fields: [patientId], references: [id])
  sourceFacility        Facility?           @relation("SourceFacilityEmergencies", fields: [sourceFacilityId], references: [id])
  referrals             HospitalReferral[]

  @@map("emergency_requests")
}

/// Ambulance represents a vehicle within an emergency response fleet.
model Ambulance {
  id                 String              @id @default(uuid())
  vehicleNumber      String              @unique @map("vehicle_number")
  registrationNumber String              @unique @map("registration_number")
  ambulanceType      AmbulanceType       @default(BASIC_LIFE_SUPPORT) @map("ambulance_type")
  status             AmbulanceStatus     @default(AVAILABLE)
  facilityId         String              @map("facility_id")
  currentLatitude    Float?              @map("current_latitude")
  currentLongitude   Float?              @map("current_longitude")
  lastLocationAt     DateTime?           @map("last_location_at")
  equipmentSummary   String?             @map("equipment_summary")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  assignedCrew       String?             @map("assigned_crew")
  driverId           String?             @map("driver_id")
  crews              AmbulanceCrew[]
  dispatches         AmbulanceDispatch[]
  locations          AmbulanceLocation[]
  trips              AmbulanceTrip[]
  driver             User?               @relation("AmbulanceDirectDriver", fields: [driverId], references: [id])
  facility           Facility            @relation(fields: [facilityId], references: [id])
  maintenances       FleetMaintenance[]

  @@map("ambulances")
}

/// AmbulanceCrew links paramedical, nursing and medical crew members to EMS units.
model AmbulanceCrew {
  id             String     @id @default(uuid())
  facilityId     String     @map("facility_id")
  ambulanceId    String?    @map("ambulance_id")
  employeeId     String?    @map("employee_id")
  name           String
  role           CrewRole   @default(PARAMEDIC)
  certifications String?
  status         String     @default("AVAILABLE")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  ambulance      Ambulance? @relation(fields: [ambulanceId], references: [id])
  facility       Facility   @relation(fields: [facilityId], references: [id])

  @@map("ambulance_crews")
}

/// AmbulanceDriverProfile links an emergency driver User to their assigned facility and license.
model AmbulanceDriverProfile {
  id            String              @id @default(uuid())
  userId        String              @unique @map("user_id")
  facilityId    String              @map("facility_id")
  licenseNumber String              @unique @map("license_number")
  licenseExpiry DateTime            @map("license_expiry")
  status        DriverStatus        @default(AVAILABLE)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  dispatches    AmbulanceDispatch[]
  facility      Facility            @relation(fields: [facilityId], references: [id])
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ambulance_driver_profiles")
}

/// AmbulanceDispatch connects an EmergencyRequest with an assigned Ambulance and Driver.
model AmbulanceDispatch {
  id                    String                  @id @default(uuid())
  dispatchNumber        String                  @unique @map("dispatch_number")
  emergencyRequestId    String?                 @map("emergency_request_id")
  ambulanceId           String                  @map("ambulance_id")
  driverId              String?                 @map("driver_id")
  dispatchedBy          String                  @map("dispatched_by")
  status                DispatchStatus          @default(ASSIGNED)
  assignedAt            DateTime                @default(now()) @map("assigned_at")
  acceptedAt            DateTime?               @map("accepted_at")
  completedAt           DateTime?               @map("completed_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  arrivedAtSceneAt      DateTime?               @map("arrived_at_scene_at")
  arrivedHospitalAt     DateTime?               @map("arrived_hospital_at")
  departedSceneAt       DateTime?               @map("departed_scene_at")
  destinationFacilityId String?                 @map("destination_facility_id")
  dispatchedAt          DateTime?               @map("dispatched_at")
  emergencyType         String?                 @map("emergency_type")
  patientName           String?                 @map("patient_name")
  patientPhone          String?                 @map("patient_phone")
  pickupAddress         String?                 @map("pickup_address")
  pickupLatitude        Float?                  @map("pickup_latitude")
  pickupLongitude       Float?                  @map("pickup_longitude")
  priority              DispatchPriority        @default(HIGH)
  ambulance             Ambulance               @relation(fields: [ambulanceId], references: [id])
  destinationFacility   Facility?               @relation("DispatchDestinationFacility", fields: [destinationFacilityId], references: [id])
  dispatcher            User                    @relation(fields: [dispatchedBy], references: [id])
  driver                AmbulanceDriverProfile? @relation(fields: [driverId], references: [id])
  emergencyRequest      EmergencyRequest?       @relation(fields: [emergencyRequestId], references: [id])
  trips                 AmbulanceTrip[]
  xftTransfers          CrossFacilityTransfer[]

  @@map("ambulance_dispatches")
}

/// EmergencyCall logs 911/108/emergency intake calls received by the dispatch center.
model EmergencyCall {
  id               String           @id @default(uuid())
  callNumber       String           @unique @map("call_number")
  facilityId       String           @map("facility_id")
  callerName       String           @map("caller_name")
  callerPhone      String           @map("caller_phone")
  emergencyType    String           @map("emergency_type")
  incidentLocation String           @map("incident_location")
  priority         DispatchPriority @default(HIGH)
  notes            String?
  status           String           @default("RECEIVED")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  facility         Facility         @relation(fields: [facilityId], references: [id])

  @@map("emergency_calls")
}

/// AmbulanceTrip tracks exact transit distance, duration, and clinical transport outcome.
model AmbulanceTrip {
  id              String             @id @default(uuid())
  tripNumber      String             @unique @map("trip_number")
  ambulanceId     String             @map("ambulance_id")
  dispatchId      String?            @map("dispatch_id")
  startTime       DateTime           @default(now()) @map("start_time")
  endTime         DateTime?          @map("end_time")
  distanceKm      Float              @default(0.0) @map("distance_km")
  durationMinutes Float              @default(0.0) @map("duration_minutes")
  outcome         String?            @default("PATIENT_DELIVERED_TO_ER")
  createdAt       DateTime           @default(now()) @map("created_at")
  ambulance       Ambulance          @relation(fields: [ambulanceId], references: [id])
  dispatch        AmbulanceDispatch? @relation(fields: [dispatchId], references: [id])

  @@map("ambulance_trips")
}

/// FleetMaintenance records vehicle servicing, preventative maintenance, and mechanical costs.
model FleetMaintenance {
  id                String    @id @default(uuid())
  maintenanceNumber String    @unique @map("maintenance_number")
  ambulanceId       String    @map("ambulance_id")
  facilityId        String    @map("facility_id")
  maintenanceType   String    @map("maintenance_type")
  scheduledDate     DateTime  @default(now()) @map("scheduled_date")
  completedDate     DateTime? @map("completed_date")
  cost              Float     @default(0.0)
  status            String    @default("SCHEDULED")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  ambulance         Ambulance @relation(fields: [ambulanceId], references: [id])
  facility          Facility  @relation(fields: [facilityId], references: [id])

  @@map("fleet_maintenances")
}

/// AmbulanceLocation records historical GPS location telemetry coordinates.
model AmbulanceLocation {
  id          String    @id @default(uuid())
  ambulanceId String    @map("ambulance_id")
  latitude    Float
  longitude   Float
  recordedAt  DateTime  @default(now()) @map("recorded_at")
  source      String?   @default("GPS_SIMULATED")
  createdAt   DateTime  @default(now()) @map("created_at")
  ambulance   Ambulance @relation(fields: [ambulanceId], references: [id], onDelete: Cascade)

  @@map("ambulance_locations")
}

/// HospitalReferral records inter-hospital referral requests from Source Facility to Destination Facility.
model HospitalReferral {
  id                     String                               @id @default(uuid())
  referralNumber         String                               @unique @map("referral_number")
  patientId              String                               @map("patient_id")
  sourceFacilityId       String                               @map("source_facility_id")
  destinationFacilityId  String                               @map("destination_facility_id")
  referringDoctorId      String                               @map("referring_doctor_id")
  receivingDoctorId      String?                              @map("receiving_doctor_id")
  admissionId            String?                              @map("admission_id")
  encounterId            String?                              @map("encounter_id")
  emergencyRequestId     String?                              @map("emergency_request_id")
  reason                 String
  clinicalSummary        String                               @map("clinical_summary")
  urgency                ReferralUrgency                      @default(ROUTINE)
  status                 ReferralStatus                       @default(DRAFT)
  requestedAt            DateTime                             @default(now()) @map("requested_at")
  acceptedAt             DateTime?                            @map("accepted_at")
  rejectedAt             DateTime?                            @map("rejected_at")
  completedAt            DateTime?                            @map("completed_at")
  createdAt              DateTime                             @default(now()) @map("created_at")
  updatedAt              DateTime                             @updatedAt @map("updated_at")
  bedReservations        BedReservation[]
  crossFacilityTransfers CrossFacilityTransfer[]
  admission              Admission?                           @relation(fields: [admissionId], references: [id])
  destinationFacility    Facility                             @relation("DestFacilityReferrals", fields: [destinationFacilityId], references: [id])
  emergencyRequest       EmergencyRequest?                    @relation(fields: [emergencyRequestId], references: [id])
  encounter              ClinicalEncounter?                   @relation(fields: [encounterId], references: [id])
  patient                PatientProfile                       @relation(fields: [patientId], references: [id])
  receivingDoctor        DoctorProfile?                       @relation("ReceivingDoctor", fields: [receivingDoctorId], references: [id])
  referringDoctor        DoctorProfile                        @relation("ReferringDoctor", fields: [referringDoctorId], references: [id])
  sourceFacility         Facility                             @relation("SourceFacilityReferrals", fields: [sourceFacilityId], references: [id])
  recordAuthorizations   MedicalRecordTransferAuthorization[]

  @@map("hospital_referrals")
}

/// CrossFacilityTransfer records cross-facility patient transfer events between Hospital A and Hospital B.
model CrossFacilityTransfer {
  id                     String                      @id @default(uuid())
  transferNumber         String                      @unique @map("transfer_number")
  referralId             String                      @map("referral_id")
  patientId              String                      @map("patient_id")
  sourceFacilityId       String                      @map("source_facility_id")
  destinationFacilityId  String                      @map("destination_facility_id")
  sourceAdmissionId      String?                     @map("source_admission_id")
  destinationAdmissionId String?                     @map("destination_admission_id")
  sourceBedId            String?                     @map("source_bed_id")
  destinationBedId       String?                     @map("destination_bed_id")
  ambulanceDispatchId    String?                     @map("ambulance_dispatch_id")
  status                 CrossFacilityTransferStatus @default(PLANNED)
  initiatedAt            DateTime                    @default(now()) @map("initiated_at")
  departedAt             DateTime?                   @map("departed_at")
  arrivedAt              DateTime?                   @map("arrived_at")
  completedAt            DateTime?                   @map("completed_at")
  initiatedBy            String                      @map("initiated_by")
  completedBy            String?                     @map("completed_by")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  ambulanceDispatch      AmbulanceDispatch?          @relation(fields: [ambulanceDispatchId], references: [id])
  completer              User?                       @relation("XftCompleter", fields: [completedBy], references: [id])
  destinationAdmission   Admission?                  @relation("DestAdmissionXft", fields: [destinationAdmissionId], references: [id])
  destinationBed         Bed?                        @relation("DestBedXft", fields: [destinationBedId], references: [id])
  destinationFacility    Facility                    @relation("DestFacilityXft", fields: [destinationFacilityId], references: [id])
  initiator              User                        @relation("XftInitiator", fields: [initiatedBy], references: [id])
  patient                PatientProfile              @relation(fields: [patientId], references: [id])
  referral               HospitalReferral            @relation(fields: [referralId], references: [id])
  sourceAdmission        Admission?                  @relation("SourceAdmissionXft", fields: [sourceAdmissionId], references: [id])
  sourceBed              Bed?                        @relation("SourceBedXft", fields: [sourceBedId], references: [id])
  sourceFacility         Facility                    @relation("SourceFacilityXft", fields: [sourceFacilityId], references: [id])

  @@map("cross_facility_transfers")
}

/// MedicalRecordTransferAuthorization records explicit authorizations granted to transfer medical record categories.
model MedicalRecordTransferAuthorization {
  id                    String                    @id @default(uuid())
  referralId            String                    @map("referral_id")
  patientId             String                    @map("patient_id")
  sourceFacilityId      String                    @map("source_facility_id")
  destinationFacilityId String                    @map("destination_facility_id")
  authorizedBy          String                    @map("authorized_by")
  authorizationType     RecordAuthorizationType   @default(ENCOUNTER_SUMMARY) @map("authorization_type")
  status                RecordAuthorizationStatus @default(AUTHORIZED)
  authorizedAt          DateTime                  @default(now()) @map("authorized_at")
  expiresAt             DateTime?                 @map("expires_at")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  authorizer            User                      @relation(fields: [authorizedBy], references: [id])
  destinationFacility   Facility                  @relation("DestFacilityRecordAuth", fields: [destinationFacilityId], references: [id])
  patient               PatientProfile            @relation(fields: [patientId], references: [id])
  referral              HospitalReferral          @relation(fields: [referralId], references: [id], onDelete: Cascade)
  sourceFacility        Facility                  @relation("SourceFacilityRecordAuth", fields: [sourceFacilityId], references: [id])

  @@map("medical_record_transfer_authorizations")
}

/// Role defines Role-Based Access Control permissions.
model Role {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
