  id               String                 @id @default(uuid())
  imagingOrderId   String?                @map("imaging_order_id")
  accessionNumber  String                 @unique @map("accession_number")
  dicomStudyUid    String?                @map("dicom_study_uid")
  imageCount       Int                    @default(1) @map("image_count")
  storageProvider  String                 @default("LOCAL_PACS") @map("storage_provider")
  studyDate        DateTime               @default(now()) @map("study_date")
  uploadedById     String?                @map("uploaded_by_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  modality         ImagingModality        @default(XRAY)
  performedAt      DateTime?              @map("performed_at")
  radiologyOrderId String?                @map("radiology_order_id")
