/// NursingShift tracks nursing staff shift assignments and handover notes.
model NursingShift {
  id            String      @id @default(uuid())
  facilityId    String      @map("facility_id")
  wardId        String?     @map("ward_id")
  nurseId       String      @map("nurse_id")
  shiftType     ShiftType   @map("shift_type")
  startTime     DateTime    @default(now()) @map("start_time")
  endTime       DateTime?   @map("end_time")
  handoverNotes String?     @map("handover_notes")
  status        ShiftStatus @default(ACTIVE)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relations
  facility      Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  ward          Ward?       @relation(fields: [wardId], references: [id], onDelete: SetNull)
  nurse         User        @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@index([facilityId, status])
  @@index([nurseId, startTime])
  @@map("nursing_shifts")
}

/// MedicationAdministration (MAR) tracks inpatient drug administration, doses, and controlled drug witness verification.
model MedicationAdministration {
  id                 String           @id @default(uuid())
  admissionId        String           @map("admission_id")
  patientId          String           @map("patient_id")
  prescriptionItemId String?          @map("prescription_item_id")
  medicationName     String           @map("medication_name")
  isControlled       Boolean          @default(false) @map("is_controlled")
  scheduledTime      DateTime         @map("scheduled_time")
  administeredTime   DateTime?        @map("administered_time")
  administeredById   String           @map("administered_by_id")
  witnessNurseId     String?          @map("witness_nurse_id")
  doseGiven          String           @map("dose_given")
  status             MedicationStatus @default(SCHEDULED)
  notes              String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  // Relations
  admission          Admission        @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  patient            PatientProfile   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  administeredBy     User             @relation("MedAdministeredBy", fields: [administeredById], references: [id], onDelete: Cascade)
  witnessNurse       User?            @relation("MedWitnessNurse", fields: [witnessNurseId], references: [id], onDelete: SetNull)

  @@index([admissionId, scheduledTime])
  @@index([patientId, status])
  @@map("medication_administrations")
}

/// VitalsFlowsheet logs shift-by-shift bedside vital signs and blood glucose readings for inpatients.
model VitalsFlowsheet {
  id               String         @id @default(uuid())
  admissionId      String         @map("admission_id")
  patientId        String         @map("patient_id")
  nurseId          String         @map("nurse_id")
  temperature      Float?
  pulse            Int?
  respiratoryRate  Int?           @map("respiratory_rate")
  oxygenSaturation Int?           @map("oxygen_saturation")
  systolicBP       Int?           @map("systolic_bp")
  diastolicBP      Int?           @map("diastolic_bp")
  bloodGlucose     Float?         @map("blood_glucose")
  painScore        Int?           @map("pain_score")
  notes            String?
  recordedAt       DateTime       @default(now()) @map("recorded_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  // Relations
  admission        Admission      @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nurse            User           @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@index([admissionId, recordedAt])
  @@map("vitals_flowsheets")
}

enum ClearanceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DischargeStatus {
  DRAFT
  PENDING_CLEARANCE
  READY_FOR_DISCHARGE
  DISCHARGED
}

/// DepartmentClearance tracks multi-department approvals required prior to final hospital discharge.
model DepartmentClearance {
  id             String          @id @default(uuid())
  admissionId    String          @map("admission_id")
  facilityId     String          @map("facility_id")
  departmentType String          @map("department_type")
  status         ClearanceStatus @default(PENDING)
  remarks        String?
  approvedById   String?         @map("approved_by_id")
  approvedAt     DateTime?       @map("approved_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  // Relations
  admission      Admission       @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  facility       Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  approvedBy     User?           @relation("ClearanceApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([admissionId, departmentType])
  @@index([facilityId, status])
  @@map("department_clearances")
}

/// DischargeSummary stores clinical discharge summaries, diagnosis, treatments, and follow-up instructions.
model DischargeSummary {
  id                      String          @id @default(uuid())
  admissionId             String          @unique @map("admission_id")
  patientId               String          @map("patient_id")
  facilityId              String          @map("facility_id")
  attendingDoctorId       String          @map("attending_doctor_id")
  chiefComplaint          String          @map("chief_complaint")
  diagnosis               String
  treatmentProvided       String          @map("treatment_provided")
  proceduresPerformed     String?         @map("procedures_performed")
  medicationsOnDischarge  String          @map("medications_on_discharge")
  followUpInstructions    String?         @map("follow_up_instructions")
  dischargeCondition      String?         @map("discharge_condition")
  dischargeDate           DateTime?       @map("discharge_date")
  status                  DischargeStatus @default(DRAFT)
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  // Relations
  admission               Admission       @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  patient                 PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility                Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  attendingDoctor         DoctorProfile   @relation(fields: [attendingDoctorId], references: [id], onDelete: Cascade)

  @@index([facilityId, status])
  @@map("discharge_summaries")
}

enum SessionStatus {
  SCHEDULED
  WAITING
  LIVE
  COMPLETED
  CANCELLED
}

enum ParticipantRole {
  DOCTOR
  PATIENT
}

/// TelemedicineSession models virtual video consultation rooms between doctors and patients.
model TelemedicineSession {
  id                 String                             @id @default(uuid())
  appointmentId      String?                            @unique @map("appointment_id")
  facilityId         String                             @map("facility_id")
  patientId          String                             @map("patient_id")
  doctorId           String                             @map("doctor_id")
  roomName           String                             @unique @map("room_name")
  roomToken          String?                            @map("room_token")
  status             SessionStatus                      @default(SCHEDULED)
  scheduledStartTime DateTime                           @default(now()) @map("scheduled_start_time")
  actualStartTime    DateTime?                          @map("actual_start_time")
  endTime            DateTime?                          @map("end_time")
  durationMinutes    Int?                               @map("duration_minutes")
  notes              String?
  createdAt          DateTime                           @default(now()) @map("created_at")
  updatedAt          DateTime                           @updatedAt @map("updated_at")

  // Relations
  appointment        Appointment?                       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  facility           Facility                           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient            PatientProfile                     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor             DoctorProfile                      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  participants       TelemedicineParticipant[]
  chatMessages       TelemedicineChatMessage[]
  recordings         TelemedicineRecordingMetadata[]

  @@index([facilityId, status])
  @@index([patientId, doctorId])
  @@map("telemedicine_sessions")
}

/// TelemedicineParticipant tracks room joins, role, and exit timestamps.
model TelemedicineParticipant {
  id         String              @id @default(uuid())
  sessionId  String              @map("session_id")
  userId     String              @map("user_id")
  role       ParticipantRole
  joinedAt   DateTime            @default(now()) @map("joined_at")
  leftAt     DateTime?           @map("left_at")
  deviceInfo String?             @map("device_info")

  // Relations
  session    TelemedicineSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, userId])
  @@map("telemedicine_participants")
}

/// TelemedicineChatMessage logs real-time in-consultation messages.
model TelemedicineChatMessage {
  id         String              @id @default(uuid())
  sessionId  String              @map("session_id")
  senderId   String              @map("sender_id")
  senderName String              @map("sender_name")
  senderRole ParticipantRole     @map("sender_role")
  message    String
  sentAt     DateTime            @default(now()) @map("sent_at")

  // Relations
  session    TelemedicineSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender     User                @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([sessionId, sentAt])
  @@map("telemedicine_chat_messages")
}

/// TelemedicineRecordingMetadata logs video session archive metadata.
model TelemedicineRecordingMetadata {
  id              String              @id @default(uuid())
  sessionId       String              @map("session_id")
  fileUrl         String              @map("file_url")
  fileSizeBytes   Int?                @map("file_size_bytes")
  durationSeconds Int?                @map("duration_seconds")
  createdAt       DateTime            @default(now()) @map("created_at")

  // Relations
  session         TelemedicineSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("telemedicine_recording_metadata")
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertType {
  SEPSIS_RISK
  ABNORMAL_VITALS
  DRUG_INTERACTION
  ALLERGY_CONFLICT
  CRITICAL_LAB
  READMISSION_RISK
  FALL_RISK
}

enum PredictionType {
  BED_OCCUPANCY
  OPD_LOAD
  ICU_CAPACITY
  DISCHARGE_FORECAST
  EMERGENCY_SURGE
}

/// ClinicalAlert stores real-time AI safety alerts for inpatients and ED visits.
model ClinicalAlert {
  id           String        @id @default(uuid())
  facilityId   String        @map("facility_id")
  patientId    String        @map("patient_id")
  admissionId  String?       @map("admission_id")
  type         AlertType
  severity     AlertSeverity
  title        String
  description  String
  isResolved   Boolean       @default(false) @map("is_resolved")
  resolvedById String?       @map("resolved_by_id")
  resolvedAt   DateTime?     @map("resolved_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relations
  facility     Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admission    Admission?    @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  resolvedBy   User?         @relation("AlertResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([facilityId, isResolved])
  @@index([patientId, severity])
  @@map("clinical_alerts")
}

/// PatientRiskScore records 0-100 patient risk evaluations for sepsis, readmission, and fall risk.
model PatientRiskScore {
  id              String         @id @default(uuid())
  facilityId      String         @map("facility_id")
  patientId       String         @map("patient_id")
  admissionId     String?        @map("admission_id")
  overallRiskScore Int           @default(10) @map("overall_risk_score")
  sepsisRisk      Int            @default(10) @map("sepsis_risk")
  readmissionRisk Int            @default(15) @map("readmission_risk")
  fallRisk        Int            @default(10) @map("fall_risk")
  riskFactors     String?        @map("risk_factors")
  evaluatedAt     DateTime       @default(now()) @map("evaluated_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  // Relations
  facility        Facility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient         PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admission       Admission?     @relation(fields: [admissionId], references: [id], onDelete: SetNull)

  @@index([facilityId, overallRiskScore])
  @@index([patientId, evaluatedAt])
  @@map("patient_risk_scores")
}

/// HospitalPrediction logs capacity, surge, and occupancy forecasts generated by the AI platform.
model HospitalPrediction {
  id                   String         @id @default(uuid())
  facilityId           String         @map("facility_id")
  type                 PredictionType
  predictedValue       Float          @map("predicted_value")
  unit                 String
  confidencePercentage Int            @default(90) @map("confidence_percentage")
  timeframe            String         @default("NEXT_24_HOURS")
  notes                String?
  predictedForDate     DateTime       @default(now()) @map("predicted_for_date")
  createdAt            DateTime       @default(now()) @map("created_at")

  // Relations
  facility             Facility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, type])
  @@map("hospital_predictions")
}

/// ClinicalRecommendation logs AI recommendations provided to doctors and care teams.
model ClinicalRecommendation {
  id             String         @id @default(uuid())
  facilityId     String         @map("facility_id")
  patientId      String         @map("patient_id")
  admissionId    String?        @map("admission_id")
  category       String
  recommendation String
  rationale      String?
  isAccepted     Boolean        @default(false) @map("is_accepted")
  createdAt      DateTime       @default(now()) @map("created_at")

  // Relations
  facility       Facility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admission      Admission?     @relation(fields: [admissionId], references: [id], onDelete: SetNull)

  @@index([facilityId, patientId])
  @@map("clinical_recommendations")
}

/// AiGeneratedSummary logs AI-generated medical scribe SOAP notes, discharge summaries, and risk analyses.
model AiGeneratedSummary {
  id               String          @id @default(uuid())
  facilityId       String          @map("facility_id")
  doctorId         String          @map("doctor_id")
  patientId        String?         @map("patient_id")
  type             String          @default("SOAP_NOTE") // "SOAP_NOTE" | "DISCHARGE_SUMMARY" | "RISK_ANALYSIS"
  inputData        String          @map("input_data")
  subjective       String?
  objective        String?
  assessment       String?
  plan             String?
  generatedContent String          @map("generated_content")
  status           NoteStatus      @default(DRAFT)
  timeSavedMinutes Int             @default(15) @map("time_saved_minutes")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // Relations
  facility         Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  doctor           DoctorProfile   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient          PatientProfile? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([facilityId, doctorId])
  @@map("ai_generated_summaries")
}

// ==========================================
// RADIOLOGY PACS & IMAGING WORKFLOW MODELS
// ==========================================

enum ImagingOrderStatus {
  ORDERED
  SCHEDULED
  IN_PROCESS
  COMPLETED
  REPORTED
  CANCELLED
}

enum ImagingModality {
  XRAY
  CT
  MRI
  ULTRASOUND
  PET
  MAMMOGRAPHY
  ECG
  ECHO
  OTHER
}

enum FindingSeverity {
  NORMAL
  ABNORMAL
  CRITICAL
}

/// ImagingOrder represents a radiology PACS imaging request placed by a doctor.
model ImagingOrder {
  id                 String             @id @default(uuid())
  facilityId         String             @map("facility_id")
  patientId          String             @map("patient_id")
  admissionId        String?            @map("admission_id")
  doctorId           String             @map("doctor_id")
  modality           ImagingModality    @default(XRAY)
  studyName          String             @map("study_name")
  clinicalIndication String?            @map("clinical_indication")
  status             ImagingOrderStatus @default(ORDERED)
  scheduledAt        DateTime?          @map("scheduled_at")
  completedAt        DateTime?          @map("completed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relations
  facility           Facility           @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient            PatientProfile     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  admission          Admission?         @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  doctor             DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  studies            ImagingStudy[]
  reports            RadiologyReport[]

  @@index([facilityId, patientId])
  @@map("imaging_orders")
}

/// ImagingStudy represents an archived DICOM study linked to an ImagingOrder.
model ImagingStudy {
  id              String       @id @default(uuid())
  imagingOrderId  String       @map("imaging_order_id")
  accessionNumber String       @unique @map("accession_number")
  dicomStudyUid   String       @map("dicom_study_uid")
  imageCount      Int          @default(1) @map("image_count")
  storageProvider String       @default("LOCAL_S3") @map("storage_provider")
  studyDate       DateTime     @default(now()) @map("study_date")
  uploadedById    String       @map("uploaded_by_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  imagingOrder    ImagingOrder @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
  uploadedBy      User         @relation("ImagingStudyUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  files           ImagingFile[]

  @@map("imaging_studies")
}

/// ImagingFile represents an individual DICOM or image payload file within a study.
model ImagingFile {
  id         String       @id @default(uuid())
  studyId    String       @map("study_id")
  fileName   String       @map("file_name")
  fileUrl    String       @map("file_url")
  fileSize   Int          @default(1024) @map("file_size")
  mimeType   String       @default("image/png") @map("mime_type")
  uploadedAt DateTime     @default(now()) @map("uploaded_at")

  // Relations
  study      ImagingStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@map("imaging_files")
}

/// RadiologyReport represents a radiologist's findings, impression, and sign-off.
model RadiologyReport {
  id                  String          @id @default(uuid())
  imagingOrderId      String          @map("imaging_order_id")
  radiologistId       String          @map("radiologist_id")
  findings            String
  impression          String
  recommendation      String?
  severity            FindingSeverity @default(NORMAL)
  aiPrelimFindings    String?         @map("ai_prelim_findings")
  aiAbnormalityScore  Float?          @map("ai_abnormality_score")
  isSigned            Boolean         @default(false) @map("is_signed")
  signedAt            DateTime?       @map("signed_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  // Relations
  imagingOrder        ImagingOrder    @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
  radiologist         DoctorProfile   @relation(fields: [radiologistId], references: [id], onDelete: Restrict)

  @@map("radiology_reports")
}

// ==========================================
// PHARMACY PMS & MEDICATION DISPENSING MODELS
// ==========================================

enum InventoryTransactionType {
  PURCHASE
  DISPENSE
  RETURN
  ADJUSTMENT
  EXPIRED
}

/// MedicationOrder represents a pharmacy order created by a doctor or linked to a prescription.
model MedicationOrder {
  id             String           @id @default(uuid())
  prescriptionId String?          @map("prescription_id")
  patientId      String           @map("patient_id")
  doctorId       String           @map("doctor_id")
  facilityId     String           @map("facility_id")
  status         MedicationStatus @default(PRESCRIBED)
  totalItems     Int              @default(1) @map("total_items")
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relations
  facility       Facility         @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient        PatientProfile   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor         DoctorProfile    @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  items          MedicationItem[]

  @@index([facilityId, patientId])
  @@map("medication_orders")
}

/// MedicationItem represents an individual line item inside a MedicationOrder.
model MedicationItem {
  id                String           @id @default(uuid())
  medicationOrderId String           @map("medication_order_id")
  medicineName      String           @map("medicine_name")
  dosage            String
  frequency         String
  duration          String
  quantity          Int
  dispensedQuantity Int              @default(0) @map("dispensed_quantity")
  status            MedicationStatus @default(PRESCRIBED)
  remarks           String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  // Relations
  medicationOrder   MedicationOrder  @relation(fields: [medicationOrderId], references: [id], onDelete: Cascade)

  @@map("medication_items")
}

/// PharmacyInventory represents a batch-based stock inventory record at a hospital facility.
model PharmacyInventory {
  id            String                 @id @default(uuid())
  facilityId    String                 @map("facility_id")
  medicineName  String                 @map("medicine_name")
  genericName   String?                @map("generic_name")
  batchNumber   String                 @map("batch_number")
  manufacturer  String?
  stockQuantity Int                    @default(0) @map("stock_quantity")
  reorderLevel  Int                    @default(10) @map("reorder_level")
  expiryDate    DateTime               @map("expiry_date")
  purchasePrice Float                  @default(0.0) @map("purchase_price")
  sellingPrice  Float                  @default(0.0) @map("selling_price")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  // Relations
  facility      Facility               @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  transactions  InventoryTransaction[]

  @@index([facilityId, medicineName])
  @@map("pharmacy_inventories")
}

/// InventoryTransaction logs every stock movement (PURCHASE, DISPENSE, ADJUSTMENT, etc.).
model InventoryTransaction {
  id           String                   @id @default(uuid())
  inventoryId  String                   @map("inventory_id")
  type         InventoryTransactionType
  quantity     Int
  performedById String                   @map("performed_by_id")
  remarks      String?
  createdAt    DateTime                 @default(now()) @map("created_at")

  // Relations
  inventory    PharmacyInventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  performedBy  User                     @relation("InventoryTransactionUser", fields: [performedById], references: [id], onDelete: Restrict)

  @@map("inventory_transactions")
}

// ====================================================
// DRUG CATALOG, BATCH INVENTORY, PO, GRN & AUDIT MODELS
// ====================================================

enum DrugCategory {
  ANTIBIOTIC
  ANALGESIC
  ANTIPYRETIC
  CARDIOVASCULAR
  ONCOLOGY
  CONTROLLED_SUBSTANCE
  VACCINE
  DERMATOLOGICAL
  OPHTHALMIC
  OTHER
}

enum BatchStatus {
  ACTIVE
  QUARANTINED
  EXPIRED
  RECALLED
  EXHAUSTED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// DrugMaster records master catalog entries for medications.
model DrugMaster {
  id            String         @id @default(uuid())
  facilityId    String         @map("facility_id")
  code          String
  name          String
  genericName   String?        @map("generic_name")
  strength      String?
  form          String?
  manufacturer  String?
  hsnCode       String?        @map("hsn_code")
  gstPercentage Float          @default(18.0) @map("gst_percentage")
  category      DrugCategory   @default(OTHER)
  unitOfMeasure String         @default("TABLET") @map("unit_of_measure")
  isControlled  Boolean        @default(false) @map("is_controlled")
  reorderLevel  Int            @default(10) @map("reorder_level")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  facility      Facility       @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  batches       DrugBatch[]
  poItems       PurchaseOrderItem[]
  grnItems      GoodsReceiptItem[]
  dispenseItems DispenseLineItem[]
  audits        ControlledSubstanceAudit[]

  @@unique([facilityId, code])
  @@map("drug_masters")
}

/// DrugBatch tracks manufacturing, expiry, cost and price for specific medicine batches.
model DrugBatch {
  id                String       @id @default(uuid())
  drugMasterId      String       @map("drug_master_id")
  batchNumber       String       @map("batch_number")
  manufacturer      String?
  supplier          String?
  manufacturingDate DateTime?    @map("manufacturing_date")
  expiryDate        DateTime     @map("expiry_date")
  unitCost          Float        @default(0.0) @map("unit_cost")
  unitPrice         Float        @default(0.0) @map("unit_price")
  status            BatchStatus  @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  drugMaster        DrugMaster   @relation(fields: [drugMasterId], references: [id], onDelete: Cascade)
  grnItems          GoodsReceiptItem[]
  dispenseItems     DispenseLineItem[]
  audits            ControlledSubstanceAudit[]

  @@map("drug_batches")
}

/// PharmacyDispenseRecord tracks prescription fulfillment records.
model PharmacyDispenseRecord {
  id             String           @id @default(uuid())
  facilityId     String           @map("facility_id")
  prescriptionId String?          @map("prescription_id")
  patientId      String           @map("patient_id")
  dispensedById  String           @map("dispensed_by_id")
  witnessNurseId String?          @map("witness_nurse_id")
  status         DispenseStatus   @default(DISPENSED)
  totalAmount    Float            @default(0.0) @map("total_amount")
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  facility       Facility         @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient        PatientProfile   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  dispensedBy    User             @relation("DispenseUser", fields: [dispensedById], references: [id], onDelete: Restrict)
  witnessNurse   User?            @relation("DispenseWitnessNurse", fields: [witnessNurseId], references: [id], onDelete: SetNull)
  items          DispenseLineItem[]

  @@map("pharmacy_dispense_records")
}

/// DispenseLineItem represents an individual line item dispensed.
model DispenseLineItem {
  id           String                 @id @default(uuid())
  dispenseId   String                 @map("dispense_id")
  drugMasterId String                 @map("drug_master_id")
  drugBatchId  String                 @map("drug_batch_id")
  quantity     Int
  unitPrice    Float                  @default(0.0) @map("unit_price")
  totalPrice   Float                  @default(0.0) @map("total_price")

  dispense     PharmacyDispenseRecord @relation(fields: [dispenseId], references: [id], onDelete: Cascade)
  drugMaster   DrugMaster             @relation(fields: [drugMasterId], references: [id], onDelete: Restrict)
  drugBatch    DrugBatch              @relation(fields: [drugBatchId], references: [id], onDelete: Restrict)

  @@map("dispense_line_items")
}

/// PurchaseOrder tracks supplier procurement orders.
model PurchaseOrder {
  id           String              @id @default(uuid())
  facilityId   String              @map("facility_id")
  poNumber     String              @unique @map("po_number")
  supplierName String              @map("supplier_name")
  status       PurchaseOrderStatus @default(DRAFT)
  totalAmount  Float               @default(0.0) @map("total_amount")
  createdById  String              @map("created_by_id")
  approvedById String?             @map("approved_by_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  facility     Facility            @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  createdBy    User                @relation("POCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?               @relation("POApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items        PurchaseOrderItem[]
  grns         GoodsReceiptNote[]

  @@map("purchase_orders")
}

/// PurchaseOrderItem represents line items inside a PurchaseOrder.
model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String        @map("purchase_order_id")
  drugMasterId     String        @map("drug_master_id")
  quantityOrdered  Int           @map("quantity_ordered")
  quantityReceived Int           @default(0) @map("quantity_received")
  unitPrice        Float         @default(0.0) @map("unit_price")

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  drugMaster       DrugMaster    @relation(fields: [drugMasterId], references: [id], onDelete: Restrict)

  @@map("purchase_order_items")
}

/// GoodsReceiptNote (GRN) logs warehouse inventory receiving against purchase orders.
model GoodsReceiptNote {
  id              String             @id @default(uuid())
  facilityId      String             @map("facility_id")
  grnNumber       String             @unique @map("grn_number")
  purchaseOrderId String             @map("purchase_order_id")
  receivedById    String             @map("received_by_id")
  receivedAt      DateTime           @default(now()) @map("received_at")
  remarks         String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  facility        Facility           @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedBy      User               @relation("GRNReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  items           GoodsReceiptItem[]

  @@map("goods_receipt_notes")
}

/// GoodsReceiptItem logs line items received in a GRN.
model GoodsReceiptItem {
  id               String           @id @default(uuid())
  grnId            String           @map("grn_id")
  drugMasterId     String           @map("drug_master_id")
  drugBatchId      String           @map("drug_batch_id")
  quantityReceived Int              @map("quantity_received")
  unitCost         Float            @default(0.0) @map("unit_cost")

  grn              GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  drugMaster       DrugMaster       @relation(fields: [drugMasterId], references: [id], onDelete: Restrict)
  drugBatch        DrugBatch        @relation(fields: [drugBatchId], references: [id], onDelete: Restrict)

  @@map("goods_receipt_items")
}

/// ControlledSubstanceAudit provides strict audit logs for controlled drugs with dual-nurse witness verification.
model ControlledSubstanceAudit {
  id                 String          @id @default(uuid())
  facilityId         String          @map("facility_id")
  drugMasterId       String          @map("drug_master_id")
  drugBatchId        String          @map("drug_batch_id")
  patientId          String?         @map("patient_id")
  action             String          @default("DISPENSE") // "DISPENSE" | "DISCARD" | "AUDIT_CHECK"
  quantity           Int
  performedById      String          @map("performed_by_id")
  witnessNurseId     String?         @map("witness_nurse_id")
  verificationStatus String          @default("VERIFIED") @map("verification_status")
  remarks            String?
  createdAt          DateTime        @default(now()) @map("created_at")

  facility           Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  drugMaster         DrugMaster      @relation(fields: [drugMasterId], references: [id], onDelete: Restrict)
  drugBatch          DrugBatch       @relation(fields: [drugBatchId], references: [id], onDelete: Restrict)
  patient            PatientProfile? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  performedBy        User            @relation("AuditPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  witnessNurse       User?           @relation("AuditWitnessNurse", fields: [witnessNurseId], references: [id], onDelete: SetNull)

  @@map("controlled_substance_audits")
}

// ====================================================
// OPERATION THEATRE (OT) & SURGERY MANAGEMENT MODELS
// ====================================================

enum SurgeryStatus {
  SCHEDULED
  PRE_OP
  IN_PROGRESS
  RECOVERY
  COMPLETED
  CANCELLED
  POSTPONED
}

enum SurgeryPriority {
  ELECTIVE
  URGENT
  EMERGENCY
}

enum OtRoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

enum AnesthesiaType {
  GENERAL
  SPINAL
  EPIDURAL
  LOCAL
  SEDATION
  COMBINED
  NONE
}

/// OperationTheatre represents an individual OT suite room.
model OperationTheatre {
  id               String            @id @default(uuid())
  facilityId       String            @map("facility_id")
  name             String
  code             String
  status           OtRoomStatus      @default(AVAILABLE)
  equipmentDetails String?           @map("equipment_details")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  facility         Facility          @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  surgeries        SurgerySchedule[]

  @@unique([facilityId, code])
  @@map("operation_theatres")
}

/// SurgerySchedule represents an scheduled or live surgery entry.
model SurgerySchedule {
  id                 String               @id @default(uuid())
  facilityId         String               @map("facility_id")
  otId               String               @map("ot_id")
  patientId          String               @map("patient_id")
  leadSurgeonId      String               @map("lead_surgeon_id")
  anesthetistId      String?              @map("anesthetist_id")
  procedureName      String               @map("procedure_name")
  priority           SurgeryPriority      @default(ELECTIVE)
  status             SurgeryStatus        @default(SCHEDULED)
  scheduledStartTime DateTime             @map("scheduled_start_time")
  scheduledEndTime   DateTime             @map("scheduled_end_time")
  actualStartTime    DateTime?            @map("actual_start_time")
  actualEndTime      DateTime?            @map("actual_end_time")
  notes              String?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  facility           Facility             @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  ot                 OperationTheatre     @relation(fields: [otId], references: [id], onDelete: Restrict)
  patient            PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  leadSurgeon        User                 @relation("LeadSurgeonUser", fields: [leadSurgeonId], references: [id], onDelete: Restrict)
  anesthetist        User?                @relation("AnesthetistUser", fields: [anesthetistId], references: [id], onDelete: SetNull)
  surgicalTeam       SurgicalTeamMember[]
  anesthesiaRecords  AnesthesiaRecord[]
  checklists         SurgicalChecklist[]
  implants           ImplantUsage[]
  surgeryNotes       SurgeryNote[]
  postOpNotes        PostOperativeNote[]

  @@map("surgery_schedules")
}

/// SurgicalTeamMember tracks surgical team assignments (assistant surgeons, scrub nurses, circulating nurses).
model SurgicalTeamMember {
  id        String          @id @default(uuid())
  surgeryId String          @map("surgery_id")
  userId    String          @map("user_id")
  role      String          // "ASSISTANT_SURGEON" | "SCRUB_NURSE" | "CIRCULATING_NURSE"

  surgery   SurgerySchedule @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("surgical_team_members")
}

/// AnesthesiaRecord logs pre-op anesthesia assessment, vitals and complications.
model AnesthesiaRecord {
  id             String          @id @default(uuid())
  surgeryId      String          @map("surgery_id")
  anesthetistId  String          @map("anesthetist_id")
  anesthesiaType AnesthesiaType  @default(GENERAL) @map("anesthesia_type")
  preOpAssessment String?        @map("pre_op_assessment")
  intraOpVitals  String?         @map("intra_op_vitals")
  complications  String?
  createdAt      DateTime        @default(now()) @map("created_at")

  surgery        SurgerySchedule @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  anesthetist    User            @relation("AnesthesiaRecordUser", fields: [anesthetistId], references: [id], onDelete: Restrict)

  @@map("anesthesia_records")
}

/// SurgicalChecklist tracks WHO Surgical Safety Checklist compliance (Sign In, Time Out, Sign Out).
model SurgicalChecklist {
  id               String          @id @default(uuid())
  surgeryId        String          @map("surgery_id")
  signInCompleted  Boolean         @default(false) @map("sign_in_completed")
  timeOutCompleted Boolean         @default(false) @map("time_out_completed")
  signOutCompleted Boolean         @default(false) @map("sign_out_completed")
  completedById    String          @map("completed_by_id")
  completedAt      DateTime        @default(now()) @map("completed_at")

  surgery          SurgerySchedule @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  completedBy      User            @relation("ChecklistUser", fields: [completedById], references: [id], onDelete: Restrict)

  @@map("surgical_checklists")
}

/// ImplantUsage records prosthetics, implants, and high-value surgical items.
model ImplantUsage {
  id           String          @id @default(uuid())
  surgeryId    String          @map("surgery_id")
  implantName  String          @map("implant_name")
  serialNumber String?         @map("serial_number")
  manufacturer String?
  quantity     Int             @default(1)
  cost         Float           @default(0.0)

  surgery      SurgerySchedule @relation(fields: [surgeryId], references: [id], onDelete: Cascade)

  @@map("implant_usages")
}

/// SurgeryNote records intra-operative surgical findings and procedure descriptions.
model SurgeryNote {
  id                   String          @id @default(uuid())
  surgeryId            String          @map("surgery_id")
  authorId             String          @map("author_id")
  preOpDiagnosis       String?         @map("pre_op_diagnosis")
  postOpDiagnosis      String?         @map("post_op_diagnosis")
  procedureDescription String          @map("procedure_description")
  findings             String?
  createdAt            DateTime        @default(now()) @map("created_at")

  surgery              SurgerySchedule @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  author               User            @relation("SurgeryNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@map("surgery_notes")
}

/// PostOperativeNote logs PACU recovery status and post-op care instructions.
model PostOperativeNote {
  id                   String          @id @default(uuid())
  surgeryId            String          @map("surgery_id")
  authorId             String          @map("author_id")
  pacuStatus           String          @default("STABLE") @map("pacu_status")
  recoveryInstructions String          @map("recovery_instructions")
  createdAt            DateTime        @default(now()) @map("created_at")

  surgery              SurgerySchedule @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  author               User            @relation("PostOpNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@map("post_operative_notes")
}

// ====================================================
// REVENUE CYCLE MANAGEMENT (RCM), BILLING & CLAIMS
// ====================================================

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  VOID
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
}

/// BillingInvoice represents a comprehensive hospital bill/invoice.
model BillingInvoice {
  id             String               @id @default(uuid())
  invoiceNumber  String               @unique @map("invoice_number")
  patientId      String               @map("patient_id")
  admissionId    String?              @map("admission_id")
  encounterId    String?              @map("encounter_id")
  facilityId     String               @map("facility_id")
  invoiceDate    DateTime             @default(now()) @map("invoice_date")
  subtotal       Float                @default(0.0)
  taxAmount      Float                @default(0.0) @map("tax_amount")
  discountAmount Float                @default(0.0) @map("discount_amount")
  totalAmount    Float                @default(0.0) @map("total_amount")
  amountPaid     Float                @default(0.0) @map("amount_paid")
  balanceDue     Float                @default(0.0) @map("balance_due")
  paymentStatus  PaymentStatus        @default(PENDING) @map("payment_status")
  invoiceStatus  InvoiceStatus        @default(DRAFT) @map("invoice_status")
  notes          String?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  facility       Facility             @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient        PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  admission      Admission?           @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  encounter      ClinicalEncounter?   @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  items          BillingLineItem[]
  payments       PaymentTransaction[]
  claims         InsuranceClaim[]

  @@map("billing_invoices")
}

/// BillingLineItem represents individual itemized charges on a billing invoice.
model BillingLineItem {
  id              String         @id @default(uuid())
  invoiceId       String         @map("invoice_id")
  itemType        String         @map("item_type") // LAB, PHARMACY, OPD, IPD, TELEMEDICINE, SURGERY, OTHER
  itemName        String         @map("item_name")
  quantity        Int            @default(1)
  unitPrice       Float          @default(0.0) @map("unit_price")
  taxPercent      Float          @default(18.0) @map("tax_percent")
  discountPercent Float          @default(0.0) @map("discount_percent")
  totalPrice      Float          @default(0.0) @map("total_price")

  invoice         BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("billing_line_items")
}

/// PaymentTransaction records partial or full payment receipts for invoices.
model PaymentTransaction {
  id                   String         @id @default(uuid())
  invoiceId            String         @map("invoice_id")
  paymentMethod        String         @map("payment_method") // CASH, CARD, UPI, NET_BANKING, INSURANCE, CHEQUE
  transactionReference String?        @map("transaction_reference")
  amount               Float
  paymentDate          DateTime       @default(now()) @map("payment_date")
  collectedById        String         @map("collected_by_id")
  createdAt            DateTime       @default(now()) @map("created_at")

  invoice              BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  collectedBy          User           @relation("PaymentCollector", fields: [collectedById], references: [id], onDelete: Restrict)

  @@map("payment_transactions")
}

/// InsuranceProvider represents third-party payors, health insurers and TPAs.
model InsuranceProvider {
  id                     String           @id @default(uuid())
  providerName           String           @map("provider_name")
  contactDetails         String?          @map("contact_details")
  claimEmail             String?          @map("claim_email")
  policyValidationRules  String?          @map("policy_validation_rules")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  claims                 InsuranceClaim[]

  @@map("insurance_providers")
}

/// InsuranceClaim manages insurance claim processing, pre-auths, and reimbursement settlements.
model InsuranceClaim {
  id              String            @id @default(uuid())
  claimNumber     String            @unique @map("claim_number")
  invoiceId       String            @map("invoice_id")
  providerId      String            @map("provider_id")
  patientId       String            @map("patient_id")
  claimAmount     Float             @map("claim_amount")
  approvedAmount  Float             @default(0.0) @map("approved_amount")
  rejectedAmount  Float             @default(0.0) @map("rejected_amount")
  claimStatus     ClaimStatus       @default(DRAFT) @map("claim_status")
  submissionDate  DateTime?         @map("submission_date")
  approvalDate    DateTime?         @map("approval_date")
  remarks         String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  invoice         BillingInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  provider        InsuranceProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  patient         PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@map("insurance_claims")
}

// ====================================================
// HRMS, WORKFORCE MANAGEMENT & PAYROLL ENGINE
// ====================================================

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  COMPLETED
}

/// Employee represents a hospital staff member, doctor, nurse, or administrative employee.
model Employee {
  id                 String             @id @default(uuid())
  facilityId         String             @map("facility_id")
  userId             String?            @unique @map("user_id")
  employeeCode       String             @unique @map("employee_code")
  fullName           String             @map("full_name")
  departmentId       String             @map("department_id")
  designation        String
  joiningDate        DateTime           @default(now()) @map("joining_date")
  employmentType     EmploymentType     @default(FULL_TIME) @map("employment_type")
  reportingManagerId String?            @map("reporting_manager_id")
  status             String             @default("ACTIVE")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  facility           Facility           @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  department         Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  salaryStructure    SalaryStructure?
  attendanceRecords  AttendanceRecord[]
  shifts             ShiftAssignment[]
  leaveRequests      LeaveRequest[]
  payslips           Payslip[]

  @@map("employees")
}

/// AttendanceRecord tracks daily biometric or manual clock-in/clock-out events.
model AttendanceRecord {
  id               String           @id @default(uuid())
  employeeId       String           @map("employee_id")
  facilityId       String           @map("facility_id")
  checkInTime      DateTime         @default(now()) @map("check_in_time")
  checkOutTime     DateTime?        @map("check_out_time")
  totalHours       Float            @default(0.0) @map("total_hours")
  attendanceStatus AttendanceStatus @default(PRESENT) @map("attendance_status")
  createdAt        DateTime         @default(now()) @map("created_at")

  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  facility         Facility         @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@map("attendance_records")
}

/// ShiftAssignment allocates staff shifts across clinical and operational departments.
model ShiftAssignment {
  id           String     @id @default(uuid())
  employeeId   String     @map("employee_id")
  departmentId String     @map("department_id")
  shiftType    String     @map("shift_type") // MORNING, EVENING, NIGHT, ROTATIONAL
  startTime    DateTime   @map("start_time")
  endTime      DateTime   @map("end_time")
  assignedById String     @map("assigned_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assignedBy   User       @relation("ShiftAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@map("shift_assignments")
}

/// LeaveRequest handles employee time-off and medical leave applications.
model LeaveRequest {
  id             String         @id @default(uuid())
  employeeId     String         @map("employee_id")
  leaveType      String         @map("leave_type") // CASUAL, SICK, EARNED, MATERNITY
  startDate      DateTime       @map("start_date")
  endDate        DateTime       @map("end_date")
  reason         String
  approvalStatus ApprovalStatus @default(PENDING) @map("approval_status")
  approvedById   String?        @map("approved_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy     User?          @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("leave_requests")
}

/// SalaryStructure defines compensation, basic salary, allowances, and statutory deductions.
model SalaryStructure {
  id              String   @id @default(uuid())
  employeeId      String   @unique @map("employee_id")
  basicSalary     Float    @default(0.0) @map("basic_salary")
  hra             Float    @default(0.0)
  allowances      Float    @default(0.0)
  deductions      Float    @default(0.0)
  pfContribution  Float    @default(0.0) @map("pf_contribution")
  esiContribution Float    @default(0.0) @map("esi_contribution")
  netSalary       Float    @default(0.0) @map("net_salary")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("salary_structures")
}

/// PayrollRun manages monthly facility-wide payroll disbursement cycles.
model PayrollRun {
  id                 String        @id @default(uuid())
  payrollMonth       String        @map("payroll_month") // e.g. "2026-08"
  facilityId         String        @map("facility_id")
  totalEmployees     Int           @default(0) @map("total_employees")
  totalPayrollAmount Float         @default(0.0) @map("total_payroll_amount")
  status             PayrollStatus @default(DRAFT)
  generatedById      String        @map("generated_by_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  facility           Facility      @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  generatedBy        User          @relation("PayrollGenerator", fields: [generatedById], references: [id], onDelete: Restrict)
  payslips           Payslip[]

  @@map("payroll_runs")
}

/// Payslip itemizes individual employee compensation and tax deductions for a payroll run.
model Payslip {
  id           String     @id @default(uuid())
  payrollRunId String     @map("payroll_run_id")
  employeeId   String     @map("employee_id")
  grossSalary  Float      @default(0.0) @map("gross_salary")
  deductions   Float      @default(0.0)
  netSalary    Float      @default(0.0) @map("net_salary")
  pdfUrl       String?    @map("pdf_url")
  createdAt    DateTime   @default(now()) @map("created_at")

  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@map("payslips")
}

// ====================================================
// INVENTORY, PROCUREMENT & ASSET MANAGEMENT SYSTEM
// ====================================================

enum InventoryStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

enum ProcurementPOStatus {
  DRAFT
  APPROVED
  ORDERED
  RECEIVED
  CANCELLED
}

enum AssetStatus {
  ACTIVE
  UNDER_MAINTENANCE
  RETIRED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// InventoryItem manages non-pharmacy hospital supplies, consumables, and surgical equipment.
model InventoryItem {
  id             String                       @id @default(uuid())
  itemCode       String                       @unique @map("item_code")
  itemName       String                       @map("item_name")
  category       String
  unitOfMeasure  String                       @default("UNIT") @map("unit_of_measure")
  currentStock   Int                          @default(0) @map("current_stock")
  minimumStock   Int                          @default(10) @map("minimum_stock")
  reorderLevel   Int                          @default(20) @map("reorder_level")
  unitPrice      Float                        @default(0.0) @map("unit_price")
  location       String?
  facilityId     String                       @map("facility_id")
  status         InventoryStatus              @default(ACTIVE)
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")

  facility       Facility                     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  transactions   HospitalInventoryTransaction[]

  @@map("inventory_items")
}

/// HospitalInventoryTransaction logs every stock-in, stock-out, transfer, and adjustment.
model HospitalInventoryTransaction {
  id              String          @id @default(uuid())
  itemId          String          @map("item_id")
  transactionType TransactionType @map("transaction_type")
  quantity        Int
  previousStock   Int             @map("previous_stock")
  newStock        Int             @map("new_stock")
  performedById   String          @map("performed_by_id")
  remarks         String?
  createdAt       DateTime        @default(now()) @map("created_at")

  item            InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  performedBy     User            @relation("InventoryPerformer", fields: [performedById], references: [id], onDelete: Restrict)

  @@map("hospital_inventory_transactions")
}

/// Vendor represents medical supply, equipment, and consumable vendors.
model Vendor {
  id             String                  @id @default(uuid())
  vendorCode     String                  @unique @map("vendor_code")
  companyName    String                  @map("company_name")
  contactPerson  String?                 @map("contact_person")
  email          String?
  phone          String?
  gstNumber      String?                 @map("gst_number")
  address        String?
  status         String                  @default("ACTIVE")
  rating         Float                   @default(4.8)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  purchaseOrders HospitalProcurementPO[]

  @@map("supply_vendors")
}

/// PurchaseRequisition captures departmental supply requests requiring approval.
model PurchaseRequisition {
  id                String                  @id @default(uuid())
  requisitionNumber String                  @unique @map("requisition_number")
  departmentId      String                  @map("department_id")
  facilityId        String                  @map("facility_id")
  requestedById     String                  @map("requested_by_id")
  approvalStatus    ApprovalStatus          @default(PENDING) @map("approval_status")
  totalAmount       Float                   @default(0.0) @map("total_amount")
  items             String?
  approvedById      String?                 @map("approved_by_id")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  department        Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  facility          Facility                @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  requestedBy       User                    @relation("RequisitionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy        User?                   @relation("RequisitionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  purchaseOrders    HospitalProcurementPO[]

  @@map("purchase_requisitions")
}

/// HospitalProcurementPO tracks vendor purchase orders for hospital goods and supplies.
model HospitalProcurementPO {
  id                   String                 @id @default(uuid())
  poNumber             String                 @unique @map("po_number")
  vendorId             String                 @map("vendor_id")
  requisitionId        String?                @map("requisition_id")
  facilityId           String                 @map("facility_id")
  orderDate            DateTime               @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?              @map("expected_delivery_date")
  status               ProcurementPOStatus    @default(DRAFT)
  totalAmount          Float                  @default(0.0) @map("total_amount")
  createdById          String                 @map("created_by_id")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  vendor               Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  requisition          PurchaseRequisition?   @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  facility             Facility               @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  createdBy            User                   @relation("ProcurementPOCreator", fields: [createdById], references: [id], onDelete: Restrict)
  goodsReceipts        HospitalGoodsReceipt[]

  @@map("procurement_purchase_orders")
}

/// HospitalGoodsReceipt verifies and accepts vendor shipments into stock.
model HospitalGoodsReceipt {
  id              String                @id @default(uuid())
  receiptNumber   String                @unique @map("receipt_number")
  purchaseOrderId String                @map("purchase_order_id")
  receivedById    String                @map("received_by_id")
  receivedDate    DateTime              @default(now()) @map("received_date")
  status          String                @default("RECEIVED")
  remarks         String?
  createdAt       DateTime              @default(now()) @map("created_at")

  purchaseOrder   HospitalProcurementPO @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedBy      User                  @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id], onDelete: Restrict)

  @@map("hospital_goods_receipts")
}

/// HospitalAsset tracks biomedical equipment, ventilators, imaging scanners, and surgical assets.
model HospitalAsset {
  id                   String              @id @default(uuid())
  assetCode            String              @unique @map("asset_code")
  assetName            String              @map("asset_name")
  category             String
  facilityId           String              @map("facility_id")
  departmentId         String?             @map("department_id")
  purchaseDate         DateTime            @default(now()) @map("purchase_date")
  warrantyExpiry       DateTime            @map("warranty_expiry")
  maintenanceFrequency String              @default("QUARTERLY") @map("maintenance_frequency")
  currentLocation      String              @map("current_location")
  status               AssetStatus         @default(ACTIVE)
  purchaseCost         Float               @default(0.0) @map("purchase_cost")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  facility             Facility            @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  department           Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tickets              MaintenanceTicket[]

  @@map("hospital_assets")
}

/// MaintenanceTicket tracks corrective and preventive engineering tickets on biomedical assets.
model MaintenanceTicket {
  id               String              @id @default(uuid())
  ticketNumber     String              @unique @map("ticket_number")
  assetId          String              @map("asset_id")
  issueDescription String              @map("issue_description")
  priority         MaintenancePriority @default(MEDIUM)
  assignedTo       String?             @map("assigned_to")
  status           String              @default("OPEN")
  resolutionNotes  String?             @map("resolution_notes")
  reportedById     String              @map("reported_by_id")
  resolvedAt       DateTime?           @map("resolved_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  asset            HospitalAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reportedBy       User                @relation("TicketReporter", fields: [reportedById], references: [id], onDelete: Restrict)

  @@map("maintenance_tickets")
}

// ====================================================
// EXECUTIVE BI, KPI ANALYTICS & HOSPITAL COMMAND CENTER
// ====================================================

enum AlertCategory {
  FINANCIAL
  CLINICAL
  OPERATIONAL
  COMPLIANCE
  SECURITY
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// KpiSnapshot captures periodic operational, financial, and clinical KPIs for C-level dashboards.
model KpiSnapshot {
  id                   String   @id @default(uuid())
  facilityId           String   @map("facility_id")
  snapshotDate         DateTime @default(now()) @map("snapshot_date")
  revenueToday         Float    @default(0.0) @map("revenue_today")
  revenueMonth         Float    @default(0.0) @map("revenue_month")
  opdPatients          Int      @default(0) @map("opd_patients")
  ipdPatients          Int      @default(0) @map("ipd_patients")
  occupancyRate        Float    @default(0.0) @map("occupancy_rate")
  bedUtilization       Float    @default(0.0) @map("bed_utilization")
  averageLos           Float    @default(0.0) @map("average_los")
  patientSatisfaction  Float    @default(98.5) @map("patient_satisfaction")
  emergencyCases       Int      @default(0) @map("emergency_cases")
  labOrders            Int      @default(0) @map("lab_orders")
  pharmacySales        Float    @default(0.0) @map("pharmacy_sales")
  telemedicineSessions Int      @default(0) @map("telemedicine_sessions")
  createdAt            DateTime @default(now()) @map("created_at")

  facility             Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@map("kpi_snapshots")
}

/// DashboardWidget configures customizable C-suite command wall widgets.
model DashboardWidget {
  id         String   @id @default(uuid())
  facilityId String   @map("facility_id")
  widgetName String   @map("widget_name")
  widgetType String   @map("widget_type")
  position   Int      @default(0)
  isEnabled  Boolean  @default(true) @map("is_enabled")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@map("dashboard_widgets")
}

/// ExecutiveAlert captures critical cross-departmental warnings for the executive board.
model ExecutiveAlert {
  id               String        @id @default(uuid())
  facilityId       String        @map("facility_id")
  title            String
  description      String
  severity         AlertSeverity @default(HIGH)
  category         AlertCategory @default(OPERATIONAL)
  status           AlertStatus   @default(OPEN)
  acknowledgedById String?       @map("acknowledged_by_id")
  acknowledgedAt   DateTime?     @map("acknowledged_at")
  resolvedById     String?       @map("resolved_by_id")
  resolvedAt       DateTime?     @map("resolved_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  facility         Facility      @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  acknowledgedBy   User?         @relation("AlertAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedBy       User?         @relation("AlertResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@map("executive_alerts")
}

// ====================================================
// INFECTION CONTROL, HOSPITAL QUALITY & PATIENT SAFETY
// ====================================================

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  SENTINEL
}

enum IncidentStatus {
  OPEN
  UNDER_INVESTIGATION
  CLOSED
}

enum InfectionSeverity {
  MILD
  MODERATE
  SEVERE
  CRITICAL
}

enum AuditStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum CAPAStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

/// InfectionCase tracks healthcare-associated infections (HAIs), surveillance, and outbreak control.
model InfectionCase {
  id              String                   @id @default(uuid())
  caseNumber      String                   @unique @map("case_number")
  patientId       String                   @map("patient_id")
  admissionId     String?                  @map("admission_id")
  facilityId      String                   @map("facility_id")
  infectionType   String                   @map("infection_type")
  infectionSource String                   @default("HOSPITAL_ACQUIRED") @map("infection_source")
  detectionDate   DateTime                 @default(now()) @map("detection_date")
  severity        InfectionSeverity        @default(MODERATE)
  status          String                   @default("OPEN")
  reportedById    String                   @map("reported_by_id")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  patient         PatientProfile           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  admission       Admission?               @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  facility        Facility                 @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  reportedBy      User                     @relation("InfectionReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  investigations  InfectionInvestigation[]

  @@map("infection_cases")
}

/// InfectionInvestigation captures root cause analysis (RCA) and preventive actions for infections.
model InfectionInvestigation {
  id                String        @id @default(uuid())
  infectionCaseId   String        @map("infection_case_id")
  rootCauseAnalysis String        @map("root_cause_analysis")
  correctiveAction  String        @map("corrective_action")
  preventiveAction  String        @map("preventive_action")
  assignedToId      String        @map("assigned_to_id")
  dueDate           DateTime      @map("due_date")
  status            String        @default("IN_PROGRESS")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  infectionCase     InfectionCase @relation(fields: [infectionCaseId], references: [id], onDelete: Cascade)
  assignedTo        User          @relation("InfectionInvestigator", fields: [assignedToId], references: [id], onDelete: Restrict)

  @@map("infection_investigations")
}

/// IncidentReport logs clinical adverse events, near-misses, and sentinel occurrences.
model IncidentReport {
  id             String           @id @default(uuid())
  incidentNumber String           @unique @map("incident_number")
  facilityId     String           @map("facility_id")
  patientId      String?          @map("patient_id")
  reportedById   String           @map("reported_by_id")
  incidentType   String           @map("incident_type")
  severity       IncidentSeverity @default(MEDIUM)
  description    String
  incidentDate   DateTime         @default(now()) @map("incident_date")
  status         IncidentStatus   @default(OPEN)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  facility       Facility         @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient        PatientProfile?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  reportedBy     User             @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  capas          CAPARecord[]

  @@map("incident_reports")
}

/// QualityAudit tracks clinical quality, NABH/JCI compliance, and nursing clinical governance.
model QualityAudit {
  id              String       @id @default(uuid())
  auditNumber     String       @unique @map("audit_number")
  facilityId      String       @map("facility_id")
  auditName       String       @map("audit_name")
  departmentId    String       @map("department_id")
  auditorId       String       @map("auditor_id")
  auditDate       DateTime     @default(now()) @map("audit_date")
  score           Float        @default(95.0)
  findings        String
  recommendations String?
  status          AuditStatus  @default(COMPLETED)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  facility        Facility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  department      Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  auditor         User         @relation("QualityAuditor", fields: [auditorId], references: [id], onDelete: Restrict)
  capas           CAPARecord[]

  @@map("quality_audits")
}

/// CAPARecord manages Corrective and Preventive Actions across audit findings and incidents.
model CAPARecord {
  id               String          @id @default(uuid())
  capaNumber       String          @unique @map("capa_number")
  facilityId       String          @map("facility_id")
  auditId          String?         @map("audit_id")
  incidentId       String?         @map("incident_id")
  correctiveAction String          @map("corrective_action")
  preventiveAction String          @map("preventive_action")
  ownerId          String          @map("owner_id")
  dueDate          DateTime        @map("due_date")
  status           CAPAStatus      @default(OPEN)
  completedAt      DateTime?       @map("completed_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  facility         Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  audit            QualityAudit?   @relation(fields: [auditId], references: [id], onDelete: SetNull)
  incident         IncidentReport? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  owner            User            @relation("CAPAOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@map("capa_records")
}

/// HandHygieneAudit measures WHO 5-Moments hand hygiene compliance across departments.
model HandHygieneAudit {
  id                   String     @id @default(uuid())
  facilityId           String     @map("facility_id")
  departmentId         String     @map("department_id")
  observerId           String     @map("observer_id")
  compliancePercentage Float      @default(96.5) @map("compliance_percentage")
  observationDate      DateTime   @default(now()) @map("observation_date")
  createdAt            DateTime   @default(now()) @map("created_at")

  facility             Facility   @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  department           Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  observer             User       @relation("HandHygieneObserver", fields: [observerId], references: [id], onDelete: Restrict)

  @@map("hand_hygiene_audits")
}

/// SafetyChecklist tracks clinical safety checklists (Pre-Op, Fall Risk, Central Line, Transfusion).
model SafetyChecklist {
  id             String          @id @default(uuid())
  facilityId     String          @map("facility_id")
  patientId      String          @map("patient_id")
  admissionId    String?         @map("admission_id")
  checklistType  String          @map("checklist_type")
  completedById  String          @map("completed_by_id")
  completionDate DateTime        @default(now()) @map("completion_date")
  status         String          @default("COMPLIANT")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")

  facility       Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient        PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  admission      Admission?      @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  completedBy    User            @relation("SafetyChecklistCompleter", fields: [completedById], references: [id], onDelete: Restrict)

  @@map("safety_checklists")
}


