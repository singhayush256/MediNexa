  @@map("otp_verifications")
}

/// FileAttachment stores metadata for uploaded diagnostic images and medical records.
model FileAttachment {
  id           String             @id @default(uuid())
  fileName     String             @map("file_name")
  mimeType     String             @map("mime_type")
  fileSize     Int                @map("file_size")
  storageKey   String             @unique @map("storage_key")
  publicUrl    String?            @map("public_url")
  checksum     String?
  category     AttachmentCategory @default(GENERAL_DOCUMENT)
  patientId    String             @map("patient_id")
  facilityId   String             @map("facility_id")
  uploadedById String             @map("uploaded_by_id")
  encounterId  String?            @map("encounter_id")
  admissionId  String?            @map("admission_id")
  createdAt    DateTime           @default(now()) @map("created_at")
