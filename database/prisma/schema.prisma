  contextId      String?  @map("context_id")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_interaction_audits")
}

/// AuditEvent logs system security and administrative actions.
model AuditEvent {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  role       String?
  facilityId String?  @map("facility_id")
  action     String
  resource   String
  details    String?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_events")
}

/// GuestPatient stores demographics for unauthenticated patient bookings.
model GuestPatient {
  id        String         @id @default(uuid())
  name      String
  phone     String         @unique
  email     String?
  age       Int?
  gender    String?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
