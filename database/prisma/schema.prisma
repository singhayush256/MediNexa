  seriesUid         String       @map("series_uid")
  seriesDescription String?      @map("series_description")
  imageCount        Int          @default(1) @map("image_count")
  storageLocation   String?      @map("storage_location")
  thumbnailUrl      String?      @map("thumbnail_url")
  createdAt         DateTime     @default(now()) @map("created_at")
  study             ImagingStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
  @@map("dicom_series")
}

/// ImagingFile represents an individual DICOM or image payload file within a study.
model ImagingFile {
  id         String       @id @default(uuid())
  studyId    String       @map("study_id")
  fileName   String       @map("file_name")
  fileUrl    String       @map("file_url")
  fileSize   Int          @default(1024) @map("file_size")
  mimeType   String       @default("image/png") @map("mime_type")
  uploadedAt DateTime     @default(now()) @map("uploaded_at")
  study      ImagingStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@map("imaging_files")
}

/// RadiologyReport represents a radiologist's findings, impression, and sign-off.
model RadiologyReport {
  id                 String                 @id @default(uuid())
  imagingOrderId     String?                @map("imaging_order_id")
  radiologistId      String?                @map("radiologist_id")
  findings           String
  impression         String
  recommendation     String?
  severity           FindingSeverity        @default(NORMAL)
  aiPrelimFindings   String?                @map("ai_prelim_findings")
  aiAbnormalityScore Float?                 @map("ai_abnormality_score")
  isSigned           Boolean                @default(false) @map("is_signed")
  signedAt           DateTime?              @map("signed_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  radiologistUserId  String?                @map("radiologist_user_id")
  studyId            String?                @map("study_id")
  verified           Boolean                @default(false)
  verifiedAt         DateTime?              @map("verified_at")
  criticalAlerts     CriticalFindingAlert[]
  imagingOrder       ImagingOrder?          @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
  radiologist        DoctorProfile?         @relation(fields: [radiologistId], references: [id])
  radiologistUser    User?                  @relation("RadiologistUserReports", fields: [radiologistUserId], references: [id])
  study              ImagingStudy?          @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
  @@map("radiology_reports")
}

/// CriticalFindingAlert generates high-priority physician notifications and EHR safety flags for emergent findings.
model CriticalFindingAlert {
  id               String           @id @default(uuid())
  patientId        String           @map("patient_id")
  studyId          String?          @map("study_id")
  reportId         String?          @map("report_id")
  severity         FindingSeverity  @default(CRITICAL)
  alertMessage     String           @map("alert_message")
  acknowledged     Boolean          @default(false)
  acknowledgedById String?          @map("acknowledged_by_id")
  acknowledgedAt   DateTime?        @map("acknowledged_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  acknowledgedBy   User?            @relation("CriticalFindingAcknowledger", fields: [acknowledgedById], references: [id])
  patient          PatientProfile   @relation(fields: [patientId], references: [id])
  report           RadiologyReport? @relation(fields: [reportId], references: [id])
  study            ImagingStudy?    @relation(fields: [studyId], references: [id])

  @@index([patientId, acknowledged])
  @@map("critical_finding_alerts")
}

/// MedicationOrder represents a pharmacy order created by a doctor or linked to a prescription.
model MedicationOrder {
  id             String           @id @default(uuid())
  prescriptionId String?          @map("prescription_id")
  patientId      String           @map("patient_id")
  doctorId       String           @map("doctor_id")
  facilityId     String           @map("facility_id")
  status         MedicationStatus @default(PRESCRIBED)
  totalItems     Int              @default(1) @map("total_items")
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  items          MedicationItem[]
  doctor         DoctorProfile    @relation(fields: [doctorId], references: [id])
  facility       Facility         @relation(fields: [facilityId], references: [id])
  patient        PatientProfile   @relation(fields: [patientId], references: [id])

  @@index([facilityId, patientId])
  @@map("medication_orders")
}

/// MedicationItem represents an individual line item inside a MedicationOrder.
model MedicationItem {
  id                String           @id @default(uuid())
  medicationOrderId String           @map("medication_order_id")
  medicineName      String           @map("medicine_name")
  dosage            String
  frequency         String
  duration          String
  quantity          Int
  dispensedQuantity Int              @default(0) @map("dispensed_quantity")
  status            MedicationStatus @default(PRESCRIBED)
  remarks           String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  medicationOrder   MedicationOrder  @relation(fields: [medicationOrderId], references: [id], onDelete: Cascade)

  @@map("medication_items")
}

/// PharmacyInventory represents a batch-based stock inventory record at a hospital facility.
model PharmacyInventory {
  id            String                 @id @default(uuid())
  facilityId    String                 @map("facility_id")
  medicineName  String                 @map("medicine_name")
  genericName   String?                @map("generic_name")
  batchNumber   String                 @map("batch_number")
  manufacturer  String?
  stockQuantity Int                    @default(0) @map("stock_quantity")
  reorderLevel  Int                    @default(10) @map("reorder_level")
  expiryDate    DateTime               @map("expiry_date")
  purchasePrice Float                  @default(0.0) @map("purchase_price")
  sellingPrice  Float                  @default(0.0) @map("selling_price")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  transactions  InventoryTransaction[]
  facility      Facility               @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, medicineName])
  @@map("pharmacy_inventories")
}

/// InventoryTransaction logs every stock movement (PURCHASE, DISPENSE, ADJUSTMENT, etc.).
model InventoryTransaction {
  id            String                   @id @default(uuid())
  inventoryId   String                   @map("inventory_id")
  type          InventoryTransactionType
  quantity      Int
  performedById String                   @map("performed_by_id")
  remarks       String?
  createdAt     DateTime                 @default(now()) @map("created_at")
  inventory     PharmacyInventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  performedBy   User                     @relation("InventoryTransactionUser", fields: [performedById], references: [id])

  @@map("inventory_transactions")
}

/// DrugMaster records master catalog entries for medications.
model DrugMaster {
  id            String                     @id @default(uuid())
  facilityId    String                     @map("facility_id")
  code          String
  name          String
  genericName   String?                    @map("generic_name")
  category      DrugCategory               @default(OTHER)
  unitOfMeasure String                     @default("TABLET") @map("unit_of_measure")
  isControlled  Boolean                    @default(false) @map("is_controlled")
  reorderLevel  Int                        @default(10) @map("reorder_level")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  form          String?
  gstPercentage Float                      @default(18.0) @map("gst_percentage")
  hsnCode       String?                    @map("hsn_code")
  manufacturer  String?
  strength      String?
  audits        ControlledSubstanceAudit[]
  dispenseItems DispenseLineItem[]
  batches       DrugBatch[]
  facility      Facility                   @relation(fields: [facilityId], references: [id])
  grnItems      GoodsReceiptItem[]
  poItems       PurchaseOrderItem[]

  @@unique([facilityId, code])
  @@map("drug_masters")
}

/// DrugBatch tracks manufacturing, expiry, cost and price for specific medicine batches.
model DrugBatch {
  id                String                     @id @default(uuid())
  drugMasterId      String                     @map("drug_master_id")
  batchNumber       String                     @map("batch_number")
  manufacturer      String?
  manufacturingDate DateTime?                  @map("manufacturing_date")
  expiryDate        DateTime                   @map("expiry_date")
  unitCost          Float                      @default(0.0) @map("unit_cost")
  unitPrice         Float                      @default(0.0) @map("unit_price")
  status            BatchStatus                @default(ACTIVE)
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  supplier          String?
  audits            ControlledSubstanceAudit[]
  dispenseItems     DispenseLineItem[]
  drugMaster        DrugMaster                 @relation(fields: [drugMasterId], references: [id], onDelete: Cascade)
  grnItems          GoodsReceiptItem[]

  @@map("drug_batches")
}

/// PharmacyDispenseRecord tracks prescription fulfillment records.
model PharmacyDispenseRecord {
  id             String             @id @default(uuid())
  facilityId     String             @map("facility_id")
  prescriptionId String?            @map("prescription_id")
  patientId      String             @map("patient_id")
  dispensedById  String             @map("dispensed_by_id")
  witnessNurseId String?            @map("witness_nurse_id")
  status         DispenseStatus     @default(DISPENSED)
  totalAmount    Float              @default(0.0) @map("total_amount")
  notes          String?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  items          DispenseLineItem[]
  dispensedBy    User               @relation("DispenseUser", fields: [dispensedById], references: [id])
  facility       Facility           @relation(fields: [facilityId], references: [id])
  patient        PatientProfile     @relation(fields: [patientId], references: [id])
  witnessNurse   User?              @relation("DispenseWitnessNurse", fields: [witnessNurseId], references: [id])

  @@map("pharmacy_dispense_records")
}

/// DispenseLineItem represents an individual line item dispensed.
model DispenseLineItem {
  id           String                 @id @default(uuid())
  dispenseId   String                 @map("dispense_id")
  drugMasterId String                 @map("drug_master_id")
  drugBatchId  String                 @map("drug_batch_id")
  quantity     Int
  unitPrice    Float                  @default(0.0) @map("unit_price")
  totalPrice   Float                  @default(0.0) @map("total_price")
  dispense     PharmacyDispenseRecord @relation(fields: [dispenseId], references: [id], onDelete: Cascade)
  drugBatch    DrugBatch              @relation(fields: [drugBatchId], references: [id])
  drugMaster   DrugMaster             @relation(fields: [drugMasterId], references: [id])

  @@map("dispense_line_items")
}

/// PurchaseOrder tracks supplier procurement orders.
model PurchaseOrder {
  id           String              @id @default(uuid())
  facilityId   String              @map("facility_id")
  poNumber     String              @unique @map("po_number")
  supplierName String              @map("supplier_name")
  status       PurchaseOrderStatus @default(DRAFT)
  totalAmount  Float               @default(0.0) @map("total_amount")
  createdById  String              @map("created_by_id")
  approvedById String?             @map("approved_by_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  grns         GoodsReceiptNote[]
  items        PurchaseOrderItem[]
  approvedBy   User?               @relation("POApprover", fields: [approvedById], references: [id])
  createdBy    User                @relation("POCreator", fields: [createdById], references: [id])
  facility     Facility            @relation(fields: [facilityId], references: [id])

  @@map("purchase_orders")
}

/// PurchaseOrderItem represents line items inside a PurchaseOrder.
model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String        @map("purchase_order_id")
  drugMasterId     String        @map("drug_master_id")
  quantityOrdered  Int           @map("quantity_ordered")
  quantityReceived Int           @default(0) @map("quantity_received")
  unitPrice        Float         @default(0.0) @map("unit_price")
  drugMaster       DrugMaster    @relation(fields: [drugMasterId], references: [id])
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

/// GoodsReceiptNote (GRN) logs warehouse inventory receiving against purchase orders.
model GoodsReceiptNote {
  id              String             @id @default(uuid())
  facilityId      String             @map("facility_id")
  grnNumber       String             @unique @map("grn_number")
  purchaseOrderId String             @map("purchase_order_id")
  receivedById    String             @map("received_by_id")
  receivedAt      DateTime           @default(now()) @map("received_at")
  remarks         String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  items           GoodsReceiptItem[]
  facility        Facility           @relation(fields: [facilityId], references: [id])
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  receivedBy      User               @relation("GRNReceiver", fields: [receivedById], references: [id])

  @@map("goods_receipt_notes")
}

/// GoodsReceiptItem logs line items received in a GRN.
model GoodsReceiptItem {
  id               String           @id @default(uuid())
  grnId            String           @map("grn_id")
  drugMasterId     String           @map("drug_master_id")
  drugBatchId      String           @map("drug_batch_id")
  quantityReceived Int              @map("quantity_received")
  unitCost         Float            @default(0.0) @map("unit_cost")
  drugBatch        DrugBatch        @relation(fields: [drugBatchId], references: [id])
  drugMaster       DrugMaster       @relation(fields: [drugMasterId], references: [id])
  grn              GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_items")
}

/// ControlledSubstanceAudit provides strict audit logs for controlled drugs with dual-nurse witness verification.
model ControlledSubstanceAudit {
  id                 String          @id @default(uuid())
  facilityId         String          @map("facility_id")
  drugMasterId       String          @map("drug_master_id")
  drugBatchId        String          @map("drug_batch_id")
  patientId          String?         @map("patient_id")
  action             String          @default("DISPENSE")
  quantity           Int
  performedById      String          @map("performed_by_id")
  witnessNurseId     String?         @map("witness_nurse_id")
  verificationStatus String          @default("VERIFIED") @map("verification_status")
  remarks            String?
  createdAt          DateTime        @default(now()) @map("created_at")
  drugBatch          DrugBatch       @relation(fields: [drugBatchId], references: [id])
  drugMaster         DrugMaster      @relation(fields: [drugMasterId], references: [id])
  facility           Facility        @relation(fields: [facilityId], references: [id])
  patient            PatientProfile? @relation(fields: [patientId], references: [id])
  performedBy        User            @relation("AuditPerformer", fields: [performedById], references: [id])
  witnessNurse       User?           @relation("AuditWitnessNurse", fields: [witnessNurseId], references: [id])

  @@map("controlled_substance_audits")
}

/// OperationTheatre represents an individual OT suite room.
model OperationTheatre {
  id               String            @id @default(uuid())
  facilityId       String            @map("facility_id")
  name             String
  code             String
  status           OtRoomStatus      @default(AVAILABLE)
  equipmentDetails String?           @map("equipment_details")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  facility         Facility          @relation(fields: [facilityId], references: [id])
  surgeries        SurgerySchedule[]

  @@unique([facilityId, code])
  @@map("operation_theatres")
}

/// SurgerySchedule represents an scheduled or live surgery entry.
model SurgerySchedule {
  id                 String               @id @default(uuid())
  facilityId         String               @map("facility_id")
  otId               String               @map("ot_id")
  patientId          String               @map("patient_id")
  leadSurgeonId      String               @map("lead_surgeon_id")
  anesthetistId      String?              @map("anesthetist_id")
  procedureName      String               @map("procedure_name")
  priority           SurgeryPriority      @default(ELECTIVE)
  status             SurgeryStatus        @default(SCHEDULED)
  scheduledStartTime DateTime             @map("scheduled_start_time")
  scheduledEndTime   DateTime             @map("scheduled_end_time")
  actualStartTime    DateTime?            @map("actual_start_time")
  actualEndTime      DateTime?            @map("actual_end_time")
  notes              String?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  anesthesiaRecords  AnesthesiaRecord[]
  implants           ImplantUsage[]
  postOpNotes        PostOperativeNote[]
  surgeryNotes       SurgeryNote[]
  anesthetist        User?                @relation("AnesthetistUser", fields: [anesthetistId], references: [id])
  facility           Facility             @relation(fields: [facilityId], references: [id])
  leadSurgeon        User                 @relation("LeadSurgeonUser", fields: [leadSurgeonId], references: [id])
  ot                 OperationTheatre     @relation(fields: [otId], references: [id])
  patient            PatientProfile       @relation(fields: [patientId], references: [id])
  checklists         SurgicalChecklist[]
  surgicalTeam       SurgicalTeamMember[]

  @@map("surgery_schedules")
}

/// SurgicalTeamMember tracks surgical team assignments (assistant surgeons, scrub nurses, circulating nurses).
model SurgicalTeamMember {
  id        String          @id @default(uuid())
  surgeryId String          @map("surgery_id")
  userId    String          @map("user_id")
  role      String
  surgery   SurgerySchedule @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id])

  @@map("surgical_team_members")
}

/// AnesthesiaRecord logs pre-op anesthesia assessment, vitals and complications.
model AnesthesiaRecord {
  id              String          @id @default(uuid())
  surgeryId       String          @map("surgery_id")
  anesthetistId   String          @map("anesthetist_id")
  anesthesiaType  AnesthesiaType  @default(GENERAL) @map("anesthesia_type")
  preOpAssessment String?         @map("pre_op_assessment")
  intraOpVitals   String?         @map("intra_op_vitals")
  complications   String?
  createdAt       DateTime        @default(now()) @map("created_at")
  anesthetist     User            @relation("AnesthesiaRecordUser", fields: [anesthetistId], references: [id])
  surgery         SurgerySchedule @relation(fields: [surgeryId], references: [id], onDelete: Cascade)

  @@map("anesthesia_records")
}

/// SurgicalChecklist tracks WHO Surgical Safety Checklist compliance (Sign In, Time Out, Sign Out).
model SurgicalChecklist {
  id               String          @id @default(uuid())
  surgeryId        String          @map("surgery_id")
  signInCompleted  Boolean         @default(false) @map("sign_in_completed")
  timeOutCompleted Boolean         @default(false) @map("time_out_completed")
  signOutCompleted Boolean         @default(false) @map("sign_out_completed")
  completedById    String          @map("completed_by_id")
  completedAt      DateTime        @default(now()) @map("completed_at")
  completedBy      User            @relation("ChecklistUser", fields: [completedById], references: [id])
  surgery          SurgerySchedule @relation(fields: [surgeryId], references: [id], onDelete: Cascade)

  @@map("surgical_checklists")
}

/// ImplantUsage records prosthetics, implants, and high-value surgical items.
model ImplantUsage {
  id           String          @id @default(uuid())
  surgeryId    String          @map("surgery_id")
  implantName  String          @map("implant_name")
  serialNumber String?         @map("serial_number")
  manufacturer String?
  quantity     Int             @default(1)
  cost         Float           @default(0.0)
  surgery      SurgerySchedule @relation(fields: [surgeryId], references: [id], onDelete: Cascade)

  @@map("implant_usages")
}

/// SurgeryNote records intra-operative surgical findings and procedure descriptions.
model SurgeryNote {
  id                   String          @id @default(uuid())
  surgeryId            String          @map("surgery_id")
  authorId             String          @map("author_id")
  preOpDiagnosis       String?         @map("pre_op_diagnosis")
  postOpDiagnosis      String?         @map("post_op_diagnosis")
  procedureDescription String          @map("procedure_description")
  findings             String?
  createdAt            DateTime        @default(now()) @map("created_at")
  author               User            @relation("SurgeryNoteAuthor", fields: [authorId], references: [id])
  surgery              SurgerySchedule @relation(fields: [surgeryId], references: [id], onDelete: Cascade)

  @@map("surgery_notes")
}

/// PostOperativeNote logs PACU recovery status and post-op care instructions.
model PostOperativeNote {
  id                   String          @id @default(uuid())
  surgeryId            String          @map("surgery_id")
  authorId             String          @map("author_id")
  pacuStatus           String          @default("STABLE") @map("pacu_status")
  recoveryInstructions String          @map("recovery_instructions")
  createdAt            DateTime        @default(now()) @map("created_at")
  author               User            @relation("PostOpNoteAuthor", fields: [authorId], references: [id])
  surgery              SurgerySchedule @relation(fields: [surgeryId], references: [id], onDelete: Cascade)

  @@map("post_operative_notes")
}

/// BillingInvoice represents a comprehensive hospital bill/invoice.
model BillingInvoice {
  id             String               @id @default(uuid())
  invoiceNumber  String               @unique @map("invoice_number")
  patientId      String               @map("patient_id")
  admissionId    String?              @map("admission_id")
  encounterId    String?              @map("encounter_id")
  facilityId     String               @map("facility_id")
  invoiceDate    DateTime             @default(now()) @map("invoice_date")
  subtotal       Float                @default(0.0)
  taxAmount      Float                @default(0.0) @map("tax_amount")
  discountAmount Float                @default(0.0) @map("discount_amount")
  totalAmount    Float                @default(0.0) @map("total_amount")
  amountPaid     Float                @default(0.0) @map("amount_paid")
  balanceDue     Float                @default(0.0) @map("balance_due")
  paymentStatus  PaymentStatus        @default(PENDING) @map("payment_status")
  invoiceStatus  InvoiceStatus        @default(DRAFT) @map("invoice_status")
  notes          String?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  admission      Admission?           @relation(fields: [admissionId], references: [id])
  encounter      ClinicalEncounter?   @relation(fields: [encounterId], references: [id])
  facility       Facility             @relation(fields: [facilityId], references: [id])
  patient        PatientProfile       @relation(fields: [patientId], references: [id])
  items          BillingLineItem[]
  claims         InsuranceClaim[]
  payments       PaymentTransaction[]

  @@map("billing_invoices")
}

/// BillingLineItem represents individual itemized charges on a billing invoice.
model BillingLineItem {
  id              String         @id @default(uuid())
  invoiceId       String         @map("invoice_id")
  itemType        String         @map("item_type")
  itemName        String         @map("item_name")
  quantity        Int            @default(1)
  unitPrice       Float          @default(0.0) @map("unit_price")
  taxPercent      Float          @default(18.0) @map("tax_percent")
  discountPercent Float          @default(0.0) @map("discount_percent")
  totalPrice      Float          @default(0.0) @map("total_price")
  invoice         BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("billing_line_items")
}

/// PaymentTransaction records partial or full payment receipts for invoices.
model PaymentTransaction {
  id                   String          @id @default(uuid())
  invoiceId            String?         @map("invoice_id")
  transactionReference String?         @map("transaction_reference")
  amount               Float
  paymentDate          DateTime        @default(now()) @map("payment_date")
  collectedById        String?         @map("collected_by_id")
  createdAt            DateTime        @default(now()) @map("created_at")
  financeInvoiceId     String?         @map("finance_invoice_id")
  receivedBy           String?         @map("received_by")
  status               String          @default("SUCCESS")
  receivedById         String?         @map("received_by_id")
  paymentMethod        PaymentMethod   @default(CASH) @map("payment_method")
  collectedBy          User?           @relation("PaymentCollector", fields: [collectedById], references: [id])
  financeInvoice       Invoice?        @relation(fields: [financeInvoiceId], references: [id], onDelete: Cascade)
  invoice              BillingInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receiver             User?           @relation("PaymentReceiver", fields: [receivedBy], references: [id])
  receivedByUser       User?           @relation("PaymentReceivedByUser", fields: [receivedById], references: [id])

  @@index([invoiceId, paymentDate])
  @@index([financeInvoiceId, paymentDate])
  @@map("payment_transactions")
}

/// InsuranceProvider represents third-party payors, health insurers and TPAs.
model InsuranceProvider {
  id                    String             @id @default(uuid())
  providerName          String             @default("") @map("provider_name")
  contactDetails        String?            @map("contact_details")
  claimEmail            String?            @map("claim_email")
  policyValidationRules String?            @map("policy_validation_rules")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  address               String?
  code                  String?            @unique
  contactPerson         String?            @map("contact_person")
  email                 String?
  name                  String             @default("")
  phone                 String?
  active                Boolean            @default(true)
  contactEmail          String?            @map("contact_email")
  contactPhone          String?            @map("contact_phone")
  providerCode          String?            @unique @map("provider_code")
  claims                InsuranceClaim[]
  insurancePolicies     InsurancePolicy[]
  policies              PatientInsurance[]

  @@map("insurance_providers")
}

/// PatientInsurance links patients to verified health insurance coverage policies.
model PatientInsurance {
  id                  String            @id @default(uuid())
  patientId           String            @map("patient_id")
  insuranceProviderId String            @map("insurance_provider_id")
  policyNumber        String            @map("policy_number")
  memberId            String?           @map("member_id")
  coverageAmount      Float             @default(0.0) @map("coverage_amount")
  validFrom           DateTime          @default(now()) @map("valid_from")
  validTill           DateTime          @map("valid_till")
  status              String            @default("ACTIVE")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  claims              InsuranceClaim[]
  provider            InsuranceProvider @relation(fields: [insuranceProviderId], references: [id])
  patient             PatientProfile    @relation(fields: [patientId], references: [id])

  @@map("patient_insurances")
}

/// InsurancePolicy models verified health insurance policies and corporate plans.
model InsurancePolicy {
  id                  String            @id @default(uuid())
  patientId           String            @map("patient_id")
  insuranceProviderId String            @map("insurance_provider_id")
  policyNumber        String            @map("policy_number")
  memberId            String?           @map("member_id")
  coverageAmount      Float             @default(0.0) @map("coverage_amount")
  utilizedAmount      Float             @default(0.0) @map("utilized_amount")
  insuranceType       InsuranceType     @default(CASHLESS) @map("insurance_type")
  policyStatus        PolicyStatus      @default(ACTIVE) @map("policy_status")
  validFrom           DateTime          @default(now()) @map("valid_from")
  validTill           DateTime          @map("valid_till")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  claims              InsuranceClaim[]
  provider            InsuranceProvider @relation(fields: [insuranceProviderId], references: [id])
  patient             PatientProfile    @relation(fields: [patientId], references: [id])

  @@index([patientId, policyStatus])
  @@index([policyNumber])
  @@map("insurance_policies")
}

/// InsuranceClaim manages insurance claim processing, pre-auths, and reimbursement settlements.
model InsuranceClaim {
  id                   String               @id @default(uuid())
  claimNumber          String               @unique @map("claim_number")
  invoiceId            String?              @map("invoice_id")
  providerId           String?              @map("provider_id")
  patientId            String               @map("patient_id")
  claimAmount          Float?               @map("claim_amount")
  approvedAmount       Float?               @default(0.0) @map("approved_amount")
  rejectedAmount       Float?               @default(0.0) @map("rejected_amount")
  claimStatus          ClaimStatus?         @default(DRAFT) @map("claim_status")
  submissionDate       DateTime?            @map("submission_date")
  approvalDate         DateTime?            @map("approval_date")
  remarks              String?
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  admissionId          String?              @map("admission_id")
  amountApproved       Float                @default(0.0) @map("amount_approved")
  amountClaimed        Float                @default(0.0) @map("amount_claimed")
  amountPaid           Float                @default(0.0) @map("amount_paid")
  approvedAt           DateTime?            @map("approved_at")
  claimType            ClaimType            @default(CASHLESS) @map("claim_type")
  facilityId           String?              @map("facility_id")
  insuranceProviderId  String?              @map("insurance_provider_id")
  patientInsuranceId   String?              @map("patient_insurance_id")
  status               ClaimStatus          @default(DRAFT)
  submittedAt          DateTime?            @map("submitted_at")
  patientPayableAmount Float?               @default(0.0) @map("patient_payable_amount")
  policyId             String?              @map("policy_id")
  settledAt            DateTime?            @map("settled_at")
  totalClaimAmount     Float                @default(0.0) @map("total_claim_amount")
  accountsReceivables  AccountsReceivable[]
  auditLogs            ClaimAuditLog[]
  documents            ClaimDocument[]
  queries              ClaimQuery[]
  settlements          ClaimSettlement[]
  admission            Admission?           @relation(fields: [admissionId], references: [id])
  facility             Facility?            @relation(fields: [facilityId], references: [id])
  invoice              BillingInvoice?      @relation(fields: [invoiceId], references: [id])
  patient              PatientProfile       @relation(fields: [patientId], references: [id])
  patientInsurance     PatientInsurance?    @relation(fields: [patientInsuranceId], references: [id])
  policy               InsurancePolicy?     @relation(fields: [policyId], references: [id])
  provider             InsuranceProvider?   @relation(fields: [providerId], references: [id])

  @@index([facilityId, status])
  @@index([patientId, claimNumber])
  @@map("insurance_claims")
}

/// ClaimDocument tracks attached supporting clinical and financial files for an insurance claim.
model ClaimDocument {
  id               String         @id @default(uuid())
  claimId          String         @map("claim_id")
  documentType     String         @map("document_type")
  fileAttachmentId String?        @map("file_attachment_id")
  documentUrl      String?        @map("document_url")
  uploadedById     String?        @map("uploaded_by_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  claim            InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  uploadedBy       User?          @relation("ClaimDocUploader", fields: [uploadedById], references: [id])

  @@index([claimId])
  @@map("claim_documents")
}

/// ClaimQuery records TPA information requests and hospital coordinator responses.
model ClaimQuery {
  id           String         @id @default(uuid())
  claimId      String         @map("claim_id")
  queryText    String         @map("query_text")
  responseText String?        @map("response_text")
  raisedBy     String?        @map("raised_by")
  resolved     Boolean        @default(false)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  claim        InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, resolved])
  @@map("claim_queries")
}

/// ClaimSettlement records payout and payment reconciliation details for approved claims.
model ClaimSettlement {
  id               String         @id @default(uuid())
  claimId          String         @map("claim_id")
  approvedAmount   Float          @map("approved_amount")
  settlementDate   DateTime       @default(now()) @map("settlement_date")
  paymentReference String         @map("payment_reference")
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at")
  claim            InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("claim_settlements")
}

/// ClaimAuditLog tracks audit events across the insurance claim settlement lifecycle.
model ClaimAuditLog {
  id            String         @id @default(uuid())
  claimId       String         @map("claim_id")
  action        String
  performedById String         @map("performed_by_id")
  remarks       String?
  createdAt     DateTime       @default(now()) @map("created_at")
  claim         InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  performedBy   User           @relation("ClaimAuditor", fields: [performedById], references: [id])

  @@map("claim_audit_logs")
}

/// Employee represents a hospital staff member, doctor, nurse, or administrative employee.
model Employee {
  id                 String             @id @default(uuid())
  facilityId         String             @map("facility_id")
  userId             String?            @unique @map("user_id")
  employeeCode       String             @unique @map("employee_code")
  fullName           String             @map("full_name")
  departmentId       String             @map("department_id")
  designation        String
  joiningDate        DateTime           @default(now()) @map("joining_date")
  employmentType     EmploymentType     @default(FULL_TIME) @map("employment_type")
  reportingManagerId String?            @map("reporting_manager_id")
  status             String             @default("ACTIVE")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  attendanceRecords  AttendanceRecord[]
  department         Department         @relation(fields: [departmentId], references: [id])
  facility           Facility           @relation(fields: [facilityId], references: [id])
  user               User?              @relation(fields: [userId], references: [id])
  leaveRequests      LeaveRequest[]
  payslips           Payslip[]
  salaryStructure    SalaryStructure?
  shifts             ShiftAssignment[]

  @@map("employees")
}

/// EmployeeProfile manages hospital staff, doctors, nurses, lab technicians, pharmacists, and admins.
model EmployeeProfile {
  id                 String              @id @default(uuid())
  facilityId         String              @map("facility_id")
  employeeCode       String              @unique @map("employee_code")
  fullName           String              @map("full_name")
  department         String
  designation        String
  joiningDate        DateTime            @default(now()) @map("joining_date")
  employeeStatus     EmployeeStatus      @default(ACTIVE) @map("employee_status")
  phone              String
  email              String
  emergencyContact   String?             @map("emergency_contact")
  reportingManagerId String?             @map("reporting_manager_id")
  userId             String?             @unique @map("user_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  attendanceRecords  AttendanceRecord[]
  credentials        CredentialRecord[]
  facility           Facility            @relation(fields: [facilityId], references: [id])
  reportingManager   EmployeeProfile?    @relation("EmployeeHierarchy", fields: [reportingManagerId], references: [id])
  subordinates       EmployeeProfile[]   @relation("EmployeeHierarchy")
  user               User?               @relation("StaffEmployeeProfile", fields: [userId], references: [id])
  leaveRequests      LeaveRequest[]
  payrollRecords     PayrollRecord[]
  performanceReviews PerformanceReview[]
  shiftSchedules     ShiftSchedule[]

  @@index([facilityId, employeeStatus])
  @@index([department, designation])
  @@map("employee_profiles")
}

/// AttendanceRecord tracks daily biometric or manual clock-in/clock-out events.
model AttendanceRecord {
  id                String           @id @default(uuid())
  employeeId        String?          @map("employee_id")
  facilityId        String?          @map("facility_id")
  checkInTime       DateTime?        @default(now()) @map("check_in_time")
  checkOutTime      DateTime?        @map("check_out_time")
  totalHours        Float            @default(0.0) @map("total_hours")
  attendanceStatus  AttendanceStatus @default(PRESENT) @map("attendance_status")
  createdAt         DateTime         @default(now()) @map("created_at")
  attendanceDate    DateTime         @default(now()) @map("attendance_date")
  employeeProfileId String?          @map("employee_profile_id")
  workingHours      Float            @default(0.0) @map("working_hours")
  employee          Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeProfile   EmployeeProfile? @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  facility          Facility?        @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([employeeProfileId, attendanceDate])
  @@map("attendance_records")
}

/// ShiftAssignment allocates staff shifts across clinical and operational departments.
model ShiftAssignment {
  id           String     @id @default(uuid())
  employeeId   String     @map("employee_id")
  departmentId String     @map("department_id")
  shiftType    String     @map("shift_type")
  startTime    DateTime   @map("start_time")
  endTime      DateTime   @map("end_time")
  assignedById String     @map("assigned_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  assignedBy   User       @relation("ShiftAssigner", fields: [assignedById], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("shift_assignments")
}

/// ShiftSchedule assigns shifts to hospital personnel.
model ShiftSchedule {
  id           String          @id @default(uuid())
  employeeId   String          @map("employee_id")
  shiftName    String          @map("shift_name")
  startTime    DateTime        @map("start_time")
  endTime      DateTime        @map("end_time")
  department   String
  assignedById String?         @map("assigned_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  assignedBy   User?           @relation("ShiftScheduleAssigner", fields: [assignedById], references: [id])
  employee     EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startTime])
  @@map("shift_schedules")
}

/// LeaveRequest handles employee time-off and medical leave applications.
model LeaveRequest {
  id                String           @id @default(uuid())
  employeeId        String?          @map("employee_id")
  leaveType         String           @map("leave_type")
  startDate         DateTime         @map("start_date")
  endDate           DateTime         @map("end_date")
  reason            String
  approvalStatus    ApprovalStatus   @default(PENDING) @map("approval_status")
  approvedById      String?          @map("approved_by_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  approvedAt        DateTime?        @map("approved_at")
  employeeProfileId String?          @map("employee_profile_id")
  leaveStatus       LeaveStatus      @default(PENDING) @map("leave_status")
  approvedBy        User?            @relation("LeaveApprover", fields: [approvedById], references: [id])
  employee          Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeProfile   EmployeeProfile? @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([employeeProfileId, leaveStatus])
  @@map("leave_requests")
}

/// PayrollRecord tracks monthly salary breakdown, allowances, deductions, and payment status.
model PayrollRecord {
  id            String          @id @default(uuid())
  employeeId    String          @map("employee_id")
  payrollMonth  String          @map("payroll_month")
  basicSalary   Float           @map("basic_salary")
  allowances    Float           @default(0.0)
  deductions    Float           @default(0.0)
  netSalary     Float           @map("net_salary")
  payrollStatus PayrollStatus   @default(GENERATED) @map("payroll_status")
  generatedAt   DateTime        @default(now()) @map("generated_at")
  paidAt        DateTime?       @map("paid_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, payrollMonth])
  @@map("payroll_records")
}

/// CredentialRecord tracks professional medical licenses, board certifications, and expiration tracking.
model CredentialRecord {
  id                 String          @id @default(uuid())
  employeeId         String          @map("employee_id")
  credentialType     String          @map("credential_type")
  licenseNumber      String          @map("license_number")
  issueDate          DateTime        @map("issue_date")
  expiryDate         DateTime        @map("expiry_date")
  verificationStatus String          @default("VERIFIED") @map("verification_status")
  createdAt          DateTime        @default(now()) @map("created_at")
  employee           EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, expiryDate])
  @@map("credential_records")
}

/// PerformanceReview records structured employee clinical and operational evaluations.
model PerformanceReview {
  id           String          @id @default(uuid())
  employeeId   String          @map("employee_id")
  reviewerId   String          @map("reviewer_id")
  reviewPeriod String          @map("review_period")
  rating       Float
  strengths    String
  improvements String
  comments     String
  createdAt    DateTime        @default(now()) @map("created_at")
  employee     EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer     User            @relation("PerformanceReviewer", fields: [reviewerId], references: [id])

  @@index([employeeId, reviewPeriod])
  @@map("performance_reviews")
}

/// SalaryStructure defines compensation, basic salary, allowances, and statutory deductions.
model SalaryStructure {
  id              String   @id @default(uuid())
  employeeId      String   @unique @map("employee_id")
  basicSalary     Float    @default(0.0) @map("basic_salary")
  hra             Float    @default(0.0)
  allowances      Float    @default(0.0)
  deductions      Float    @default(0.0)
  pfContribution  Float    @default(0.0) @map("pf_contribution")
  esiContribution Float    @default(0.0) @map("esi_contribution")
  netSalary       Float    @default(0.0) @map("net_salary")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("salary_structures")
}

/// PayrollRun manages monthly facility-wide payroll disbursement cycles.
model PayrollRun {
  id                 String        @id @default(uuid())
  payrollMonth       String        @map("payroll_month")
  facilityId         String        @map("facility_id")
  totalEmployees     Int           @default(0) @map("total_employees")
  totalPayrollAmount Float         @default(0.0) @map("total_payroll_amount")
  status             PayrollStatus @default(DRAFT)
  generatedById      String        @map("generated_by_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  facility           Facility      @relation(fields: [facilityId], references: [id])
  generatedBy        User          @relation("PayrollGenerator", fields: [generatedById], references: [id])
  payslips           Payslip[]

  @@map("payroll_runs")
}

/// Payslip itemizes individual employee compensation and tax deductions for a payroll run.
model Payslip {
  id           String     @id @default(uuid())
  payrollRunId String     @map("payroll_run_id")
  employeeId   String     @map("employee_id")
  grossSalary  Float      @default(0.0) @map("gross_salary")
  deductions   Float      @default(0.0)
  netSalary    Float      @default(0.0) @map("net_salary")
  pdfUrl       String?    @map("pdf_url")
  createdAt    DateTime   @default(now()) @map("created_at")
  employee     Employee   @relation(fields: [employeeId], references: [id])
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@map("payslips")
}

/// InventoryItem manages non-pharmacy hospital supplies, consumables, and surgical equipment.
model InventoryItem {
  id            String                         @id @default(uuid())
  itemCode      String                         @unique @map("item_code")
  itemName      String                         @map("item_name")
  category      String
  unitOfMeasure String                         @default("UNIT") @map("unit_of_measure")
  currentStock  Int                            @default(0) @map("current_stock")
  minimumStock  Int                            @default(10) @map("minimum_stock")
  reorderLevel  Int                            @default(20) @map("reorder_level")
  unitPrice     Float                          @default(0.0) @map("unit_price")
  location      String?
  facilityId    String                         @map("facility_id")
  status        InventoryStatus                @default(ACTIVE)
  createdAt     DateTime                       @default(now()) @map("created_at")
  updatedAt     DateTime                       @updatedAt @map("updated_at")
  transactions  HospitalInventoryTransaction[]
  facility      Facility                       @relation(fields: [facilityId], references: [id])

  @@map("inventory_items")
}

/// HospitalInventoryTransaction logs every stock-in, stock-out, transfer, and adjustment.
model HospitalInventoryTransaction {
  id              String          @id @default(uuid())
  itemId          String          @map("item_id")
  transactionType TransactionType @map("transaction_type")
  quantity        Int
  previousStock   Int             @map("previous_stock")
  newStock        Int             @map("new_stock")
  performedById   String          @map("performed_by_id")
  remarks         String?
  createdAt       DateTime        @default(now()) @map("created_at")
  item            InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  performedBy     User            @relation("InventoryPerformer", fields: [performedById], references: [id])

  @@map("hospital_inventory_transactions")
}

/// Vendor represents medical supply, equipment, and consumable vendors.
model Vendor {
  id                 String                     @id @default(uuid())
  vendorCode         String                     @unique @map("vendor_code")
  companyName        String?                    @map("company_name")
  contactPerson      String?                    @map("contact_person")
  email              String?
  phone              String?
  gstNumber          String?                    @map("gst_number")
  address            String?
  status             String                     @default("ACTIVE")
  rating             Float                      @default(4.8)
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  deliveryScore      Float                      @default(95.0) @map("delivery_score")
  panNumber          String?                    @map("pan_number")
  qualityScore       Float                      @default(98.0) @map("quality_score")
  responseScore      Float                      @default(92.0) @map("response_score")
  vendorName         String?                    @map("vendor_name")
  vendorStatus       VendorStatus               @default(ACTIVE) @map("vendor_status")
  procurementOrders  ProcurementPurchaseOrder[]
  purchaseOrders     HospitalProcurementPO[]
  quotationResponses QuotationResponse[]
  rfqs               RequestForQuotation[]
  invoices           VendorInvoice[]

  @@map("supply_vendors")
}

/// PurchaseRequisition captures departmental supply requests requiring approval.
model PurchaseRequisition {
  id                String                     @id @default(uuid())
  requisitionNumber String                     @unique @map("requisition_number")
  departmentId      String?                    @map("department_id")
  facilityId        String                     @map("facility_id")
  requestedById     String                     @map("requested_by_id")
  approvalStatus    ApprovalStatus             @default(PENDING) @map("approval_status")
  totalAmount       Float                      @default(0.0) @map("total_amount")
  items             String?
  approvedById      String?                    @map("approved_by_id")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  approvedAt        DateTime?                  @map("approved_at")
  department        String?
  remarks           String?
  status            ProcurementStatus          @default(DRAFT)
  procurementOrders ProcurementPurchaseOrder[]
  purchaseOrders    HospitalProcurementPO[]
  requisitionItems  PurchaseRequisitionItem[]
  approvedBy        User?                      @relation("RequisitionApprover", fields: [approvedById], references: [id])
  departmentRel     Department?                @relation(fields: [departmentId], references: [id])
  facility          Facility                   @relation(fields: [facilityId], references: [id])
  requestedBy       User                       @relation("RequisitionRequester", fields: [requestedById], references: [id])
  rfqs              RequestForQuotation[]

  @@map("purchase_requisitions")
}

/// PurchaseRequisitionItem captures line items inside a PurchaseRequisition.
model PurchaseRequisitionItem {
  id            String              @id @default(uuid())
  requisitionId String              @map("requisition_id")
  itemName      String              @map("item_name")
  quantity      Int
  estimatedCost Float               @default(0.0) @map("estimated_cost")
  createdAt     DateTime            @default(now()) @map("created_at")
  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@map("purchase_requisition_items")
}

/// RequestForQuotation (RFQ) solicits price bids and delivery timelines from registered vendors.
model RequestForQuotation {
  id                 String                     @id @default(uuid())
  rfqNumber          String                     @unique @map("rfq_number")
  requisitionId      String                     @map("requisition_id")
  vendorId           String?                    @map("vendor_id")
  status             RFQStatus                  @default(OPEN)
  submissionDeadline DateTime                   @map("submission_deadline")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  procurementOrders  ProcurementPurchaseOrder[]
  responses          QuotationResponse[]
  requisition        PurchaseRequisition        @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  vendor             Vendor?                    @relation(fields: [vendorId], references: [id])

  @@map("requests_for_quotation")
}

/// QuotationResponse logs vendor pricing, lead time, and terms submitted for an RFQ.
model QuotationResponse {
  id           String              @id @default(uuid())
  rfqId        String              @map("rfq_id")
  vendorId     String              @map("vendor_id")
  quotedAmount Float               @map("quoted_amount")
  deliveryDays Int                 @map("delivery_days")
  notes        String?
  createdAt    DateTime            @default(now()) @map("created_at")
  rfq          RequestForQuotation @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor       Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("quotation_responses")
}

/// ProcurementPurchaseOrder issues formal binding purchase orders to suppliers.
model ProcurementPurchaseOrder {
  id            String                  @id @default(uuid())
  poNumber      String                  @unique @map("po_number")
  vendorId      String                  @map("vendor_id")
  facilityId    String                  @map("facility_id")
  requisitionId String?                 @map("requisition_id")
  rfqId         String?                 @map("rfq_id")
  totalAmount   Float                   @default(0.0) @map("total_amount")
  status        ProcurementStatus       @default(ORDERED)
  createdById   String?                 @map("created_by_id")
  approvedById  String?                 @map("approved_by_id")
  createdAt     DateTime                @default(now()) @map("created_at")
  approvedAt    DateTime?               @map("approved_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  goodsReceipts GoodsReceipt[]
  lineItems     PurchaseOrderLineItem[]
  facility      Facility                @relation(fields: [facilityId], references: [id])
  requisition   PurchaseRequisition?    @relation(fields: [requisitionId], references: [id])
  rfq           RequestForQuotation?    @relation(fields: [rfqId], references: [id])
  vendor        Vendor                  @relation(fields: [vendorId], references: [id])
  invoices      VendorInvoice[]

  @@map("procurement_orders")
}

/// PurchaseOrderLineItem details item breakdown, quantity, and unit prices for a Purchase Order.
model PurchaseOrderLineItem {
  id              String                   @id @default(uuid())
  purchaseOrderId String                   @map("purchase_order_id")
  itemName        String                   @map("item_name")
  quantity        Int
  unitPrice       Float                    @default(0.0) @map("unit_price")
  totalPrice      Float                    @default(0.0) @map("total_price")
  createdAt       DateTime                 @default(now()) @map("created_at")
  purchaseOrder   ProcurementPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("procurement_order_line_items")
}

/// GoodsReceipt (GRN) records warehouse receiving, physical count, and inspection of shipments.
model GoodsReceipt {
  id              String                   @id @default(uuid())
  grnNumber       String                   @unique @map("grn_number")
  purchaseOrderId String                   @map("purchase_order_id")
  receivedById    String                   @map("received_by_id")
  receivedAt      DateTime                 @default(now()) @map("received_at")
  remarks         String?
  status          String                   @default("RECEIVED")
  createdAt       DateTime                 @default(now()) @map("created_at")
  lineItems       GoodsReceiptLineItem[]
  purchaseOrder   ProcurementPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedBy      User                     @relation("ProcurementGRNReceiver", fields: [receivedById], references: [id])

  @@map("goods_receipts")
}

/// GoodsReceiptLineItem details received quantity, batch numbers, and expiry for received goods.
model GoodsReceiptLineItem {
  id               String       @id @default(uuid())
  goodsReceiptId   String       @map("goods_receipt_id")
  itemName         String       @map("item_name")
  quantityReceived Int          @map("quantity_received")
  batchNumber      String?      @map("batch_number")
  expiryDate       DateTime?    @map("expiry_date")
  createdAt        DateTime     @default(now()) @map("created_at")
  goodsReceipt     GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_line_items")
}

/// VendorInvoice stores supplier billing with automated 3-Way Matching against PO and GRN.
model VendorInvoice {
  id                  String                   @id @default(uuid())
  invoiceNumber       String                   @unique @map("invoice_number")
  vendorId            String                   @map("vendor_id")
  purchaseOrderId     String                   @map("purchase_order_id")
  invoiceAmount       Float                    @map("invoice_amount")
  dueDate             DateTime                 @map("due_date")
  status              String                   @default("PENDING")
  threeWayMatchStatus String                   @default("MATCHED") @map("three_way_match_status")
  matchRemarks        String?                  @map("match_remarks")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  purchaseOrder       ProcurementPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  vendor              Vendor                   @relation(fields: [vendorId], references: [id])
  payments            VendorPayment[]

  @@map("vendor_invoices")
}

/// VendorPayment captures accounts payable disbursements against approved vendor invoices.
model VendorPayment {
  id               String        @id @default(uuid())
  paymentReference String        @unique @map("payment_reference")
  vendorInvoiceId  String        @map("vendor_invoice_id")
  amount           Float
  paymentDate      DateTime      @default(now()) @map("payment_date")
  paymentMethod    String        @default("NEFT") @map("payment_method")
  createdAt        DateTime      @default(now()) @map("created_at")
  vendorInvoice    VendorInvoice @relation(fields: [vendorInvoiceId], references: [id], onDelete: Cascade)

  @@map("vendor_payments")
}

/// HospitalProcurementPO tracks vendor purchase orders for hospital goods and supplies.
model HospitalProcurementPO {
  id                   String                 @id @default(uuid())
  poNumber             String                 @unique @map("po_number")
  vendorId             String                 @map("vendor_id")
  requisitionId        String?                @map("requisition_id")
  facilityId           String                 @map("facility_id")
  orderDate            DateTime               @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?              @map("expected_delivery_date")
  status               ProcurementPOStatus    @default(DRAFT)
  totalAmount          Float                  @default(0.0) @map("total_amount")
  createdById          String                 @map("created_by_id")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  goodsReceipts        HospitalGoodsReceipt[]
  createdBy            User                   @relation("ProcurementPOCreator", fields: [createdById], references: [id])
  facility             Facility               @relation(fields: [facilityId], references: [id])
  requisition          PurchaseRequisition?   @relation(fields: [requisitionId], references: [id])
  vendor               Vendor                 @relation(fields: [vendorId], references: [id])

  @@map("procurement_purchase_orders")
}

/// HospitalGoodsReceipt verifies and accepts vendor shipments into stock.
model HospitalGoodsReceipt {
  id              String                @id @default(uuid())
  receiptNumber   String                @unique @map("receipt_number")
  purchaseOrderId String                @map("purchase_order_id")
  receivedById    String                @map("received_by_id")
  receivedDate    DateTime              @default(now()) @map("received_date")
  status          String                @default("RECEIVED")
  remarks         String?
  createdAt       DateTime              @default(now()) @map("created_at")
  purchaseOrder   HospitalProcurementPO @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedBy      User                  @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id])

  @@map("hospital_goods_receipts")
}

/// HospitalAsset tracks biomedical equipment, ventilators, imaging scanners, and surgical assets.
model HospitalAsset {
  id                   String              @id @default(uuid())
  assetCode            String              @unique @map("asset_code")
  assetName            String              @map("asset_name")
  category             String
  facilityId           String              @map("facility_id")
  departmentId         String?             @map("department_id")
  purchaseDate         DateTime            @default(now()) @map("purchase_date")
  warrantyExpiry       DateTime            @map("warranty_expiry")
  maintenanceFrequency String              @default("QUARTERLY") @map("maintenance_frequency")
  currentLocation      String              @map("current_location")
  status               AssetStatus         @default(ACTIVE)
  purchaseCost         Float               @default(0.0) @map("purchase_cost")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  department           Department?         @relation(fields: [departmentId], references: [id])
  facility             Facility            @relation(fields: [facilityId], references: [id])
  tickets              MaintenanceTicket[]

  @@map("hospital_assets")
}

/// MaintenanceTicket tracks corrective and preventive engineering tickets on biomedical assets.
model MaintenanceTicket {
  id               String              @id @default(uuid())
  ticketNumber     String              @unique @map("ticket_number")
  assetId          String              @map("asset_id")
  issueDescription String              @map("issue_description")
  priority         MaintenancePriority @default(MEDIUM)
  assignedTo       String?             @map("assigned_to")
  status           String              @default("OPEN")
  resolutionNotes  String?             @map("resolution_notes")
  reportedById     String              @map("reported_by_id")
  resolvedAt       DateTime?           @map("resolved_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  asset            HospitalAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reportedBy       User                @relation("TicketReporter", fields: [reportedById], references: [id])

  @@map("maintenance_tickets")
}

/// KpiSnapshot captures periodic operational, financial, and clinical KPIs for C-level dashboards.
model KpiSnapshot {
  id                   String        @id @default(uuid())
  facilityId           String        @map("facility_id")
  snapshotDate         DateTime      @default(now()) @map("snapshot_date")
  revenueToday         Float         @default(0.0) @map("revenue_today")
  revenueMonth         Float         @default(0.0) @map("revenue_month")
  opdPatients          Int           @default(0) @map("opd_patients")
  ipdPatients          Int           @default(0) @map("ipd_patients")
  occupancyRate        Float         @default(0.0) @map("occupancy_rate")
  bedUtilization       Float         @default(0.0) @map("bed_utilization")
  averageLos           Float         @default(0.0) @map("average_los")
  patientSatisfaction  Float         @default(98.5) @map("patient_satisfaction")
  emergencyCases       Int           @default(0) @map("emergency_cases")
  labOrders            Int           @default(0) @map("lab_orders")
  pharmacySales        Float         @default(0.0) @map("pharmacy_sales")
  telemedicineSessions Int           @default(0) @map("telemedicine_sessions")
  createdAt            DateTime      @default(now()) @map("created_at")
  metricName           String?       @map("metric_name")
  metricValue          Float?        @map("metric_value")
  period               MetricPeriod? @default(TODAY)
  facility             Facility      @relation(fields: [facilityId], references: [id])

  @@index([facilityId, snapshotDate])
  @@index([facilityId, metricName, period])
  @@map("kpi_snapshots")
}

/// DashboardWidget configures customizable C-suite command wall widgets.
model DashboardWidget {
  id         String   @id @default(uuid())
  facilityId String   @map("facility_id")
  widgetName String   @map("widget_name")
  widgetType String   @map("widget_type")
  position   Int      @default(0)
  isEnabled  Boolean  @default(true) @map("is_enabled")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  facility   Facility @relation(fields: [facilityId], references: [id])

  @@map("dashboard_widgets")
}

/// ExecutiveAlert captures critical cross-departmental warnings for the executive board.
model ExecutiveAlert {
  id               String        @id @default(uuid())
  facilityId       String        @map("facility_id")
  title            String
  description      String
  severity         AlertSeverity @default(HIGH)
  category         AlertCategory @default(OPERATIONAL)
  status           AlertStatus   @default(OPEN)
  acknowledgedById String?       @map("acknowledged_by_id")
  acknowledgedAt   DateTime?     @map("acknowledged_at")
  resolvedById     String?       @map("resolved_by_id")
  resolvedAt       DateTime?     @map("resolved_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  acknowledgedBy   User?         @relation("AlertAcknowledger", fields: [acknowledgedById], references: [id])
  facility         Facility      @relation(fields: [facilityId], references: [id])
  resolvedBy       User?         @relation("AlertResolver", fields: [resolvedById], references: [id])

  @@map("executive_alerts")
}

/// InfectionCase tracks healthcare-associated infections (HAIs), surveillance, and outbreak control.
model InfectionCase {
  id              String                   @id @default(uuid())
  caseNumber      String                   @unique @map("case_number")
  patientId       String                   @map("patient_id")
  admissionId     String?                  @map("admission_id")
  facilityId      String                   @map("facility_id")
  infectionType   String                   @map("infection_type")
  infectionSource String                   @default("HOSPITAL_ACQUIRED") @map("infection_source")
  detectionDate   DateTime                 @default(now()) @map("detection_date")
  severity        InfectionSeverity        @default(MODERATE)
  status          String                   @default("OPEN")
  reportedById    String                   @map("reported_by_id")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  admission       Admission?               @relation(fields: [admissionId], references: [id])
  facility        Facility                 @relation(fields: [facilityId], references: [id])
  patient         PatientProfile           @relation(fields: [patientId], references: [id])
  reportedBy      User                     @relation("InfectionReporter", fields: [reportedById], references: [id])
  investigations  InfectionInvestigation[]

  @@map("infection_cases")
}

/// InfectionInvestigation captures root cause analysis (RCA) and preventive actions for infections.
model InfectionInvestigation {
  id                String        @id @default(uuid())
  infectionCaseId   String        @map("infection_case_id")
  rootCauseAnalysis String        @map("root_cause_analysis")
  correctiveAction  String        @map("corrective_action")
  preventiveAction  String        @map("preventive_action")
  assignedToId      String        @map("assigned_to_id")
  dueDate           DateTime      @map("due_date")
  status            String        @default("IN_PROGRESS")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  assignedTo        User          @relation("InfectionInvestigator", fields: [assignedToId], references: [id])
  infectionCase     InfectionCase @relation(fields: [infectionCaseId], references: [id], onDelete: Cascade)

  @@map("infection_investigations")
}

/// IncidentReport logs clinical adverse events, near-misses, and sentinel occurrences.
model IncidentReport {
  id             String           @id @default(uuid())
  incidentNumber String           @unique @map("incident_number")
  facilityId     String           @map("facility_id")
  patientId      String?          @map("patient_id")
  reportedById   String           @map("reported_by_id")
  incidentType   String           @map("incident_type")
  severity       IncidentSeverity @default(MEDIUM)
  description    String
  incidentDate   DateTime         @default(now()) @map("incident_date")
  status         IncidentStatus   @default(OPEN)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  capas          CAPARecord[]
  facility       Facility         @relation(fields: [facilityId], references: [id])
  patient        PatientProfile?  @relation(fields: [patientId], references: [id])
  reportedBy     User             @relation("IncidentReporter", fields: [reportedById], references: [id])

  @@map("incident_reports")
}

/// QualityAudit tracks clinical quality, NABH/JCI compliance, and nursing clinical governance.
model QualityAudit {
  id              String       @id @default(uuid())
  auditNumber     String       @unique @map("audit_number")
  facilityId      String       @map("facility_id")
  auditName       String       @map("audit_name")
  departmentId    String       @map("department_id")
  auditorId       String       @map("auditor_id")
  auditDate       DateTime     @default(now()) @map("audit_date")
  score           Float        @default(95.0)
  findings        String
  recommendations String?
  status          AuditStatus  @default(COMPLETED)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  capas           CAPARecord[]
  auditor         User         @relation("QualityAuditor", fields: [auditorId], references: [id])
  department      Department   @relation(fields: [departmentId], references: [id])
  facility        Facility     @relation(fields: [facilityId], references: [id])

  @@map("quality_audits")
}

/// CAPARecord manages Corrective and Preventive Actions across audit findings and incidents.
model CAPARecord {
  id               String          @id @default(uuid())
  capaNumber       String          @unique @map("capa_number")
  facilityId       String          @map("facility_id")
  auditId          String?         @map("audit_id")
  incidentId       String?         @map("incident_id")
  correctiveAction String          @map("corrective_action")
  preventiveAction String          @map("preventive_action")
  ownerId          String          @map("owner_id")
  dueDate          DateTime        @map("due_date")
  status           CAPAStatus      @default(OPEN)
  completedAt      DateTime?       @map("completed_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  audit            QualityAudit?   @relation(fields: [auditId], references: [id])
  facility         Facility        @relation(fields: [facilityId], references: [id])
  incident         IncidentReport? @relation(fields: [incidentId], references: [id])
  owner            User            @relation("CAPAOwner", fields: [ownerId], references: [id])

  @@map("capa_records")
}

/// HandHygieneAudit measures WHO 5-Moments hand hygiene compliance across departments.
model HandHygieneAudit {
  id                   String     @id @default(uuid())
  facilityId           String     @map("facility_id")
  departmentId         String     @map("department_id")
  observerId           String     @map("observer_id")
  compliancePercentage Float      @default(96.5) @map("compliance_percentage")
  observationDate      DateTime   @default(now()) @map("observation_date")
  createdAt            DateTime   @default(now()) @map("created_at")
  department           Department @relation(fields: [departmentId], references: [id])
  facility             Facility   @relation(fields: [facilityId], references: [id])
  observer             User       @relation("HandHygieneObserver", fields: [observerId], references: [id])

  @@map("hand_hygiene_audits")
}

/// SafetyChecklist tracks clinical safety checklists (Pre-Op, Fall Risk, Central Line, Transfusion).
model SafetyChecklist {
  id             String         @id @default(uuid())
  facilityId     String         @map("facility_id")
  patientId      String         @map("patient_id")
  admissionId    String?        @map("admission_id")
  checklistType  String         @map("checklist_type")
  completedById  String         @map("completed_by_id")
  completionDate DateTime       @default(now()) @map("completion_date")
  status         String         @default("COMPLIANT")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  admission      Admission?     @relation(fields: [admissionId], references: [id])
  completedBy    User           @relation("SafetyChecklistCompleter", fields: [completedById], references: [id])
  facility       Facility       @relation(fields: [facilityId], references: [id])
  patient        PatientProfile @relation(fields: [patientId], references: [id])

  @@map("safety_checklists")
}

/// PatientNotification stores direct notifications dispatched to patient portal/mobile app.
model PatientNotification {
  id        String           @id @default(uuid())
  patientId String           @map("patient_id")
  title     String
  message   String
  type      NotificationType @default(REMINDER)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  patient   PatientProfile   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_notifications")
}

/// PatientFeedback captures patient reviews, ratings (1-5 stars), and comments for doctors/appointments.
model PatientFeedback {
  id            String         @id @default(uuid())
  patientId     String         @map("patient_id")
  appointmentId String?        @map("appointment_id")
  doctorId      String?        @map("doctor_id")
  rating        Int
  comments      String?
  createdAt     DateTime       @default(now()) @map("created_at")
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  doctor        DoctorProfile? @relation(fields: [doctorId], references: [id])
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_feedbacks")
}

/// FamilyMember represents linked dependents, spouses, and relatives for family healthcare management.
model FamilyMember {
  id          String         @id @default(uuid())
  patientId   String         @map("patient_id")
  relation    String
  name        String
  dob         DateTime?
  phone       String?
  accessLevel String         @default("FULL") @map("access_level")
  createdAt   DateTime       @default(now()) @map("created_at")
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("family_members")
}

/// PatientDevice tracks mobile push tokens and device platforms (iOS, Android, Web).
model PatientDevice {
  id           String         @id @default(uuid())
  patientId    String         @map("patient_id")
  deviceToken  String         @unique @map("device_token")
  platform     String         @default("IOS")
  lastActiveAt DateTime       @default(now()) @map("last_active_at")
  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_devices")
}

/// HealthGoal manages patient personal wellness and vital targets (e.g., 10,000 steps, BP, Water intake).
model HealthGoal {
  id           String         @id @default(uuid())
  patientId    String         @map("patient_id")
  title        String
  targetValue  Float          @map("target_value")
  currentValue Float          @default(0.0) @map("current_value")
  unit         String
  status       GoalStatus     @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("health_goals")
}

/// BloodDonor records voluntary and replacement blood donor demographics, eligibility, and history.
model BloodDonor {
  id               String          @id @default(uuid())
  donorCode        String          @unique @map("donor_code")
  fullName         String          @map("full_name")
  phone            String
  email            String?
  bloodGroup       BloodGroup      @map("blood_group")
  dateOfBirth      DateTime?       @map("date_of_birth")
  gender           String          @default("OTHER")
  address          String?
  lastDonationDate DateTime?       @map("last_donation_date")
  status           String          @default("ELIGIBLE")
  facilityId       String?         @map("facility_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  donations        BloodDonation[]
  facility         Facility?       @relation(fields: [facilityId], references: [id])

  @@index([facilityId, bloodGroup])
  @@map("blood_donors")
}

/// BloodDonation logs individual donation sessions, physical vitals, and infectious disease screening.
model BloodDonation {
  id                  String               @id @default(uuid())
  donationNumber      String               @unique @map("donation_number")
  donorId             String               @map("donor_id")
  facilityId          String               @map("facility_id")
  donationDate        DateTime             @default(now()) @map("donation_date")
  hemoglobin          Float                @default(13.5)
  bloodPressure       String?              @map("blood_pressure")
  weight              Float?
  status              DonationStatus       @default(COMPLETED)
  infectiousScreening String               @default("NEGATIVE") @map("infectious_screening")
  screeningNotes      String?              @map("screening_notes")
  collectedById       String               @map("collected_by_id")
  createdAt           DateTime             @default(now()) @map("created_at")
  collectedBy         User                 @relation("DonationCollector", fields: [collectedById], references: [id])
  donor               BloodDonor           @relation(fields: [donorId], references: [id], onDelete: Cascade)
  facility            Facility             @relation(fields: [facilityId], references: [id])
  units               BloodInventoryUnit[]

  @@index([facilityId, donationDate])
  @@map("blood_donations")
}

/// BloodInventoryUnit represents separated blood components in cold-chain storage with barcode tracking.
model BloodInventoryUnit {
  id                   String               @id @default(uuid())
  unitNumber           String               @unique @map("unit_number")
  donationId           String?              @map("donation_id")
  facilityId           String               @map("facility_id")
  bloodGroup           BloodGroup           @map("blood_group")
  component            BloodComponent       @default(PACKED_RBC)
  volumeMl             Float                @default(350.0) @map("volume_ml")
  collectionDate       DateTime             @default(now()) @map("collection_date")
  expiryDate           DateTime             @map("expiry_date")
  storageLocation      String               @default("Refrigerator-A1") @map("storage_location")
  status               BloodUnitStatus      @default(AVAILABLE)
  reservedForRequestId String?              @map("reserved_for_request_id")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  discards             BloodDiscardRecord[]
  donation             BloodDonation?       @relation(fields: [donationId], references: [id])
  facility             Facility             @relation(fields: [facilityId], references: [id])
  crossMatches         CrossMatchRecord[]
  transfusions         TransfusionRecord[]

  @@index([facilityId, bloodGroup, status])
  @@index([expiryDate])
  @@map("blood_inventory_units")
}

/// BloodRequest represents a clinician blood requisition for a specific patient.
model BloodRequest {
  id                 String              @id @default(uuid())
  requestNumber      String              @unique @map("request_number")
  patientId          String              @map("patient_id")
  admissionId        String?             @map("admission_id")
  encounterId        String?             @map("encounter_id")
  facilityId         String              @map("facility_id")
  doctorId           String              @map("doctor_id")
  bloodGroup         BloodGroup          @map("blood_group")
  component          BloodComponent      @default(PACKED_RBC)
  unitsRequested     Int                 @default(1) @map("units_requested")
  urgency            String              @default("ROUTINE")
  clinicalIndication String?             @map("clinical_indication")
  status             TransfusionStatus   @default(REQUESTED)
  requiredDate       DateTime            @default(now()) @map("required_date")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  admission          Admission?          @relation(fields: [admissionId], references: [id])
  doctor             DoctorProfile       @relation(fields: [doctorId], references: [id])
  encounter          ClinicalEncounter?  @relation(fields: [encounterId], references: [id])
  facility           Facility            @relation(fields: [facilityId], references: [id])
  patient            PatientProfile      @relation(fields: [patientId], references: [id])
  crossMatches       CrossMatchRecord[]
  transfusions       TransfusionRecord[]

  @@index([facilityId, status])
  @@map("blood_requests")
}

/// CrossMatchRecord stores serological compatibility tests prior to blood release.
model CrossMatchRecord {
  id            String             @id @default(uuid())
  requestId     String             @map("request_id")
  unitId        String             @map("unit_id")
  patientId     String             @map("patient_id")
  compatibility String             @default("COMPATIBLE")
  method        String             @default("AHG_GEL_CARD")
  performedById String             @map("performed_by_id")
  verifiedById  String?            @map("verified_by_id")
  notes         String?
  testedAt      DateTime           @default(now()) @map("tested_at")
  patient       PatientProfile     @relation(fields: [patientId], references: [id])
  performedBy   User               @relation("CrossMatchPerformer", fields: [performedById], references: [id])
  request       BloodRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  unit          BloodInventoryUnit @relation(fields: [unitId], references: [id])
  verifiedBy    User?              @relation("CrossMatchVerifier", fields: [verifiedById], references: [id])

  @@map("cross_match_records")
}

/// TransfusionRecord captures bedside administration, pre/post vital checks, and adverse transfusion reaction telemetry.
model TransfusionRecord {
  id               String             @id @default(uuid())
  requestId        String             @map("request_id")
  unitId           String             @map("unit_id")
  patientId        String             @map("patient_id")
  facilityId       String             @map("facility_id")
  administeredById String             @map("administered_by_id")
  witnessNurseId   String?            @map("witness_nurse_id")
  startTime        DateTime           @default(now()) @map("start_time")
  endTime          DateTime?          @map("end_time")
  status           TransfusionStatus  @default(TRANSFUSED)
  adverseReaction  Boolean            @default(false) @map("adverse_reaction")
  reactionDetails  String?            @map("reaction_details")
  preVitals        String?            @map("pre_vitals")
  postVitals       String?            @map("post_vitals")
  createdAt        DateTime           @default(now()) @map("created_at")
  administeredBy   User               @relation("TransfusionAdmin", fields: [administeredById], references: [id])
  facility         Facility           @relation(fields: [facilityId], references: [id])
  patient          PatientProfile     @relation(fields: [patientId], references: [id])
  request          BloodRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  unit             BloodInventoryUnit @relation(fields: [unitId], references: [id])
  witnessNurse     User?              @relation("TransfusionWitness", fields: [witnessNurseId], references: [id])

  @@index([facilityId, status])
  @@map("transfusion_records")
}

/// BloodDiscardRecord maintains compliance audit logs for expired, hemolyzed, or serology-reactive blood units.
model BloodDiscardRecord {
  id             String             @id @default(uuid())
  unitId         String             @map("unit_id")
  facilityId     String             @map("facility_id")
  discardReason  String             @map("discard_reason")
  authorizedById String             @map("authorized_by_id")
  discardedAt    DateTime           @default(now()) @map("discarded_at")
  authorizedBy   User               @relation("BloodDiscardAuthorizer", fields: [authorizedById], references: [id])
  facility       Facility           @relation(fields: [facilityId], references: [id])
  unit           BloodInventoryUnit @relation(fields: [unitId], references: [id])

  @@index([facilityId, discardedAt])
  @@map("blood_discard_records")
}

/// Invoice represents an enterprise billing statement for outpatient, inpatient, lab, pharmacy, or telemedicine care.
model Invoice {
  id             String               @id @default(uuid())
  invoiceNumber  String               @unique @map("invoice_number")
  patientId      String               @map("patient_id")
  admissionId    String?              @map("admission_id")
  appointmentId  String?              @map("appointment_id")
  facilityId     String               @map("facility_id")
  totalAmount    Float                @default(0.0) @map("total_amount")
  discountAmount Float                @default(0.0) @map("discount_amount")
  taxAmount      Float                @default(0.0) @map("tax_amount")
  netAmount      Float                @default(0.0) @map("net_amount")
  paymentStatus  PaymentStatus        @default(PENDING) @map("payment_status")
  invoiceStatus  InvoiceStatus        @default(GENERATED) @map("invoice_status")
  createdBy      String?              @map("created_by")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  balanceAmount  Float                @default(0.0) @map("balance_amount")
  encounterId    String?              @map("encounter_id")
  paidAmount     Float                @default(0.0) @map("paid_amount")
  status         InvoiceStatus        @default(DRAFT)
  subtotal       Float                @default(0.0)
  items          InvoiceItem[]
  lineItems      InvoiceLineItem[]
  admission      Admission?           @relation(fields: [admissionId], references: [id])
  appointment    Appointment?         @relation(fields: [appointmentId], references: [id])
  creator        User?                @relation("InvoiceCreator", fields: [createdBy], references: [id])
  encounter      ClinicalEncounter?   @relation(fields: [encounterId], references: [id])
  facility       Facility             @relation(fields: [facilityId], references: [id])
  patient        PatientProfile       @relation(fields: [patientId], references: [id])
  payments       PaymentTransaction[]
  refunds        RefundTransaction[]

  @@index([facilityId, createdAt])
  @@index([patientId, paymentStatus])
  @@map("invoices")
}

/// InvoiceItem represents billable itemized charges on an Invoice.
model InvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String          @map("invoice_id")
  category    RevenueCategory @default(OTHER)
  description String
  quantity    Int             @default(1)
  unitPrice   Float           @default(0.0) @map("unit_price")
  totalPrice  Float           @default(0.0) @map("total_price")
  createdAt   DateTime        @default(now()) @map("created_at")
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

/// InvoiceLineItem represents individual billable items, charges, tests, or medication lines on an Invoice.
model InvoiceLineItem {
  id        String   @id @default(uuid())
  invoiceId String   @map("invoice_id")
  category  String
  itemName  String   @map("item_name")
  quantity  Int      @default(1)
  unitPrice Float    @default(0.0) @map("unit_price")
  amount    Float    @default(0.0)
  createdAt DateTime @default(now()) @map("created_at")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// RefundTransaction records approved refunds, credit notes, and reversal vouchers.
model RefundTransaction {
  id           String   @id @default(uuid())
  invoiceId    String   @map("invoice_id")
  amount       Float
  reason       String
  approvedBy   String?  @map("approved_by")
  refundedAt   DateTime @default(now()) @map("refunded_at")
  createdAt    DateTime @default(now()) @map("created_at")
  approvedById String?  @map("approved_by_id")
  approver     User?    @relation("RefundApprover", fields: [approvedBy], references: [id])
  approverUser User?    @relation("RefundApproverUser", fields: [approvedById], references: [id])
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("refund_transactions")
}

/// RevenueLedger tracks departmental revenue entries and financial realizations.
model RevenueLedger {
  id              String          @id @default(uuid())
  facilityId      String          @map("facility_id")
  category        RevenueCategory @default(OTHER)
  amount          Float           @default(0.0)
  sourceReference String?         @map("source_reference")
  transactionDate DateTime        @default(now()) @map("transaction_date")
  createdAt       DateTime        @default(now()) @map("created_at")
  facility        Facility        @relation(fields: [facilityId], references: [id])

  @@index([facilityId, category])
  @@index([transactionDate])
  @@map("revenue_ledgers")
}

/// CostCenter manages departmental budgets, expense allocations, and variance tracking.
model CostCenter {
  id             String   @id @default(uuid())
  facilityId     String   @map("facility_id")
  name           String
  code           String   @unique
  budgetAmount   Float    @default(0.0) @map("budget_amount")
  currentExpense Float    @default(0.0) @map("current_expense")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  facility       Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
  @@map("cost_centers")
}

/// GeneralLedgerAccount maintains chart of accounts for double-entry bookkeeping.
model GeneralLedgerAccount {
  id             String         @id @default(uuid())
  facilityId     String?        @map("facility_id")
  accountCode    String         @unique @map("account_code")
  accountName    String         @map("account_name")
  accountType    AccountType    @map("account_type")
  openingBalance Float          @default(0.0) @map("opening_balance")
  currentBalance Float          @default(0.0) @map("current_balance")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  facility       Facility?      @relation(fields: [facilityId], references: [id])
  creditEntries  JournalEntry[] @relation("CreditAccount")
  debitEntries   JournalEntry[] @relation("DebitAccount")

  @@index([facilityId, accountType])
  @@map("general_ledger_accounts")
}

/// JournalEntry records balanced double-entry vouchers (debit and credit legs).
model JournalEntry {
  id              String               @id @default(uuid())
  entryNumber     String               @unique @map("entry_number")
  debitAccountId  String               @map("debit_account_id")
  creditAccountId String               @map("credit_account_id")
  amount          Float
  narration       String
  postedBy        String               @map("posted_by")
  postedAt        DateTime             @default(now()) @map("posted_at")
  creditAccount   GeneralLedgerAccount @relation("CreditAccount", fields: [creditAccountId], references: [id])
  debitAccount    GeneralLedgerAccount @relation("DebitAccount", fields: [debitAccountId], references: [id])
  poster          User                 @relation("JournalPoster", fields: [postedBy], references: [id])

  @@index([postedAt])
  @@map("journal_entries")
}

/// FinancialAuditLog maintains an immutable audit trail of all billing, refund, and GL posting transactions.
model FinancialAuditLog {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  facilityId String?   @map("facility_id")
  action     String
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  timestamp  DateTime  @default(now())
  metadata   String?
  facility   Facility? @relation(fields: [facilityId], references: [id])
  user       User      @relation("FinancialAuditor", fields: [userId], references: [id])

  @@index([facilityId, timestamp])
  @@map("financial_audit_logs")
}

/// AbhaProfile links a patient to their National Ayushman Bharat Health Account (ABHA).
model AbhaProfile {
  id          String         @id @default(uuid())
  patientId   String         @unique @map("patient_id")
  abhaNumber  String         @unique @map("abha_number")
  abhaAddress String         @unique @map("abha_address")
  mobile      String?
  linked      Boolean        @default(false)
  verifiedAt  DateTime?      @map("verified_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("abha_profiles")
}

/// AbdmConsent tracks electronic consent artefacts for health information exchange (HIP/HIU).
model AbdmConsent {
  id               String              @id @default(uuid())
  patientId        String              @map("patient_id")
  facilityId       String              @map("facility_id")
  consentReference String              @unique @map("consent_reference")
  purpose          String
  status           AbdmConsentStatus   @default(REQUESTED)
  requestedAt      DateTime            @default(now()) @map("requested_at")
  approvedAt       DateTime?           @map("approved_at")
  expiresAt        DateTime?           @map("expires_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  facility         Facility            @relation(fields: [facilityId], references: [id])
  patient          PatientProfile      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sharedRecords    HealthRecordShare[]

  @@index([facilityId, patientId, status])
  @@map("abdm_consents")
}

/// HealthRecordShare tracks cross-hospital diagnostic and clinical record exchanges under consent.
model HealthRecordShare {
  id               String         @id @default(uuid())
  patientId        String         @map("patient_id")
  recordType       AbdmRecordType @map("record_type")
  sourceFacilityId String         @map("source_facility_id")
  targetFacilityId String?        @map("target_facility_id")
  consentId        String         @map("consent_id")
  recordReference  String?        @map("record_reference")
  sharedAt         DateTime       @default(now()) @map("shared_at")
  consent          AbdmConsent    @relation(fields: [consentId], references: [id], onDelete: Cascade)
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sourceFacility   Facility       @relation("SourceFacilityShares", fields: [sourceFacilityId], references: [id])
  targetFacility   Facility?      @relation("TargetFacilityShares", fields: [targetFacilityId], references: [id])

  @@index([patientId, consentId])
  @@map("health_record_shares")
}

/// AbdmAuditLog provides immutable audit trailing for ABDM transactions and data exchanges.
model AbdmAuditLog {
  id          String   @id @default(uuid())
  facilityId  String   @map("facility_id")
  patientId   String?  @map("patient_id")
  action      String
  details     String?
  performedBy String   @map("performed_by")
  createdAt   DateTime @default(now()) @map("created_at")
  facility    Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId, createdAt])
  @@map("abdm_audit_logs")
}

/// MedicalDevice tracks IoT and bedside medical hardware across hospital facilities.
model MedicalDevice {
  id                String               @id @default(uuid())
  facilityId        String               @map("facility_id")
  deviceName        String               @map("device_name")
  serialNumber      String               @unique @map("serial_number")
  deviceType        DeviceType           @map("device_type")
  manufacturer      String?
  modelNumber       String?              @map("model_number")
  status            DeviceStatus         @default(ONLINE)
  assignedPatientId String?              @map("assigned_patient_id")
  assignedBedId     String?              @map("assigned_bed_id")
  lastHeartbeatAt   DateTime?            @map("last_heartbeat_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  assignedBed       Bed?                 @relation(fields: [assignedBedId], references: [id])
  assignedPatient   PatientProfile?      @relation(fields: [assignedPatientId], references: [id])
  facility          Facility             @relation(fields: [facilityId], references: [id])
  alerts            PatientAlert[]
  vitalStreams      PatientVitalStream[]

  @@index([facilityId, status])
  @@index([assignedPatientId])
  @@map("medical_devices")
}

/// PatientVitalStream captures real-time vital telemetry streams from connected bedside devices.
model PatientVitalStream {
  id              String         @id @default(uuid())
  patientId       String         @map("patient_id")
  facilityId      String         @map("facility_id")
  deviceId        String         @map("device_id")
  heartRate       Float?         @map("heart_rate")
  systolicBP      Float?         @map("systolic_bp")
  diastolicBP     Float?         @map("diastolic_bp")
  spo2            Float?
  respiratoryRate Float?         @map("respiratory_rate")
  temperature     Float?
  bloodGlucose    Float?         @map("blood_glucose")
  recordedAt      DateTime       @default(now()) @map("recorded_at")
  device          MedicalDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  facility        Facility       @relation(fields: [facilityId], references: [id])
  patient         PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, recordedAt])
  @@index([facilityId, recordedAt])
  @@map("patient_vital_streams")
}

/// PatientAlert manages automated critical telemetry thresholds and clinical alarms.
model PatientAlert {
  id               String         @id @default(uuid())
  patientId        String         @map("patient_id")
  facilityId       String         @map("facility_id")
  deviceId         String?        @map("device_id")
  severity         AlertSeverity
  alertType        String         @map("alert_type")
  message          String
  acknowledged     Boolean        @default(false)
  acknowledgedById String?        @map("acknowledged_by_id")
  acknowledgedAt   DateTime?      @map("acknowledged_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  acknowledgedBy   User?          @relation("AcknowledgedPatientAlerts", fields: [acknowledgedById], references: [id])
  device           MedicalDevice? @relation(fields: [deviceId], references: [id])
  facility         Facility       @relation(fields: [facilityId], references: [id])
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([facilityId, acknowledged, severity])
  @@index([patientId, createdAt])
  @@map("patient_alerts")
}

/// ClinicalRule defines active CDSS rule-based safety evaluation triggers.
model ClinicalRule {
  id          String           @id @default(uuid())
  facilityId  String?          @map("facility_id")
  ruleType    ClinicalRuleType @map("rule_type")
  title       String
  description String
  severity    AlertSeverity    @default(HIGH)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  facility    Facility?        @relation(fields: [facilityId], references: [id])

  @@index([ruleType, active])
  @@map("clinical_rules")
}

/// DrugInteraction records pairwise drug-drug interaction matrix and recommendations.
model DrugInteraction {
  id                     String        @id @default(uuid())
  drugA                  String        @map("drug_a")
  drugB                  String        @map("drug_b")
  severity               AlertSeverity @default(HIGH)
  interactionDescription String        @map("interaction_description")
  recommendation         String
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  @@unique([drugA, drugB])
  @@index([drugA])
  @@index([drugB])
  @@map("drug_interactions")
}

/// PatientAllergy records verified patient allergies with reaction and severity profile.
model PatientAllergy {
  id           String         @id @default(uuid())
  patientId    String         @map("patient_id")
  allergen     String
  reaction     String
  severity     AlertSeverity  @default(HIGH)
  recordedById String?        @map("recorded_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy   User?          @relation("AllergyRecorder", fields: [recordedById], references: [id])

  @@index([patientId, allergen])
  @@map("patient_allergies")
}

/// MedicationSafetyAudit tracks clinical alert overrides and doctor safety justifications.
model MedicationSafetyAudit {
  id                String         @id @default(uuid())
  medicationOrderId String?        @map("medication_order_id")
  doctorId          String         @map("doctor_id")
  patientId         String         @map("patient_id")
  facilityId        String?        @map("facility_id")
  alertCount        Int            @default(0) @map("alert_count")
  overrideReason    String?        @map("override_reason")
  createdAt         DateTime       @default(now()) @map("created_at")
  doctor            User           @relation("SafetyAuditor", fields: [doctorId], references: [id])
  facility          Facility?      @relation(fields: [facilityId], references: [id])
  patient           PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, doctorId])
  @@map("medication_safety_audits")
}

/// IcuAdmission tracks critical care inpatient admissions, bed stays, and disease acuity scores.
model IcuAdmission {
  id           String              @id @default(uuid())
  patientId    String              @map("patient_id")
  admissionId  String?             @map("admission_id")
  facilityId   String              @map("facility_id")
  bedId        String?             @map("bed_id")
  status       IcuPatientStatus    @default(ADMITTED)
  apacheScore  Int?                @map("apache_score")
  sofaScore    Int?                @map("sofa_score")
  admittedAt   DateTime            @default(now()) @map("admitted_at")
  dischargedAt DateTime?           @map("discharged_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  alerts       CriticalCareAlert[]
  admission    Admission?          @relation(fields: [admissionId], references: [id])
  bed          Bed?                @relation(fields: [bedId], references: [id])
  facility     Facility            @relation(fields: [facilityId], references: [id])
  patient      PatientProfile      @relation(fields: [patientId], references: [id])
  vitals       IcuVitalsMonitor[]

  @@index([facilityId, patientId])
  @@map("icu_admissions")
}

/// Ventilator manages life-support respiratory mechanical ventilators across ICU pods.
model Ventilator {
  id               String                 @id @default(uuid())
  facilityId       String                 @map("facility_id")
  ventilatorNumber String                 @unique @map("ventilator_number")
  manufacturer     String
  model            String
  status           VentilatorStatus       @default(AVAILABLE)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  assignments      VentilatorAssignment[]
  facility         Facility               @relation(fields: [facilityId], references: [id])

  @@index([facilityId, status])
  @@map("ventilators")
}

/// VentilatorAssignment records active and historical ventilator sessions for ICU patients.
model VentilatorAssignment {
  id           String         @id @default(uuid())
  ventilatorId String         @map("ventilator_id")
  patientId    String         @map("patient_id")
  assignedById String         @map("assigned_by_id")
  assignedAt   DateTime       @default(now()) @map("assigned_at")
  removedAt    DateTime?      @map("removed_at")
  assignedBy   User           @relation("VentilatorAssigner", fields: [assignedById], references: [id])
  patient      PatientProfile @relation(fields: [patientId], references: [id])
  ventilator   Ventilator     @relation(fields: [ventilatorId], references: [id], onDelete: Cascade)

  @@index([ventilatorId, patientId])
  @@map("ventilator_assignments")
}

/// IcuVitalsMonitor continuously tracks high-frequency ICU vitals and hemodynamic flowsheets.
model IcuVitalsMonitor {
  id               String         @id @default(uuid())
  patientId        String         @map("patient_id")
  icuAdmissionId   String?        @map("icu_admission_id")
  heartRate        Float          @map("heart_rate")
  respiratoryRate  Float          @map("respiratory_rate")
  oxygenSaturation Float          @map("oxygen_saturation")
  systolicBP       Float          @map("systolic_bp")
  diastolicBP      Float          @map("diastolic_bp")
  temperature      Float
  urineOutput      Float?         @map("urine_output")
  recordedAt       DateTime       @default(now()) @map("recorded_at")
  icuAdmission     IcuAdmission?  @relation(fields: [icuAdmissionId], references: [id])
  patient          PatientProfile @relation(fields: [patientId], references: [id])

  @@index([patientId, recordedAt])
  @@map("icu_vitals_monitors")
}

/// IcuRound documents multidisciplinary intensivist daily ICU bedside rounds and interventions.
model IcuRound {
  id            String         @id @default(uuid())
  patientId     String         @map("patient_id")
  doctorId      String         @map("doctor_id")
  diagnosis     String
  assessment    String
  treatmentPlan String         @map("treatment_plan")
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  doctor        DoctorProfile  @relation(fields: [doctorId], references: [id])
  patient       PatientProfile @relation(fields: [patientId], references: [id])

  @@index([patientId, doctorId])
  @@map("icu_rounds")
}

/// CodeBlueEvent manages cardiac arrest, rapid response activations, and resuscitation workflows.
model CodeBlueEvent {
  id            String          @id @default(uuid())
  patientId     String?         @map("patient_id")
  facilityId    String          @map("facility_id")
  triggeredById String          @map("triggered_by_id")
  eventLocation String          @map("event_location")
  eventSummary  String          @map("event_summary")
  outcome       String?
  startedAt     DateTime        @default(now()) @map("started_at")
  completedAt   DateTime?       @map("completed_at")
  facility      Facility        @relation(fields: [facilityId], references: [id])
  patient       PatientProfile? @relation(fields: [patientId], references: [id])
  triggeredBy   User            @relation("CodeBlueTriggerer", fields: [triggeredById], references: [id])

  @@index([facilityId, startedAt])
  @@map("code_blue_events")
}

/// CriticalCareAlert alerts clinicians on acute hemodynamic deterioration, low SpO2, and EWS triggers.
model CriticalCareAlert {
  id               String                @id @default(uuid())
  patientId        String                @map("patient_id")
  icuAdmissionId   String?               @map("icu_admission_id")
  severity         CriticalAlertSeverity @default(CRITICAL)
  title            String
  description      String
  acknowledged     Boolean               @default(false)
  acknowledgedById String?               @map("acknowledged_by_id")
  acknowledgedAt   DateTime?             @map("acknowledged_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  acknowledgedBy   User?                 @relation("CriticalCareAlertAcknowledger", fields: [acknowledgedById], references: [id])
  icuAdmission     IcuAdmission?         @relation(fields: [icuAdmissionId], references: [id])
  patient          PatientProfile        @relation(fields: [patientId], references: [id])

  @@index([patientId, acknowledged])
  @@map("critical_care_alerts")
}

/// RevenueCycle provides macro financial tracking for patient encounters from billing through reconciliation.
model RevenueCycle {
  id              String         @id @default(uuid())
  facilityId      String         @map("facility_id")
  patientId       String         @map("patient_id")
  admissionId     String?        @map("admission_id")
  billId          String?        @map("bill_id")
  grossAmount     Float          @map("gross_amount")
  discounts       Float          @default(0)
  taxes           Float          @default(0)
  netAmount       Float          @map("net_amount")
  amountCollected Float          @default(0) @map("amount_collected")
  balanceAmount   Float          @map("balance_amount")
  revenueStatus   RevenueStatus  @default(PENDING) @map("revenue_status")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  admission       Admission?     @relation(fields: [admissionId], references: [id])
  facility        Facility       @relation(fields: [facilityId], references: [id])
  patient         PatientProfile @relation(fields: [patientId], references: [id])

  @@index([facilityId, revenueStatus])
  @@map("revenue_cycles")
}

/// AccountsReceivable tracks individual outstanding patient, insurance, or corporate balances.
model AccountsReceivable {
  id                 String               @id @default(uuid())
  receivableNumber   String               @unique @map("receivable_number")
  receivableType     ReceivableType       @map("receivable_type")
  patientId          String?              @map("patient_id")
  insuranceClaimId   String?              @map("insurance_claim_id")
  corporateInvoiceId String?              @map("corporate_invoice_id")
  facilityId         String?              @map("facility_id")
  totalAmount        Float                @map("total_amount")
  outstandingAmount  Float                @map("outstanding_amount")
  dueDate            DateTime             @map("due_date")
  agingDays          Int                  @default(0) @map("aging_days")
  collectionStatus   CollectionStatus     @default(OPEN) @map("collection_status")
  assignedToId       String?              @map("assigned_to_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  assignedTo         User?                @relation("ReceivableAssignee", fields: [assignedToId], references: [id])
  corporateInvoice   CorporateInvoice?    @relation(fields: [corporateInvoiceId], references: [id])
  facility           Facility?            @relation(fields: [facilityId], references: [id])
  insuranceClaim     InsuranceClaim?      @relation(fields: [insuranceClaimId], references: [id])
  patient            PatientProfile?      @relation(fields: [patientId], references: [id])
  activities         CollectionActivity[]

  @@index([facilityId, collectionStatus])
  @@index([receivableType, agingDays])
  @@map("accounts_receivables")
}

/// CollectionActivity logs recovery interventions (calls, notices, promises to pay).
model CollectionActivity {
  id               String             @id @default(uuid())
  receivableId     String             @map("receivable_id")
  activityType     String             @map("activity_type")
  notes            String
  performedById    String             @map("performed_by_id")
  nextFollowUpDate DateTime?          @map("next_follow_up_date")
  createdAt        DateTime           @default(now()) @map("created_at")
  performedBy      User               @relation("CollectionPerformer", fields: [performedById], references: [id])
  receivable       AccountsReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([receivableId, createdAt])
  @@map("collection_activities")
}

/// CorporateContract registers corporate partnerships, credit caps, and payment credit terms.
model CorporateContract {
  id               String             @id @default(uuid())
  facilityId       String?            @map("facility_id")
  companyName      String             @map("company_name")
  contractNumber   String             @unique @map("contract_number")
  contactPerson    String             @map("contact_person")
  email            String
  phone            String
  creditLimit      Float              @map("credit_limit")
  paymentTermsDays Int                @default(30) @map("payment_terms_days")
  active           Boolean            @default(true)
  startDate        DateTime           @map("start_date")
  endDate          DateTime           @map("end_date")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  facility         Facility?          @relation(fields: [facilityId], references: [id])
  invoices         CorporateInvoice[]

  @@index([companyName, active])
  @@map("corporate_contracts")
}

/// CorporateInvoice records consolidated corporate billing invoices.
model CorporateInvoice {
  id            String               @id @default(uuid())
  invoiceNumber String               @unique @map("invoice_number")
  contractId    String               @map("contract_id")
  amount        Float
  dueDate       DateTime             @map("due_date")
  paidAmount    Float                @default(0) @map("paid_amount")
  balanceAmount Float                @map("balance_amount")
  status        String               @default("GENERATED")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  receivables   AccountsReceivable[]
  contract      CorporateContract    @relation(fields: [contractId], references: [id])

  @@index([contractId, status])
  @@map("corporate_invoices")
}

/// PaymentAllocation allocates lumpsum or multi-party remittances against receivables/invoices.
model PaymentAllocation {
  id               String   @id @default(uuid())
  paymentReference String   @map("payment_reference")
  amount           Float
  allocatedTo      String   @map("allocated_to")
  allocationDate   DateTime @default(now()) @map("allocation_date")
  notes            String?
  facilityId       String?  @map("facility_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("payment_allocations")
}

/// RevenueForecast projects future hospital revenues, collections, and AR pipelines.
model RevenueForecast {
  id                   String   @id @default(uuid())
  facilityId           String   @map("facility_id")
  forecastMonth        String   @map("forecast_month")
  projectedRevenue     Float    @map("projected_revenue")
  projectedCollections Float    @map("projected_collections")
  projectedOutstanding Float    @map("projected_outstanding")
  createdAt            DateTime @default(now()) @map("created_at")
  facility             Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId, forecastMonth])
  @@map("revenue_forecasts")
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
