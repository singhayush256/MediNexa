/// TelemedicineSession models virtual video consultation rooms between doctors and patients.
model TelemedicineSession {
  id                 String                          @id @default(uuid())
  appointmentId      String?                         @unique @map("appointment_id")
  facilityId         String                          @map("facility_id")
  patientId          String                          @map("patient_id")
  doctorId           String                          @map("doctor_id")
  roomName           String                          @unique @map("room_name")
  roomToken          String?                         @map("room_token")
  status             SessionStatus                   @default(SCHEDULED)
  scheduledStartTime DateTime                        @default(now()) @map("scheduled_start_time")
  actualStartTime    DateTime?                       @map("actual_start_time")
  endTime            DateTime?                       @map("end_time")
  durationMinutes    Int?                            @map("duration_minutes")
  notes              String?
  createdAt          DateTime                        @default(now()) @map("created_at")
  updatedAt          DateTime                        @updatedAt @map("updated_at")
  chatMessages       TelemedicineChatMessage[]
  participants       TelemedicineParticipant[]
  recordings         TelemedicineRecordingMetadata[]
  appointment        Appointment?                    @relation(fields: [appointmentId], references: [id])
  doctor             DoctorProfile                   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facility           Facility                        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient            PatientProfile                  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([facilityId, status])
  @@index([patientId, doctorId])
  @@map("telemedicine_sessions")
}

/// TelemedicineParticipant tracks room joins, role, and exit timestamps.
model TelemedicineParticipant {
  id         String              @id @default(uuid())
  sessionId  String              @map("session_id")
  userId     String              @map("user_id")
  role       ParticipantRole
  joinedAt   DateTime            @default(now()) @map("joined_at")
  leftAt     DateTime?           @map("left_at")
  deviceInfo String?             @map("device_info")
  session    TelemedicineSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, userId])
  @@map("telemedicine_participants")
}

/// TelemedicineChatMessage logs real-time in-consultation messages.
model TelemedicineChatMessage {
  id         String              @id @default(uuid())
  sessionId  String              @map("session_id")
  senderId   String              @map("sender_id")
  senderName String              @map("sender_name")
  senderRole ParticipantRole     @map("sender_role")
  message    String
  sentAt     DateTime            @default(now()) @map("sent_at")
  sender     User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  session    TelemedicineSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, sentAt])
  @@map("telemedicine_chat_messages")
}

/// TelemedicineRecordingMetadata logs video session archive metadata.
model TelemedicineRecordingMetadata {
  id              String              @id @default(uuid())
  sessionId       String              @map("session_id")
  fileUrl         String              @map("file_url")
  fileSizeBytes   Int?                @map("file_size_bytes")
  durationSeconds Int?                @map("duration_seconds")
  createdAt       DateTime            @default(now()) @map("created_at")
  session         TelemedicineSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("telemedicine_recording_metadata")
}

/// ClinicalAlert stores real-time AI safety alerts for inpatients and ED visits.
model ClinicalAlert {
  id                String         @id @default(uuid())
  facilityId        String         @map("facility_id")
  patientId         String         @map("patient_id")
  admissionId       String?        @map("admission_id")
  type              AlertType
  severity          AlertSeverity
  title             String
  description       String
  isResolved        Boolean        @default(false) @map("is_resolved")
  resolvedById      String?        @map("resolved_by_id")
  resolvedAt        DateTime?      @map("resolved_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  acknowledged      Boolean        @default(false)
  acknowledgedAt    DateTime?      @map("acknowledged_at")
  acknowledgedById  String?        @map("acknowledged_by_id")
  doctorId          String?        @map("doctor_id")
  encounterId       String?        @map("encounter_id")
  medicationOrderId String?        @map("medication_order_id")
  acknowledgedBy    User?          @relation("CdssAlertAcknowledger", fields: [acknowledgedById], references: [id])
  admission         Admission?     @relation(fields: [admissionId], references: [id])
  facility          Facility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient           PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  resolvedBy        User?          @relation("AlertResolver", fields: [resolvedById], references: [id])

  @@index([facilityId, isResolved])
  @@index([patientId, severity])
  @@map("clinical_alerts")
}

/// PatientRiskScore records 0-100 patient risk evaluations for sepsis, readmission, and fall risk.
model PatientRiskScore {
  id               String         @id @default(uuid())
  facilityId       String         @map("facility_id")
  patientId        String         @map("patient_id")
  admissionId      String?        @map("admission_id")
  overallRiskScore Int            @default(10) @map("overall_risk_score")
  sepsisRisk       Int            @default(10) @map("sepsis_risk")
  readmissionRisk  Int            @default(15) @map("readmission_risk")
  fallRisk         Int            @default(10) @map("fall_risk")
  riskFactors      String?        @map("risk_factors")
  evaluatedAt      DateTime       @default(now()) @map("evaluated_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  admission        Admission?     @relation(fields: [admissionId], references: [id])
  facility         Facility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([facilityId, overallRiskScore])
  @@index([patientId, evaluatedAt])
  @@map("patient_risk_scores")
}

/// HospitalPrediction logs capacity, surge, and occupancy forecasts generated by the AI platform.
model HospitalPrediction {
