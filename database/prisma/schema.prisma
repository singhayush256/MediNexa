  dateOfBirth        DateTime            @map("date_of_birth")
  gender             String
  bloodGroup         String?             @map("blood_group")
  phone              String?
  address            String?
  status             String              @default("ACTIVE")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  // Relations
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  emergencyContacts  EmergencyContact[]
  bedReservations    BedReservation[]
  bedAssignments     BedAssignment[]
  bedHistories       BedStatusHistory[]
  admissions         Admission[]
  admissionTransfers AdmissionTransfer[]
  encounters         ClinicalEncounter[]
  vitalSigns         VitalSign[]
  diagnoses          Diagnosis[]
  labOrders          LabOrder[]
  specimens          Specimen[]
  labResults         LabResult[]
  prescriptions      Prescription[]
  emergencyRequests  EmergencyRequest[]
  referrals          HospitalReferral[]
  crossFacilityTransfers CrossFacilityTransfer[]
  recordAuthorizations MedicalRecordTransferAuthorization[]
  appointments       Appointment[]
  medicationReminders MedicationReminder[]
  attachments        FileAttachment[]
  opdTokens          OpdToken[]
  emergencyVisits    EmergencyVisit[]
  medicationAdministrations MedicationAdministration[]
  vitalsFlowsheets    VitalsFlowsheet[]
  dischargeSummaries  DischargeSummary[]
  telemedicineSessions TelemedicineSession[]
  clinicalAlerts      ClinicalAlert[]
  riskScores          PatientRiskScore[]
  clinicalRecommendations ClinicalRecommendation[]
  aiSummaries          AiGeneratedSummary[]
  imagingOrders        ImagingOrder[]
  medicationOrders     MedicationOrder[]
  pharmacyDispenseRecords PharmacyDispenseRecord[]
  controlledAudits     ControlledSubstanceAudit[]
  surgeries            SurgerySchedule[]
  billingInvoices      BillingInvoice[]
  insuranceClaims      InsuranceClaim[]
  infectionCases       InfectionCase[]
  incidentReports      IncidentReport[]
  safetyChecklists     SafetyChecklist[]

  @@map("patient_profiles")
}

/// EmergencyContact records emergency contact individuals for a Patient.
model EmergencyContact {
  id           String         @id @default(uuid())
  patientId    String         @map("patient_id")
  name         String
  relationship String
  phone        String
  email        String?
  address      String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relations
  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

/// DoctorProfile links a medical provider User to their assigned Facility, Department, and Specialty.
model DoctorProfile {
  id                String              @id @default(uuid())
  userId            String              @unique @map("user_id")
  facilityId        String              @map("facility_id")
  departmentId      String              @map("department_id")
  specialtyId       String              @map("specialty_id")
  licenseNumber     String              @unique @map("license_number")
  status            String              @default("ACTIVE")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility          Facility            @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  department        Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  specialty         Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  encounters        ClinicalEncounter[]
  labOrders         LabOrder[]
  prescriptions     Prescription[]
  referredOut       HospitalReferral[]  @relation("ReferringDoctor")
  referredIn        HospitalReferral[]  @relation("ReceivingDoctor")
  appointments      Appointment[]
  schedules         DoctorSchedule[]
  guestBookings     GuestBooking[]
  opdTokens         OpdToken[]
  emergencyVisits   EmergencyVisit[]
  dischargeSummaries DischargeSummary[]
  telemedicineSessions TelemedicineSession[]
  aiSummaries          AiGeneratedSummary[]
  imagingOrders        ImagingOrder[]
  radiologyReports     RadiologyReport[]
  medicationOrders     MedicationOrder[]

  @@map("doctor_profiles")
}

// =========================================================================
// DAY 10 — APPOINTMENTS, NOTIFICATIONS, REMINDERS, ANALYTICS, SEARCH & AI MODELS
// =========================================================================

enum AppointmentType {
  IN_PERSON
  VIDEO
  FOLLOW_UP
  EMERGENCY
  CONSULTATION
  PROCEDURE
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum ScheduleStatus {
  ACTIVE
  INACTIVE
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  EMERGENCY_ALERT
  AMBULANCE_ASSIGNED
  REFERRAL_REQUESTED
  REFERRAL_ACCEPTED
  REFERRAL_REJECTED
  BED_RESERVED
  BED_AVAILABLE
  LAB_RESULT_READY
  PRESCRIPTION_ISSUED
  PRESCRIPTION_DISPENSED
  MEDICATION_REMINDER
  SYSTEM
}

enum ReminderStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

/// Appointment records scheduled patient-doctor consultations.
model Appointment {
  id                 String            @id @default(uuid())
  appointmentNumber  String            @unique @map("appointment_number")
  patientId          String            @map("patient_id")
  doctorId           String            @map("doctor_id")
  facilityId         String            @map("facility_id")
  departmentId       String            @map("department_id")
  specialtyId        String?           @map("specialty_id")
  encounterId        String?           @map("encounter_id")
  appointmentDate    DateTime          @map("appointment_date") @db.Date
  startTime          String            @map("start_time")
  endTime            String            @map("end_time")
  type               AppointmentType   @default(CONSULTATION)
  status             AppointmentStatus @default(REQUESTED)
  reason             String
  notes              String?
  cancellationReason String?           @map("cancellation_reason")
  cancelledAt        DateTime?         @map("cancelled_at")
  completedAt        DateTime?         @map("completed_at")
  checkedInAt        DateTime?         @map("checked_in_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  // Relations
  patient            PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor             DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facility           Facility          @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  department         Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  specialty          Specialty?        @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  encounter          ClinicalEncounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  telemedicineSession TelemedicineSession?

  @@unique([doctorId, appointmentDate, startTime])
  @@index([patientId, appointmentDate])
  @@index([facilityId, appointmentDate])
  @@index([status])
  @@map("appointments")
}

/// DoctorSchedule defines configured availability slots for doctors.
model DoctorSchedule {
  id                  String         @id @default(uuid())
  doctorId            String         @map("doctor_id")
  facilityId          String         @map("facility_id")
  departmentId        String         @map("department_id")
  dayOfWeek           Int            @map("day_of_week")
  startTime           String         @map("start_time")
  endTime             String         @map("end_time")
  slotDurationMinutes Int            @default(30) @map("slot_duration_minutes")
  status              ScheduleStatus @default(ACTIVE)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  // Relations
  doctor              DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facility            Facility       @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  department          Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([doctorId, facilityId])
  @@map("doctor_schedules")
}

/// Notification stores in-app notifications for users.
model Notification {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  type       NotificationType
  title      String
  message    String
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  // Relations
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// MedicationReminder tracks personal patient medication schedule reminders.
model MedicationReminder {
  id                 String           @id @default(uuid())
  patientId          String           @map("patient_id")
  prescriptionItemId String           @map("prescription_item_id")
  scheduledTime      String           @map("scheduled_time")
  frequency          String           @default("DAILY")
  status             ReminderStatus   @default(ACTIVE)
  lastTakenAt        DateTime?        @map("last_taken_at")
  skippedAt          DateTime?        @map("skipped_at")
  lastNotifiedAt     DateTime?        @map("last_notified_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  // Relations
  patient            PatientProfile   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Cascade)

  @@index([patientId, status])
  @@map("medication_reminders")
}

/// AiInteractionAudit tracks queries submitted to the AI assistant.
model AiInteractionAudit {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  role           String
  facilityId     String?  @map("facility_id")
  requestSummary String   @map("request_summary")
  contextType    String?  @map("context_type")
  contextId      String?  @map("context_id")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_interaction_audits")
}

/// AuditEvent logs system security and administrative actions.
model AuditEvent {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  role       String?
  facilityId String?  @map("facility_id")
  action     String
  resource   String
  details    String?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_events")
}

/// GuestPatient stores demographics for unauthenticated patient bookings.
model GuestPatient {
  id        String    @id @default(uuid())
  name      String
  phone     String    @unique
  email     String?
  age       Int?
  gender    String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  bookings  GuestBooking[]

  @@map("guest_patients")
}

/// GuestBooking records public unauthenticated doctor appointment reservations.
model GuestBooking {
  id              String            @id @default(uuid())
  bookingNumber   String            @unique @map("booking_number")
  guestPatientId  String            @map("guest_patient_id")
  doctorId        String            @map("doctor_id")
  facilityId      String            @map("facility_id")
  departmentId    String?           @map("department_id")
  appointmentDate DateTime          @map("appointment_date")
  startTime       String            @map("start_time")
  endTime         String            @map("end_time")
  reason          String
  status          AppointmentStatus @default(REQUESTED)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relations
  guestPatient    GuestPatient      @relation(fields: [guestPatientId], references: [id], onDelete: Cascade)
  doctor          DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facility        Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([doctorId, appointmentDate, startTime])
  @@map("guest_bookings")
}

/// OtpVerification manages phone OTP verification lifecycle.
model OtpVerification {
  id        String   @id @default(uuid())
  phone     String
  otpHash   String   @map("otp_hash")
  purpose   String   @default("GUEST_BOOKING")
  expiresAt DateTime @map("expires_at")
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@map("otp_verifications")
}

enum AttachmentCategory {
  LAB_REPORT
  PRESCRIPTION
  XRAY
  MRI
  CT_SCAN
  ULTRASOUND
  DISCHARGE_SUMMARY
  PATIENT_ID_PROOF
  INSURANCE_DOCUMENT
  GENERAL_DOCUMENT
}

/// FileAttachment stores metadata for uploaded diagnostic images and medical records.
model FileAttachment {
  id           String             @id @default(uuid())
  fileName     String             @map("file_name")
  mimeType     String             @map("mime_type")
  fileSize     Int                @map("file_size")
  storageKey   String             @unique @map("storage_key")
  publicUrl    String?            @map("public_url")
  checksum     String?
  category     AttachmentCategory @default(GENERAL_DOCUMENT)
  patientId    String             @map("patient_id")
  facilityId   String             @map("facility_id")
  uploadedById String             @map("uploaded_by_id")
  encounterId  String?            @map("encounter_id")
  admissionId  String?            @map("admission_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  // Relations
  patient      PatientProfile     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility     Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  uploadedBy   User               @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  audits       AttachmentAudit[]

  @@index([patientId, category])
  @@index([facilityId, createdAt])
  @@map("file_attachments")
}

/// AttachmentAudit logs file views, downloads, uploads, and deletions for security compliance.
model AttachmentAudit {
  id           String         @id @default(uuid())
  attachmentId String         @map("attachment_id")
  action       String
  userId       String         @map("user_id")
  userRole     String         @map("user_role")
  facilityId   String         @map("facility_id")
  ipAddress    String?        @map("ip_address")
  createdAt    DateTime       @default(now()) @map("created_at")

  // Relations
  attachment   FileAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([attachmentId, createdAt])
  @@map("attachment_audits")
}

enum TokenStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum TokenPriority {
  NORMAL
  URGENT
  EMERGENCY
}

/// OpdToken stores OPD walk-in queue token reservations and status transitions.
model OpdToken {
  id                   String        @id @default(uuid())
  tokenNumber          String        @unique @map("token_number")
  queueNumber          Int           @map("queue_number")
  patientId            String?       @map("patient_id")
  patientName          String        @map("patient_name")
  patientPhone         String?       @map("patient_phone")
  doctorId             String        @map("doctor_id")
  facilityId           String        @map("facility_id")
  departmentId         String?       @map("department_id")
  status               TokenStatus   @default(WAITING)
  priority             TokenPriority @default(NORMAL)
  estimatedWaitMinutes Int           @default(15) @map("estimated_wait_minutes")
  notes                String?
  calledAt             DateTime?     @map("called_at")
  startedAt            DateTime?     @map("started_at")
  completedAt          DateTime?     @map("completed_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  // Relations
  patient              PatientProfile? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  doctor               DoctorProfile   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facility             Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  department           Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([doctorId, createdAt, status])
  @@index([facilityId, createdAt])
  @@map("opd_tokens")
}

enum TriageLevel {
  ESI_1
  ESI_2
  ESI_3
  ESI_4
  ESI_5
}

enum ArrivalMode {
  AMBULANCE
  WALK_IN
  REFERRAL
}

enum EmergencyVisitStatus {
  WAITING_TRIAGE
  TRIAGED
  WAITING_DOCTOR
  IN_TREATMENT
  ADMITTED
  DISCHARGED
  TRANSFERRED
  DECEASED
}

/// EmergencyVisit tracks Emergency Department intake, ESI triage level, and clinical status transitions.
model EmergencyVisit {
  id             String               @id @default(uuid())
  visitNumber    String               @unique @map("visit_number")
  patientId      String?              @map("patient_id")
  patientName    String               @map("patient_name")
  patientPhone   String?              @map("patient_phone")
  facilityId     String               @map("facility_id")
  doctorId       String?              @map("doctor_id")
  triageLevel    TriageLevel?         @map("triage_level")
  chiefComplaint String               @map("chief_complaint")
  arrivalMode    ArrivalMode          @default(WALK_IN) @map("arrival_mode")
  status         EmergencyVisitStatus @default(WAITING_TRIAGE)
  notes          String?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  // Relations
  patient        PatientProfile?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  facility       Facility             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  doctor         DoctorProfile?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  triageAssessments TriageAssessment[]

  @@index([facilityId, status, createdAt])
  @@index([triageLevel, status])
  @@map("emergency_visits")
}

/// TriageAssessment records nurse vital signs and ESI score assignment.
model TriageAssessment {
  id               String         @id @default(uuid())
  emergencyVisitId String         @map("emergency_visit_id")
  nurseId          String         @map("nurse_id")
  temperature      Float?
  pulse            Int?
  respiratoryRate  Int?           @map("respiratory_rate")
  oxygenSaturation Int?           @map("oxygen_saturation")
  systolicBP       Int?           @map("systolic_bp")
  diastolicBP      Int?           @map("diastolic_bp")
  painScore        Int?           @map("pain_score")
  notes            String?
  assessedAt       DateTime       @default(now()) @map("assessed_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  // Relations
  emergencyVisit   EmergencyVisit @relation(fields: [emergencyVisitId], references: [id], onDelete: Cascade)
  nurse            User           @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@index([emergencyVisitId, assessedAt])
  @@map("triage_assessments")
}

enum ShiftType {
