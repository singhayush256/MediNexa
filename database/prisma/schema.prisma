  patientName      String    @map("patient_name")
  patientPhone     String    @map("patient_phone")
  patientEmail     String?   @map("patient_email")
  bedType          BedType   @default(GENERAL) @map("bed_type")
  priority         String    @default("NORMAL")
  chiefComplaint   String?   @map("chief_complaint")
  medicalCondition String?   @map("medical_condition")
  expectedDate     DateTime? @map("expected_date")
  expiresAt        DateTime  @map("expires_at")
  allocatedBedId   String?   @map("allocated_bed_id")
  admissionId      String?   @map("admission_id")
  status           String    @default("PENDING")
  notes            String?
  reviewedBy       String?   @map("reviewed_by")
  reviewedAt       DateTime? @map("reviewed_at")
  admittedAt       DateTime? @map("admitted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  facility     Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient      PatientProfile? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allocatedBed Bed?            @relation("BedAllocatedBookings", fields: [allocatedBedId], references: [id])
  admission    Admission?      @relation("AdmissionBedBooking", fields: [admissionId], references: [id])

  @@index([facilityId, status])
  @@index([patientId, status])
  @@map("bed_bookings")
}

/// HospitalBedStatus provides real-time aggregated metrics for bed availability across departments.
model HospitalBedStatus {
  id                 String   @id @default(uuid())
  facilityId         String   @unique @map("facility_id")
  hospitalName       String   @map("hospital_name")
  totalBeds          Int      @default(0) @map("total_beds")
  occupiedBeds       Int      @default(0) @map("occupied_beds")
  availableBeds      Int      @default(0) @map("available_beds")
  icuBeds            Int      @default(0) @map("icu_beds")
  icuAvailable       Int      @default(0) @map("icu_available")
  generalBeds        Int      @default(0) @map("general_beds")
  generalAvailable   Int      @default(0) @map("general_available")
  emergencyBeds      Int      @default(0) @map("emergency_beds")
  emergencyAvailable Int      @default(0) @map("emergency_available")
  status             String   @default("AVAILABLE")
  lastUpdated        DateTime @default(now()) @map("last_updated")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, status])
  @@map("hospital_bed_statuses")
}

/// MedicationLog records individual daily doses taken or missed by patients.
model MedicationLog {
  id           String    @id @default(uuid())
  medicationId String    @map("medication_id")
  patientId    String    @map("patient_id")
  doseTime     String    @map("dose_time")
  status       String    @default("taken")
  scheduledFor DateTime  @map("scheduled_for")
  takenAt      DateTime? @map("taken_at")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@index([medicationId, scheduledFor])
  @@index([patientId, status])
  @@map("medication_logs")
}

/// NotificationPreference tracks user channel opt-ins (email, whatsapp, in-app).
model NotificationPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  emailEnabled         Boolean  @default(true) @map("email_enabled")
  whatsappEnabled      Boolean  @default(true) @map("whatsapp_enabled")
  appointmentReminders Boolean  @default(true) @map("appointment_reminders")
  medicationReminders  Boolean  @default(true) @map("medication_reminders")
  labReportAlerts      Boolean  @default(true) @map("lab_report_alerts")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// NotificationDeliveryLog provides an audit trail for all outbound multi-channel notifications.
model NotificationDeliveryLog {
  id               String    @id @default(uuid())
  recipient        String
  channel          String
  notificationType String    @map("notification_type")
  title            String
  message          String
  status           String    @default("SENT")
  sentAt           DateTime? @map("sent_at")
  failureReason    String?   @map("failure_reason")
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([recipient, status])
  @@index([channel, createdAt])
  @@map("notification_delivery_logs")
}

/// ReminderNotification logs push/in-app/email alerts dispatched for medicine reminders.
model ReminderNotification {
  id            String    @id @default(uuid())
  reminderId    String    @map("reminder_id")
  patientId     String    @map("patient_id")
  channel       String    @default("IN_APP")
  status        String    @default("SENT")
  title         String
  message       String
  scheduledTime String    @map("scheduled_time")
  sentAt        DateTime? @map("sent_at")
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  reminder MedicationReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  patient  PatientProfile     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([reminderId, status])
  @@index([patientId, channel])
  @@map("reminder_notifications")
}

/// ReminderHistory records compliance actions (TAKEN, SKIPPED, MISSED) on scheduled medicine reminders.
model ReminderHistory {
  id           String    @id @default(uuid())
  reminderId   String    @map("reminder_id")
  patientId    String    @map("patient_id")
  scheduledFor DateTime  @map("scheduled_for")
  action       String    @default("SCHEDULED")
  actionTime   DateTime? @map("action_time")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  reminder MedicationReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  patient  PatientProfile     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([reminderId, scheduledFor])
  @@index([patientId, action])
  @@map("reminder_histories")
}

/// MedicationSchedule stores recurring calendar slots for patient medicine administration.
model MedicationSchedule {
  id            String    @id @default(uuid())
  reminderId    String?   @map("reminder_id")
  patientId     String    @map("patient_id")
  medicineName  String    @map("medicine_name")
  dosage        String?
  frequency     String    @default("DAILY")
  scheduledTime String    @map("scheduled_time")
  dayOfWeek     String?   @map("day_of_week")
  status        String    @default("PENDING")
  takenAt       DateTime? @map("taken_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  reminder MedicationReminder? @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  patient  PatientProfile      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, status])
  @@map("medication_schedules")
}
